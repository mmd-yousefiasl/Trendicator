{
  "ConnectionStrings": {
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/error-log-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "MachineKeyLifetime": "90",
  "SiteTools": {
    "SiteName": "ترندیکاتور",
    "MaxImageFileLength": 5,
    "DefaultImages": "/d-imgs/default.webp",
    "SiteMediaUrl": "",
    //Mediator
    "MediatorLicenceKey": "",
    //Site Info
    "Banner": "/files/banner/",
    "OurFeature": "/files/our-feature/",
    "SiteLogo": "/files/site-logo/",
    "BreadcrumbBanner": "/d-imgs/breadcrumb.webp",
    "Media": "/files/media/",
    //Blog
    "BlogBanner": "/files/blog/",
    //Product
    "ProductBanner": "/files/product/",
    "ProductIndicator": "/product-indicators/",
    //Payment
    "PaymentRequestURL": "https://gateway.zibal.ir/v1/request",
    "CallBackURL": "",
    "StartPaymentURL": "https://gateway.zibal.ir/start/",
    "VerifyPaymentURL": "https://gateway.zibal.ir/v1/verify",
    //Telegram
    "TelegramErrorChannelId": 0,
    "TelegramNotificationChannelId": 0,
    "TelegramErrorAlertingEnabled": false,
    "AdminTelegramWorkerKey": "",
    "AdminTelegramWorkerSendUrl": "",
    //visitor
    "VisitorKeyName": "",
    "VisitorExpirationDays": 0,

    //Ticket
    "MaxTicketAttachmentLength": 500,
    "TicketAttachmentFile": "/TicketAttachments/"
  }
}