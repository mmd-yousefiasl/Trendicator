@using System.Text.Json
@using Application.Dtos.Product.ClientSide
@using Application.Dtos.ProductDetails.ClientSide
@using Application.Dtos.ProductReview.ClientSide
@using Application.Tools
@model ClientSideProductDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
    ViewData["CanonicalOverride"] = (SiteTools.SiteUrl + "p/" + Model.Id + "/" + Model.Slug);
    var shortUrl = SiteTools.SiteUrl + "p/" + Model.Id;

    // FAQ schema is computed once here; only rendered when FAQs exist.
    string faqSchemaJson = null;
    if (Model?.Faqs?.Any() ?? false)
    {
        var jsonOptions = new JsonSerializerOptions
        {
            WriteIndented = true,
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        };

        var faqSchema = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = Model.Faqs.Select(item => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = item.Question ?? string.Empty,
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = item.Answer ?? string.Empty
                }
            }).ToList()
        };

        faqSchemaJson = JsonSerializer.Serialize(faqSchema, jsonOptions);
    }
}

<main class="container">
    <ul class="crumbs">
        <partial name="_IndexLink" />
        <li><a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="">فروشگاه</a></li>
        <li><a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@Model.CategorySlug">@Model.Category</a></li>
        <li>@Model.Title</li>
    </ul>

    <!-- ============ Product hero ============ -->
    <div class="product-hero mt-2 @(Model.IsAvailable ? null : "product-hero--soldout")">
        <div>
            <div class="product-view card" aria-label="@Model.Title">
                <img src="@SiteTools.ProductBanner@Model.BannerFileName" decoding="async" alt="@Model.Slug">
            </div>

            <div class="grid grid--3 mt-3" style="gap:12px">
                <div class="stat card"><b class="num">@Model.ViewsCount</b><span>بازدید کل</span></div>
                <div class="stat card"><b class="num">@Model.PurchaseCount.ToTomanFormat()</b><span>خرید موفق</span></div>
                <div class="stat card">
                    <b>
                        @if (Model.ReviewRate > 0)
                        {
                            @Model.ReviewRate
                        }
                        else
                        {
                            @:-/-
                        }
                        ★
                    </b>
                    <span>
                        امتیاز از
                        @Model.ReviewsCount
                        نظر
                    </span>
                </div>
            </div>
        </div>

        <!-- Buy panel -->
        <div class="product-hero__panel">
            <div class="card card-pad" data-cart-container data-product-id="@Model.Id">
                <div class="flex flex--wrap" style="gap:6px">
                    @if (Model.IsAvailable && Model.Percent > 0)
                    {
                        <span class="badge badge--brand">@Model.Percent%</span>
                    }
                    <span class="badge">@Model.ParentCategory</span>
                    <span class="badge">@Model.Category</span>
                </div>
                <h1 class="mt-2" style="font-size:1.5rem">@Model.Title</h1>
                <p class="text-muted">@Model.ShortDescription</p>

                @if (Model.IsAvailable)
                {
                    <div class="price price--lg mt-2">
                        @if (Model.DisplayPrice > 0)
                        {
                            <del>@Model.DisplayPrice.ToTomanFormat()</del>
                        }
                        <small>تومان</small> @Model.OrderPrice.ToTomanFormat()
                    </div>
                    <p class="hint">@Model.Hint</p>

                    <div class="flex mt-2" style="gap:10px">
                        <button type="button"
                                class="btn btn--primary @(Model.IsInCart ? "is-in-cart" : null)"
                                style="flex:1"
                                data-cart-toggle
                                data-state="@(Model.IsInCart ? "in" : "out")"
                                data-label-add="افزودن به سبد خرید"
                                data-label-remove="حذف از سبد خرید">
                            <span class="btn__label">@(Model.IsInCart ? "حذف از سبد خرید" : "افزودن به سبد خرید")</span>
                        </button>

                        <button type="button"
                                class="btn btn--ghost"
                                data-copy-link
                                data-url="@shortUrl"
                                aria-label="کپی لینک محصول">
                            <svg class="ic" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                <path d="M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1 1 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4 4 0 0 1-.128-1.287z" />
                                <path d="M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243z" />
                            </svg>
                            کپی لینک
                        </button>
                    </div>
                }
                else
                {
                    <div class="product-unavailable mt-2">
                        <b>این محصول فعلاً ناموجود است</b>
                        <span>به‌زودی دوباره در دسترس قرار می‌گیرد</span>
                    </div>
                }

                @if (Model?.Features?.Count() > 0)
                {
                    <ul class="feature-list mt-3" style="padding-top:16px;border-top:1px dashed var(--line)">
                        @foreach (var item in Model.Features.Take(4).ToList() ?? new List<string>())
                        {
                            <li>@item</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <!-- ============ Tabs ============ -->
    <section class="section" data-tabs>
        <div class="tabs" role="tablist" aria-label="اطلاعات محصول">
            <button role="tab" aria-selected="true" aria-controls="tab-desc">توضیحات</button>
            <button role="tab" aria-selected="false" aria-controls="tab-features">امکانات</button>
            <button role="tab" aria-selected="false" aria-controls="tab-reviews">
                نظرات
                (@Model.ReviewsCount)
            </button>
        </div>

        <div role="tabpanel" id="tab-desc">
            @Html.Raw(Model.Description)
        </div>

        <div role="tabpanel" id="tab-features" hidden>
            @if (Model?.Features?.Count() > 4)
            {
                <h3>امکانات کلیدی</h3>
                <ul class="feature-list">
                    @foreach (var item in Model.Features.Skip(4).ToList() ?? new List<string>())
                    {
                        <li>@item</li>
                    }
                </ul>
            }

            @if (Model?.Details?.Count() > 0)
            {
                <h3 class="mt-3">مشخصات فنی</h3>
                <div class="table-wrap">
                    <table class="table">
                        <tbody>
                            @foreach (var item in Model.Details ?? new List<ClientSideProductDetailsDto>())
                            {
                                <tr>
                                    <td>@item.Title</td>
                                    <td>@item.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div role="tabpanel" id="tab-reviews" hidden>
            <input type="hidden" id="reviews-page" value="1" />

            @if (Model?.Reviews?.Any() ?? false)
            {
                <div id="reviews-container" class="grid" style="gap:14px">
                    <partial name="_ProductComments"
                             model="@(new ClientSideFilterProductReviewsDto { ProductId = Model.Id, Page = 1, Entities = Model.Reviews })" />
                </div>

                @if (Model.ReviewsCount > 10)
                {
                    <div class="text-center mt-2" id="load-more-wrapper">
                        <button type="button"
                                class="btn btn--ghost"
                                id="load-more-reviews"
                                data-product-id="@Model.Id">
                            مشاهده نظرات بیشتر
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="card card-pad">
                    <div class="empty">
                        <div class="empty__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                            </svg>
                        </div>
                        <h3>هنوز نظری ثبت نشده است</h3>
                        <p>اولین نفری باشید که تجربه‌اش را با این محصول به اشتراک می‌گذارد.</p>
                        <a href="#review-form" class="btn btn--soft">ثبت اولین نظر</a>
                    </div>
                </div>
            }

            <partial name="_AddProductReview" model="@(new ClientSideAddProductCommentDto() { ProductId = Model.Id })" />
        </div>
    </section>

    @if (Model?.Faqs?.Any() ?? false)
    {
        <partial name="_ProductFaqs" model="Model.Faqs" />
    }

    @await Component.InvokeAsync("RelatedProducts", new { id = Model.Id, categoryId = Model.CategoryId })
</main>

@section FooterReferences {
    @if (faqSchemaJson != null)
    {
        <script type="application/ld+json">
            @Html.Raw(faqSchemaJson)
        </script>
    }

    <script src="/js/product-details.js" asp-append-version="true"></script>
}