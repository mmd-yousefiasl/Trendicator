@using Application.Tools
@using Application.ViewModels.Product.ClientSide
@using Application.ViewModels.ProductReview.ClientSide
@model ClientSideProductDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area ltn__breadcrumb-area-2 ltn__breadcrumb-color-white bg-overlay-theme-black-70 bg-image"
     data-bg="@SiteTools.BreadcrumbBanner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner ltn__breadcrumb-inner-2 justify-content-between">
                    <div class="section-title-area ltn__section-title-2">
                        <h2 class="section-title white-color">@ViewData["Title"]</h2>
                    </div>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                            <li><a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="">محصولات</a></li>
                            <li>
                                <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@Model.CategorySlug">
                                    @Model.Category
                                </a>
                            </li>
                            <li>@ViewData["Title"]</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMB AREA END -->
<!-- SHOP DETAILS AREA START -->
<div class="ltn__shop-details-area pb-85">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__shop-details-inner mb-60">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="ltn__shop-details-img-gallery">
                                <div class="ltn__shop-details-large-img">
                                    <div class="single-large-img">
                                        <a href="@SiteTools.ProductBanner@Model.BannerFileName" target="_blank">
                                            <img src="@SiteTools.ProductBanner@Model.BannerFileName" alt="@Model.Title">
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="modal-product-info shop-details-info pl-0">
                                <div class="product-ratting">
                                    <ul>
                                        @await Component.InvokeAsync("ProductReviewsRate", new { productId = Model.Id })
                                        <li class="review-total">
                                            <span>
                                                ( @Model.ReviewsCount
                                                بازخورد )
                                            </span>
                                        </li>
                                    </ul>
                                </div>
                                <h1>@Model.Title</h1>
                                <div class="product-price">
                                    @if (Model.HaveDiscount)
                                    {
                                        <span id="price-field">@Model.OrderPrice?.ToToman()</span>
                                        <del id="order-price-field">@Model.Price.ToTomanFormat()</del>
                                    }
                                    else
                                    {
                                        <span id="price-field">@Model.Price.ToToman()</span>
                                        <del id="order-price-field"></del>
                                    }
                                </div>
                                <div class="modal-product-meta ltn__product-details-menu-1">
                                    <ul>
                                        <li>
                                            <strong>دسته بندی: </strong>
                                            <span>
                                                <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@Model.CategorySlug">
                                                    @Model.Category
                                                </a>
                                            </span>
                                        </li>
                                    </ul>
                                </div>
                                @Html.Raw(Model.ShortDescription)
                                <div class="ltn__product-details-menu-2">
                                    <ul>
                                        @if (Model.IsAvailable)
                                        {
                                            <li>
                                                <select class="form-control" id="Product-Option-Id" onchange="updateProductPrice(this)">
                                                    @foreach (var item in Model.Options ?? new List<ClientSideProductOptionViewModel>())
                                                    {
                                                        @if (item.OrderPrice > 0)
                                                        {
                                                            <option value="@item.Id" data-price-field="@item.Price.ToToman()" data-order-price-field="@item.OrderPrice?.ToToman()">@item.Title</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@item.Id" data-price-field="@item.Price.ToToman()">@item.Title</option>
                                                        }
                                                    }
                                                </select>
                                            </li>
                                            <li>
                                                <button type="button" title="افزودن به سبد خرید" class="theme-btn-1 btn btn-effect-1 btn-submit" onclick="AddToCart()">
                                                    <i class="fas fa-shopping-cart"></i>
                                                    <span>افزودن به سبد خرید</span>
                                                </button>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <div class="btn btn-outline-danger">
                                                    <span>ناموجود</span>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <div class="ltn__product-details-menu-3">
                                    <ul>
                                        <li>
                                            <button type="button" title="علاقه مندی ها" class="wishlist-toggle bg-none" data-product-id="@Model.Id">
                                                <i class="@((Model.IsInUserWishList) ? "fa" : "far") fa-heart"></i>
                                                <span>@((Model.IsInUserWishList) ? "حذف از علاقه مندی ها" : "افزودن به علاقمندی ها")</span>
                                            </button>
                                        </li>
                                        <li>
                                            <button type="button" class="compare-toggle bg-none" data-product-id="@Model.Id"
                                                    title="@(Model.IsInUserCompare ? "حذف از لیست مقایسه" : "اضافه کردن به لیست مقایسه")">
                                                <i class="fas fa-exchange-alt"></i>
                                                <span>@(Model.IsInUserCompare ? "حذف از لیست مقایسه" : "اضافه کردن به لیست مقایسه")</span>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                                <hr>
                                <div class="ltn__social-media">
                                    @{
                                        string pageUrl = (SiteTools.SiteUrl + "p/" + Model.Id);
                                    }
                                    <ul>
                                        <li>اشتراک گذاری: </li>
                                        <li>
                                            <a href="@("https://www.facebook.com/sharer/sharer.php?u=" + pageUrl)"
                                               target="_blank" rel="noopener" title="Facebook">
                                                <i class="fab fa-facebook-f"></i>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="@("https://twitter.com/intent/tweet?url=" + pageUrl)"
                                               target="_blank" rel="noopener" title="Twitter">
                                                <i class="fab fa-twitter"></i>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="@("https://www.linkedin.com/shareArticle?mini=true&url=" + pageUrl)"
                                               target="_blank" rel="noopener" title="LinkedIn">
                                                <i class="fab fa-linkedin"></i>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="@("https://api.whatsapp.com/send?text=" + pageUrl)"
                                               target="_blank" rel="noopener" title="WhatsApp">
                                                <i class="fab fa-whatsapp"></i>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="@("https://t.me/share/url?url=" + pageUrl)"
                                               target="_blank" rel="noopener" title="Telegram">
                                                <i class="fab fa-telegram"></i>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="@("https://www.instagram.com/?url=" + pageUrl)"
                                               target="_blank" rel="noopener" title="Instagram">
                                                <i class="fab fa-instagram"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <hr>
                                <div class="ltn__social-media">
                                    <ul>
                                        <li>لینک کوتاه: </li>
                                        <li>
                                            <a asp-area="" asp-controller="Product" asp-action="ProductDetails" asp-route-id="@Model.Id" asp-route-slug="" title="لینک کوتاه">
                                                @pageUrl
                                            </a>
                                        </li>
                                        <li>
                                            <button class="bg-transparent" type="button" title="کپی لینک کوتاه" onclick="CopyUrlToClipboard('@pageUrl')">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 408 480"><path fill="#000000" d="M299 5v43H43v299H0V48q0-18 12.5-30.5T43 5h256zm64 86q17 0 29.5 12.5T405 133v299q0 18-12.5 30.5T363 475H128q-18 0-30.5-12.5T85 432V133q0-17 12.5-29.5T128 91h235zm0 341V133H128v299h235z" /></svg>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Shop Tab Start -->
                <div class="ltn__shop-details-tab-inner ltn__shop-details-tab-inner-2">
                    <div class="ltn__shop-details-tab-menu">
                        <div class="nav">
                            <a class="active show" data-toggle="tab" href="#liton_tab_details_1_1">توضیحات</a>
                            <a data-toggle="tab" href="#liton_tab_details_1_2" class="">بازخورد ها</a>
                        </div>
                    </div>
                    <div class="tab-content">
                        <div class="tab-pane fade active show" id="liton_tab_details_1_1">
                            <div class="ltn__shop-details-tab-content-inner">
                                @Html.Raw(Model.Description)
                            </div>
                        </div>
                        <div class="tab-pane fade" id="liton_tab_details_1_2">
                            <div class="ltn__shop-details-tab-content-inner">
                                <h4 class="title-2">بازخورد مشتریان</h4>
                                <div class="product-ratting">
                                    <ul>
                                        @await Component.InvokeAsync("ProductReviewsRate", new { productId = Model.Id })

                                        <li class="review-total">
                                            <span>
                                                ( @Model.ReviewsCount
                                                بازخورد )
                                            </span>
                                        </li>
                                    </ul>
                                </div>
                                <hr>
                                @await Component.InvokeAsync("ProductReviews", new { productId = Model.Id })
                                <partial name="_AddProductReview"
                                         model="@(new ClientSideWriteProductReviewViewModel()
                                         { ProductId = Model.Id, Slug = Model.Slug })" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Component.InvokeAsync("RelatedProducts", new { id = Model.Id, categoryId = Model.CategoryId })

@await Component.InvokeAsync("OurFeatures")