@using Application.Tools
@using Application.ViewModels.Product.ClientSide
@using Application.ViewModels.ProductReview.ClientSide
@model ClientSideProductDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area ltn__breadcrumb-area-2 ltn__breadcrumb-color-white bg-overlay-theme-black-90 bg-image" data-bg="/assets/img/bg/9.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner ltn__breadcrumb-inner-2 justify-content-between">
                    <div class="section-title-area ltn__section-title-2">
                        <h1 class="section-title white-color">جزئیات محصول</h1>
                    </div>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                            <li>جزئیات محصول</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMB AREA END -->
<!-- SHOP DETAILS AREA START -->
<div class="ltn__shop-details-area pb-85">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__shop-details-inner mb-60">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="ltn__shop-details-img-gallery">
                                <div class="ltn__shop-details-large-img">
                                    <div class="single-large-img">
                                        <a href="@SiteTools.ProductBanner@Model.BannerFileName" data-rel="lightcase:myCollection">
                                            <img src="@SiteTools.ProductBanner@Model.BannerFileName" alt="@Model.Title">
                                        </a>
                                    </div>
                                    @foreach (var item in Model.Gallery ?? new List<string>())
                                    {
                                        <div class="single-large-img">
                                            <a href="@SiteTools.ProductGallery@item" data-rel="lightcase:myCollection">
                                                <img src="@SiteTools.ProductGallery@item" alt="@Model.Title">
                                            </a>
                                        </div>
                                    }
                                </div>
                                <div class="ltn__shop-details-small-img slick-arrow-2">
                                    <div class="single-small-img">
                                        <img src="@SiteTools.ProductBanner@Model.BannerFileName" alt="@Model.Title">
                                    </div>
                                    @foreach (var item in Model.Gallery ?? new List<string>())
                                    {
                                        <div class="single-small-img">
                                            <img src="@SiteTools.ProductGallery@item" alt="@Model.Title">
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="modal-product-info shop-details-info pl-0">
                                <div class="product-ratting">
                                    <ul>
                                        @await Component.InvokeAsync("ProductReviewsRate", new { productId = Model.Id })
                                        <li class="review-total">
                                            <a href="javascript:void(0)">
                                                ( @Model.ReviewsCount
                                                بازخورد )
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <h3>@Model.Title</h3>
                                <div class="product-price">
                                    @if (Model.HaveDiscount)
                                    {
                                        <span>@Model.OrderPrice?.ToToman()</span>
                                        <del>@Model.Price.ToTomanFormat()</del>
                                    }
                                    else
                                    {
                                        <span>@Model.Price.ToToman()</span>
                                    }
                                </div>
                                <div class="modal-product-meta ltn__product-details-menu-1">
                                    <ul>
                                        <li>
                                            <strong>دسته بندی: </strong>
                                            <span>
                                                <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-CategoryId="@Model.CategoryId">
                                                    @Model.Category
                                                </a>
                                            </span>
                                        </li>
                                    </ul>
                                </div>
                                @Html.Raw(Model.ShortDescription)
                                <div class="ltn__product-details-menu-2">
                                    <ul>
                                        <li>
                                            <select class="form-control" id="Product-Option-Id">
                                                @foreach (var item in Model.Options ?? new List<ClientSideProductOptionViewModel>())
                                                {
                                                    <option value="@item.Id">@item.Title</option>
                                                }
                                            </select>
                                        </li>
                                        <li>
                                            <a href="javascript:void(0)" class="theme-btn-1 btn btn-effect-1 btn-submit" onclick="AddToCart()">
                                                <i class="fas fa-shopping-cart"></i>
                                                <span>افزودن به سبد خرید</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="ltn__product-details-menu-3">
                                    <ul>
                                        <li>
                                            <a href="javascript:void(0)" class="wishlist-toggle" data-product-id="@Model.Id">
                                                <i class="@((Model.IsInUserWishList) ? "fa" : "far") fa-heart"></i>
                                                <span>@((Model.IsInUserWishList) ? "حذف از علاقه مندی ها" : "افزودن به علاقمندی ها")</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="javascript:void(0)" class="compare-toggle" data-product-id="@Model.Id"
                                               title="@(Model.IsInUserCompare ? "حذف از لیست مقایسه" : "اضافه کردن به لیست مقایسه")">
                                                <i class="fas fa-exchange-alt"></i>
                                                <span>@(Model.IsInUserCompare ? "حذف از لیست مقایسه" : "اضافه کردن به لیست مقایسه")</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <hr>
                                <div class="ltn__social-media">
                                    <ul>
                                        <li>اشتراک گذاری: </li>
                                        <li><a href="javascript:void(0)" title="Facebook"><i class="fab fa-facebook-f"></i></a></li>
                                        <li><a href="javascript:void(0)" title="Twitter"><i class="fab fa-twitter"></i></a></li>
                                        <li><a href="javascript:void(0)" title="Linkedin"><i class="fab fa-linkedin"></i></a></li>
                                        <li><a href="javascript:void(0)" title="Instagram"><i class="fab fa-instagram"></i></a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Shop Tab Start -->
                <div class="ltn__shop-details-tab-inner ltn__shop-details-tab-inner-2">
                    <div class="ltn__shop-details-tab-menu">
                        <div class="nav">
                            <a class="active show" data-toggle="tab" href="#liton_tab_details_1_1">توضیحات</a>
                            <a data-toggle="tab" href="#liton_tab_details_1_2" class="">بازخورد ها</a>
                        </div>
                    </div>
                    <div class="tab-content">
                        <div class="tab-pane fade active show" id="liton_tab_details_1_1">
                            <div class="ltn__shop-details-tab-content-inner">
                                @Html.Raw(Model.Description)
                            </div>
                        </div>
                        <div class="tab-pane fade" id="liton_tab_details_1_2">
                            <div class="ltn__shop-details-tab-content-inner">
                                <h4 class="title-2">بازخورد مشتریان</h4>
                                <div class="product-ratting">
                                    <ul>
                                        @await Component.InvokeAsync("ProductReviewsRate", new { productId = Model.Id })

                                        <li class="review-total">
                                            <a href="javascript:void(0)">
                                                ( @Model.ReviewsCount
                                                بازخورد ها )
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <hr>
                                @await Component.InvokeAsync("ProductReviews", new { productId = Model.Id })
                                <partial name="_AddProductReview"
                                         model="@(new ClientSideWriteProductReviewViewModel()
                                         { ProductId = Model.Id, Slug = Model.Slug })" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Component.InvokeAsync("RelatedProducts", new { id = Model.Id, categoryId = Model.CategoryId })

@await Component.InvokeAsync("OurFeatures")