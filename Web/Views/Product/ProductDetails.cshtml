@using System.Text.Json
@using Application.Dtos.Product.ClientSide
@using Application.Tools
@model ClientSideProductDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
    ViewData["CanonicalOverride"] = (SiteTools.SiteUrl + "p/" + Model.Id + "/" + Model.Slug);
}

<main class="container">
    <ul class="crumbs">
        <partial name="_IndexLink" />
        <li><a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="">فروشگاه</a></li>
        <li><a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@Model.CategorySlug">@Model.Category</a></li>
        <li>@Model.Title</li>
    </ul>

    <!-- ============ Product hero ============ -->
    <div class="product-hero mt-2">
        <div>
            <div class="product-view card" aria-label="@Model.Title">
                <img src="@SiteTools.ProductBanner@Model.BannerFileName" decoding="async" alt="@Model.Slug">
            </div>

            <div class="grid grid--3 mt-3" style="gap:12px">
                <div class="stat card"><b class="num">@Model.ViewsCount</b><span>بازدید کل</span></div>
                <div class="stat card"><b class="num">۱۲٬۴۰۰</b><span>دانلود موفق</span></div>
                <div class="stat card">
                    <b>
                        @if (Model.ReviewRate > 0)
                        {
                            @Model.ReviewRate
                        }
                        else
                        {
                            @:-/-
                        }
                        ★
                    </b>
                    <span>
                        امتیاز از
                        @Model.ReviewsCount
                        نظر
                    </span>
                </div>
            </div>
        </div>

        <!-- Buy panel -->
        <div class="product-hero__panel">
            <div class="card card-pad">
                <div class="flex flex--wrap" style="gap:6px">
                    @if (Model.Percent > 0)
                    {
                        <span class="badge badge--brand">@Model.Percent%</span>
                    }
                    <span class="badge">@Model.ParentCategory</span>
                    <span class="badge">@Model.Category</span>
                </div>
                <h1 class="mt-2" style="font-size:1.5rem">@Model.Title</h1>
                <p class="text-muted">@Model.ShortDescription</p>

                <div class="price price--lg mt-2">
                    @if (Model.DisplayPrice > 0)
                    {
                        <del>@Model.DisplayPrice.ToTomanFormat()</del>
                    }
                    <small>تومان</small> @Model.OrderPrice.ToTomanFormat()
                </div>
                <p class="hint">@Model.Hint</p>

                <div class="flex mt-2" style="gap:10px">
                    <button class="btn btn--primary" style="flex:1" data-add-to-cart data-id="p1" data-name="ترند اسکالپر پرو" data-price="2480000">افزودن به سبد خرید</button>
                    <a href="cart.html" class="btn btn--ghost">خرید سریع</a>
                </div>

                <ul class="feature-list mt-3" style="padding-top:16px;border-top:1px dashed var(--line)">
                    <li>دانلود فوری بعد از پرداخت</li>
                    <li>۷ روز ضمانت بازگشت وجه</li>
                    <li>آموزش نصب تصویری + پشتیبانی تلگرام</li>
                    <li>سازگار با حساب‌های پروپفرم</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- ============ Tabs ============ -->
    <section class="section" data-tabs>
        <div class="tabs" role="tablist" aria-label="اطلاعات محصول">
            <button role="tab" aria-selected="true" aria-controls="tab-desc">توضیحات</button>
            <button role="tab" aria-selected="false" aria-controls="tab-features">امکانات</button>
            <button role="tab" aria-selected="false" aria-controls="tab-reviews">
                نظرات
                (@Model.ReviewsCount)
            </button>
        </div>

        <div role="tabpanel" id="tab-desc">
            @Html.Raw(Model.Description)
        </div>

        <div role="tabpanel" id="tab-features" hidden>
            <h3>امکانات کلیدی</h3>
            <ul class="feature-list">
                <li>سیگنال فلش خرید/فروش با تأیید سه‌لایه</li>
                <li>آلارم صوتی، پوش نوتیفیکیشن و تلگرام</li>
                <li>نمایش سشن‌های معاملاتی روی چارت</li>
                <li>حد ضرر و تارگت پیشنهادی خودکار</li>
                <li>دارک و لایت مود مطابق تم ترمینال</li>
                <li>پشتیبانی از ۲۸ جفت‌ارز، طلا و شاخص‌ها</li>
            </ul>
            <h3 class="mt-3">مشخصات فنی</h3>
            <div class="table-wrap">
                <table class="table">
                    <tbody>
                        <tr><td>پلتفرم</td><td>متاتریدر ۴ و ۵</td></tr>
                        <tr><td>تایم‌فریم پیشنهادی</td><td>M1 – M15</td></tr>
                        <tr><td>ابزارهای معاملاتی</td><td>فارکس، طلا، شاخص</td></tr>
                        <tr><td>نوع لایسنس</td><td>دائمی · ۱ حساب واقعی + ۲ دمو</td></tr>
                        <tr><td>به‌روزرسانی</td><td>رایگان تا ۱ سال</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div role="tabpanel" id="tab-reviews" hidden>
            <div class="grid" style="gap:14px">
                <div class="card card-pad testimonial">
                    <div class="flex flex--between">
                        <div class="testimonial__stars">★★★★★</div>
                        <span class="text-dim" style="font-size:.75rem">۳ روز پیش</span>
                    </div>
                    <p class="text-muted mb-0">«بهترین اندیکاتور اسکالپی که تا حالا خریدم. آلارم تلگرامش خیلی به دردم می‌خوره چون همیشه پشت لپ‌تاپ نیستم.»</p>
                    <div class="testimonial__author"><span class="testimonial__avatar">ن.ط</span><div><b>نگین طاهری</b><span>خرید تأییدشده</span></div></div>
                </div>
                <div class="card card-pad testimonial">
                    <div class="flex flex--between">
                        <div class="testimonial__stars">★★★★☆</div>
                        <span class="text-dim" style="font-size:.75rem">۲ هفته پیش</span>
                    </div>
                    <p class="text-muted mb-0">«سیگنال‌ها خوبن ولی در سشن آسیا کمی نویز داره. پشتیبانی گفت تنظیمات حساسیت رو کم کنم که درست شد.»</p>
                    <div class="testimonial__author"><span class="testimonial__avatar">م.ص</span><div><b>محمد صادقی</b><span>خرید تأییدشده</span></div></div>
                </div>
            </div>
        </div>
    </section>

    @if (Model?.Faqs?.Any() ?? false)
    {
        var faqItems = Model.Faqs;

        var jsonOptions = new JsonSerializerOptions
        {
            WriteIndented = true,
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        };

        var faqSchema = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = faqItems.Select(item => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = item.Question ?? string.Empty,
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = item.Answer ?? string.Empty
                }
            }).ToList()
        };

        var schemaJson = JsonSerializer.Serialize(faqSchema, jsonOptions);

        @section FooterReferences {
            <script type="application/ld+json">
                    @Html.Raw(schemaJson)
            </script>
        }

        <partial name="_ProductFaqs" model="faqItems" />
    }

    @await Component.InvokeAsync("RelatedProducts", new { id = Model.Id, categoryId = Model.CategoryId })
</main>