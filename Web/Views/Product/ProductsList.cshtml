@using Application.ViewModels.Product.ClientSide
@using Domain.Enums.Products
@model ClientSideFilterProductsViewModel

@{
    ViewData["Title"] = ((!string.IsNullOrWhiteSpace(Model.Category)) ? Model.Category : "محصولات");
    if (!string.IsNullOrWhiteSpace(Model.Category))
    {
        ViewData["CanonicalOverride"] = (SiteTools.SiteUrl + "products/" + Model.Category);
    }
}

<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area ltn__breadcrumb-area-2 ltn__breadcrumb-color-white bg-overlay-theme-black-70 bg-image plr--9---"
     data-bg="@SiteTools.BreadcrumbBanner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner ltn__breadcrumb-inner-2 justify-content-between">
                    <div class="section-title-area ltn__section-title-2">
                        <h1 class="section-title white-color">@ViewData["Title"]</h1>
                    </div>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                            @if (!string.IsNullOrWhiteSpace(Model.Category))
                            {
                                <li><a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="">محصولات</a></li>
                            }
                            <li>@ViewData["Title"]</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMB AREA END -->
<!-- PRODUCT DETAILS AREA START -->
<div class="ltn__product-area ltn__product-gutter">
    <div class="container">
        <form class="row" asp-area="" asp-controller="Product" asp-action="ProductsList" method="get" id="search-form">
            <input type="hidden" asp-for="Page" id="Page" />
            <div class="col-lg-8 order-lg-2 mb-120">
                <div class="ltn__shop-options">
                    <ul>
                        <li>
                            <div class="ltn__grid-list-tab-menu ">
                                <div class="nav">
                                    <a class="active show" data-toggle="tab" href="#liton_product_grid">
                                        <i class="fas fa-th-large"></i>
                                    </a>
                                </div>
                            </div>
                        </li>
                        <li>
                            <div class="short-by text-center">
                                <select class="nice-select" asp-for="Sort" asp-items="@Html.GetEnumSelectList<ProductSortTypeEnum>()"
                                        onchange="SortTypeChanged()">
                                </select>
                            </div>
                        </li>
                    </ul>
                </div>
                @if (Model?.Entities?.Any() ?? false)
                {
                    <div class="tab-content">
                        <div class="tab-pane fade active show" id="liton_product_grid">
                            <div class="ltn__product-tab-content-inner ltn__product-grid-view">
                                <div class="row">
                                    @foreach (var item in Model.Entities ?? new List<ClientSideProductViewModel>())
                                    {
                                        <div class="col-xl-4 col-sm-6 col-6">
                                            <partial name="_ProductListView" model="@item" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <partial name="_Paging" model="@Model.GetCurrentPaging()" />
                }
                else
                {
                    <partial name="_NotFoundPartial" />
                }
            </div>
            <div class="col-lg-4  mb-120">
                <aside class="sidebar ltn__shop-sidebar">
                    <!-- Search Widget -->
                    <div class="widget ltn__search-widget">
                        <h4 class="ltn__widget-title ltn__widget-title-border">جست و جوی محصولات</h4>
                        <div style="position: relative;">
                            <input type="text" asp-for="Search">
                            <button type="submit"><i class="fas fa-search"></i></button>
                        </div>
                    </div>

                    @await Component.InvokeAsync("ProductCategories")

                    @await Component.InvokeAsync("TopRatedProducts")
                </aside>
            </div>
        </form>
    </div>
</div>

@await Component.InvokeAsync("OurFeatures")

@section FooterReferences {
    <script asp-append-version="true" src="/js/products-list.js"></script>
}