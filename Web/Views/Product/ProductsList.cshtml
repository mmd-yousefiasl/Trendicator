@using Application.Dtos.Product.ClientSide
@using Domain.Enums.Products
@model ClientSideFilterProductsViewModel

@{
    ViewData["Title"] = ((!string.IsNullOrWhiteSpace(Model.Category)) ? Model.Category : "محصولات");
    if (!string.IsNullOrWhiteSpace(Model.Category))
    {
        ViewData["CanonicalOverride"] = (SiteTools.SiteUrl + "products/" + Model.Category);
    }
}

<main class="container">
    <ul class="crumbs">
        <partial name="_IndexLink" />
        <li>@ViewData["Title"]</li>
    </ul>

    <div class="section-head">
        <h1>@ViewData["Title"]</h1>
        <p>اندیکاتورها و اکسپرت‌های تخصصی برای متاتریدر و تریدینگ‌ویو — همه محصولات با ۷ روز ضمانت بازگشت وجه.</p>
    </div>

    <div class="shop-layout mb-3">
        <!-- ============ Sidebar ============ -->
        <aside class="shop-layout__side" id="shop-filters">
            <button type="button" class="btn btn--ghost shop-toggle" data-collapse-toggle="#shop-filters"
                    aria-expanded="false" style="width:100%">
                <svg class="ic" aria-hidden="true">
                    <use href="#i-funnel" />
                </svg> فیلترها
            </button>

            @await Component.InvokeAsync("ProductCategories")
        </aside>

        <!-- ============ Grid ============ -->
        <form asp-area="" asp-controller="Product" asp-action="ProductsList" method="get" id="search-form">
            <input type="hidden" asp-for="Page" />
            <div class="flex flex--between flex--wrap mb-2">
                <span class="text-dim" style="font-size:.85rem">
                    @Model.AllEntitiesCount
                    محصول
                    ·
                    مرتب‌سازی بر اساس:
                </span>
                <select asp-for="Sort" class="select" style="max-width:200px" aria-label="مرتب‌سازی" onchange="SortChanged()"
                        asp-items="@Html.GetEnumSelectList<ProductSortTypeEnum>()">
                </select>
            </div>
            @if (Model?.Entities?.Any() ?? false)
            {
                <div class="grid grid--3" data-filter-grid>
                    @foreach (var item in Model.Entities ?? new List<ClientSideProductViewModel>())
                    {
                        <partial name="_ProductCard" model="@item" />
                    }
                </div >
                <partial name ="_Paging" model="@Model.GetCurrentPaging()" />
            }
            else
            {
                <partial name="_NotFoundPartial" />
            }
        </form>
    </div>
</main>

                                    
@section FooterReferences {
    <script asp-append-version="true">
        function SortChanged() {
            document.getElementById("search-form").submit();
        }
    </script>
}