@using Application.Tools
@using Application.ViewModels.Product.ClientSide
@model ClientSideProductDetailsViewModel

<div class="ltn__quick-view-modal-inner">
    <div class="modal-product-item">
        <div class="row">
            <div class="col-lg-6 col-12">
                <div class="modal-product-img">
                    <img src="@SiteTools.ProductBanner@Model.BannerFileName" alt="@Model.Title">
                </div>
            </div>
            <div class="col-lg-6 col-12">
                <div class="modal-product-info">
                    <div class="product-ratting">
                        <ul>
                            @await Component.InvokeAsync("ProductReviewsRate", new { productId = Model.Id })
                            <li class="review-total">
                                <span>
                                    ( @Model.ReviewsCount
                                    بازخورد )
                                </span>
                            </li>
                        </ul>
                    </div>
                    <a asp-area="" asp-controller="Product" asp-action="ProductDetails" asp-route-id="@Model.Id" asp-route-slug="@Model.Slug">
                        <h2>@Model.Title</h2>
                    </a>
                    <div class="product-price">
                        @if (Model.HaveDiscount)
                        {
                            <span id="price-field">@Model.OrderPrice?.ToToman()</span>
                            <del id="order-price-field">@Model.Price.ToTomanFormat()</del>
                        }
                        else
                        {
                            <span id="price-field">@Model.Price.ToToman()</span>
                            <del id="order-price-field"></del>
                        }
                    </div>
                    <div class="modal-product-meta ltn__product-details-menu-1">
                        <ul>
                            <li>
                                <strong>دسته بندی: </strong>
                                <span>
                                    <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@Model.CategorySlug">@Model.Category</a>
                                </span>
                            </li>
                        </ul>
                    </div>
                    @Html.Raw(Model.ShortDescription)
                    <div class="ltn__product-details-menu-2">
                        <ul>
                            @if (Model.IsAvailable)
                            {
                                <li>
                                    <select class="form-control" id="Product-Option-Id" onchange="updateProductPrice(this)">
                                        @foreach (var item in Model.Options ?? new List<ClientSideProductOptionViewModel>())
                                        {
                                            @if (item.OrderPrice > 0)
                                            {
                                                <option value="@item.Id" data-price-field="@item.Price.ToToman()" data-order-price-field="@item.OrderPrice?.ToToman()">@item.Title</option>
                                            }
                                            else
                                            {
                                                <option value="@item.Id" data-price-field="@item.Price.ToToman()">@item.Title</option>
                                            }
                                        }
                                    </select>
                                </li>
                                <li>
                                    <button type="button" title="افزودن به سبد خرید" class="theme-btn-1 btn btn-effect-1 btn-submit" onclick="AddToCart()">
                                        <i class="fas fa-shopping-cart"></i>
                                        <span>افزودن به سبد خرید</span>
                                    </button>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <div class="btn btn-outline-danger">
                                        <span>ناموجود</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                    <hr>
                    <div class="ltn__social-media">
                        @{
                            string pageUrl = (SiteTools.SiteUrl + "p/" + Model.Id);
                        }
                        <ul>
                            <li>اشتراک گذاری: </li>
                            <li>
                                <a href="@("https://www.facebook.com/sharer/sharer.php?u=" + pageUrl)"
                                   target="_blank" rel="noopener" title="Facebook">
                                    <i class="fab fa-facebook-f"></i>
                                </a>
                            </li>
                            <li>
                                <a href="@("https://twitter.com/intent/tweet?url=" + pageUrl)"
                                   target="_blank" rel="noopener" title="Twitter">
                                    <i class="fab fa-twitter"></i>
                                </a>
                            </li>
                            <li>
                                <a href="@("https://www.linkedin.com/shareArticle?mini=true&url=" + pageUrl)"
                                   target="_blank" rel="noopener" title="LinkedIn">
                                    <i class="fab fa-linkedin"></i>
                                </a>
                            </li>
                            <li>
                                <a href="@("https://api.whatsapp.com/send?text=" + pageUrl)"
                                   target="_blank" rel="noopener" title="WhatsApp">
                                    <i class="fab fa-whatsapp"></i>
                                </a>
                            </li>
                            <li>
                                <a href="@("https://t.me/share/url?url=" + pageUrl)"
                                   target="_blank" rel="noopener" title="Telegram">
                                    <i class="fab fa-telegram"></i>
                                </a>
                            </li>
                            <li>
                                <a href="@("https://www.instagram.com/?url=" + pageUrl)"
                                   target="_blank" rel="noopener" title="Instagram">
                                    <i class="fab fa-instagram"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>