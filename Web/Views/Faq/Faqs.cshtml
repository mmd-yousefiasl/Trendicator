@using Application.Dtos.Faq.ClientSide
@model List<ClientSideFaqViewModel>

@{
    ViewData["Title"] = "سوالات متداول";
}

<main>
    <!-- ============ Breadcrumb ============ -->
    <div class="container">
        <ul class="crumbs">
            <partial name="_IndexLink" />
            <li>سوالات متداول</li>
        </ul>
    </div>

    <!-- ============ FAQ ============ -->
    <section class="section" style="padding-block-start:8px">
        <div class="container" style="max-width:820px">
            <div class="section-head section-head--center">
                <span class="kicker">پشتیبانی</span>
                <h1 class="mt-1">سوالات متداول</h1>
                <p>پاسخ پرتکرارترین سوالات شما درباره خرید، دانلود، لایسنس و پشتیبانی محصولات ترندیکیتور.</p>
            </div>

            <div class="faq">
                @foreach (var item in Model ?? new List<ClientSideFaqViewModel>())
                {
                    <details>
                        <summary>@item.Question</summary>
                        <div class="faq__wrap">
                            <div class="faq__a">
                                @item.Answer
                            </div>
                        </div>
                    </details>
                }
            </div>

            <!-- CTA -->
            <div class="card card-pad text-center mt-4" style="background:linear-gradient(135deg, var(--brand-soft), transparent 60%); border-color:var(--brand-line)">
                <h2>پاسخ سوالتان را پیدا نکردید؟</h2>
                <p class="text-muted" style="max-width:48ch;margin-inline:auto">
                    تیم پشتیبانی
                    ترندیکاتور
                    آماده پاسخ‌گویی به سوالات فنی و خرید شماست — از طریق فرم تماس یا تیکت پشتیبانی با ما در ارتباط باشید.
                    </p>
                <div class="flex flex--center flex--wrap mt-3">
                    <a asp-area="" asp-controller="ContactUs" asp-action="ContactUs" class="btn btn--primary btn--lg">تماس با پشتیبانی</a>
                </div>
            </div>
        </div>
    </section>
</main>