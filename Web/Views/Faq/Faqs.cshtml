@using Application.Dtos.Faq.ClientSide
@model List<ClientSideFaqViewModel>

@{
    ViewData["Title"] = "سوالات متداول";
}

<div class="ltn__breadcrumb-area ltn__breadcrumb-area-2 ltn__breadcrumb-color-white bg-overlay-theme-black-70 bg-image"
     data-bg="@SiteTools.BreadcrumbBanner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner ltn__breadcrumb-inner-2 justify-content-between">
                    <div class="section-title-area ltn__section-title-2">
                        <h1 class="section-title white-color">سوالات متداول</h1>
                    </div>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                            <li>سوالات متداول</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model?.Any() ?? false)
{
    <div class="ltn__faq-area mb-100">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="ltn__faq-inner ltn__faq-inner-2">
                        <div id="accordion_2">
                            @{
                                int counter = 0;
                                foreach (var item in Model ?? new List<ClientSideFaqViewModel>())
                                {
                                    counter++;
                                    <!-- card -->
                                    <div class="card">
                                        <h6 class="collapsed ltn__card-title" data-toggle="collapse" data-target="#faq-item-2-@counter" aria-expanded="false">
                                            @item.Question
                                        </h6>
                                        <div id="faq-item-2-@counter" class="collapse" data-parent="#accordion_2">
                                            <div class="card-body">
                                                <p>@item.Answer</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- COUNTER UP AREA END -->
@await Component.InvokeAsync("LatestBlogs")

@await Component.InvokeAsync("OurFeatures")