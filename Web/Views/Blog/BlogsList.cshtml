@using Application.ViewModels.Blog.ClientSide
@model ClientSideFilterBlogsViewModel

@{
    ViewData["Title"] = "بلاگ";
}

<div class="ltn__breadcrumb-area ltn__breadcrumb-area-2 ltn__breadcrumb-color-white bg-overlay-theme-black-90 bg-image" data-bg="/assets/img/bg/9.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner ltn__breadcrumb-inner-2 justify-content-between">
                    <div class="section-title-area ltn__section-title-2">
                        <h6 class="section-subtitle ltn__secondary-color">
                            به
                            @SiteTools.SiteName
                            خوش آمدید
                        </h6>
                        <h1 class="section-title white-color">بلاگ</h1>
                    </div>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                            <li>بلاگ</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="ltn__blog-area ltn__blog-item-3-normal mb-120">
    <div class="container">
        @if (Model?.Entities?.Any() ?? false)
        {
            <form asp-area="" asp-controller="Blog" asp-action="BlogsList" method="get" id="search-form">
                <input type="hidden" asp-for="Page" id="Page" />
            </form>
            <div class="row">
                @foreach (var item in Model?.Entities ?? new List<ClientSideBlogViewModel>())
                {
                    <div class="col-lg-4 col-sm-6 col-12">
                        <partial name="_BlogListView" model="@item" />
                    </div>
                }
            </div>
            <partial name="_Paging" model="@Model.GetCurrentPaging()" />
        }
        else
        {
            <partial name="_NotFoundPartial" />
        }
    </div>
</div>

@await Component.InvokeAsync("OurFeatures")