@using Application.Dtos.Blog.ClientSide
@model ClientSideFilterBlogsViewModel

@{
    ViewData["Title"] = (!string.IsNullOrWhiteSpace(Model.CategoryTitle) ? ((Model.CategoryTitle + " | ترندیکاتور")) : "آموزش‌های گام‌به‌گام تحلیل تکنیکال، استراتژی‌سازی و مدیریت ریسک | ترندیکاتور");
    if (!string.IsNullOrWhiteSpace(Model.CategorySlug))
    {
        ViewData["CanonicalOverride"] = (SiteTools.SiteUrl + "blogs/" + Model.CategorySlug);
    }
}

<main class="container">
    <ul class="crumbs">
        <partial name="_IndexLink" />
        <li>وبلاگ</li>
    </ul>

    <div class="section-head">
        <h1>وبلاگ آموزشی</h1>
        <p>آموزش‌های گام‌به‌گام تحلیل تکنیکال، استراتژی‌سازی و مدیریت ریسک — نوشته‌شده توسط تیم معامله‌گران ترندیکیتور، برای معامگران فارسی‌زبان.</p>
    </div>

 
    <!-- ============ Category filter ============ -->
    <form novalidate asp-area="" asp-controller="Blog" asp-action="BlogsList" method="get" class="flex flex--wrap mb-3" style="gap:8px" id="search-form">
        <input type="hidden" asp-for="Page" id="Page" />

        @await Component.InvokeAsync("BlogCategories")
    </form>

    @if (Model?.Entities.Any() ?? false)
    {
        <!-- ============ Articles grid ============ -->
        <section class="section" style="padding-top:8px">
            <div class="grid grid--3">
                @foreach (var item in Model.Entities ?? new List<ClientSideBlogViewModel>())
                {
                    <partial name="_BlogCard" model="item" />
                }
            </div>

            <partial name="_Paging" model="Model.GetCurrentPaging()" />
        </section>
    }
    else
    {
        <partial name="_NotFoundPartial" />
    }
</main>