@using Application.Dtos.Blog.ClientSide
@using Application.Tools
@model ClientSideBlogDetailsViewModel

<main class="container">
    <ul class="crumbs">
        <partial name="_IndexLink" />
        <li><a asp-area="" asp-controller="Blog" asp-action="BlogsList" asp-route-category="">وبلاگ</a></li>
        <li>@Model.Title</li>
    </ul>

    <!-- ============ Article header ============ -->
    <div class="section-head mt-3">
        <span class="kicker mb-1">@Model.Category</span>
        <h1 class="mt-1">@Model.Title</h1>
        <div class="post-meta mt-1">
            <span>@Model.CreatedDate.GetDate()</span>
            <span>
                ·
                @Model.TimeToRead
                دقیقه مطالعه
            </span>
            <span>
                · نویسنده:
                @Model.Writer
            </span>
        </div>
    </div>

    <!-- ============ Article body ============ -->
    <section class="section" style="padding-top:8px">
        <article class="prose">
            @Html.Raw(Model.Body)
        </article>
    </section>

    <!-- ============ Comments ============ -->
    <section class="section" style="padding-top:0" id="comments-section">
        <div class="container" style="padding-inline:0">
            <div class="comments">
                <div class="section-head">
                    <span class="kicker">
                        گفتگو
                    </span>
                    <h2 class="mt-1">دیدگاه کاربران</h2>
                </div>

                <partial name="_AddBlogComment" model="@(new ClientSideAddCommentDto() { BlogId = Model.Id })" />

                @if (Model.Comments?.Any() ?? false)
                {
                    <div class="comments__list" data-comment-list>
                        @foreach (var item in Model.Comments ?? new List<ClientSideBlogCommentDto>())
                        {
                            <article class="comment">
                                <div class="comment__avatar" aria-hidden="true">@item.Name.FirstOrDefault()</div>
                                <div class="comment__body">
                                    <div class="comment__head">
                                        <b>@item.Name</b>
                                        <span class="comment__time">@item.CreatedDate.GetDate()</span>
                                    </div>
                                    <p>
                                        @item.Comment
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(item.Reply))
                                    {
                                        <div class="comment__reply">
                                            <div class="comment__head">
                                                <b>تیم ترندیکاتور</b>
                                                <span class="badge badge--brand">پاسخ رسمی</span>
                                                <span class="comment__time">@item.LastUpdatedDate.GetDate()</span>
                                            </div>
                                            @Html.Raw(item.Reply)
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <partial name="_NotFoundPartial" />
                }
            </div>
        </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="section" style="padding-top:0">
        <div class="container" style="padding-inline:0">
            <div class="card card-pad text-center"
                 style="background:linear-gradient(135deg, var(--brand-soft), transparent 60%); border-color:var(--brand-line); padding-block:40px">
                <h2>اندیکاتور متناسب با سبک خود را انتخاب کنید</h2>
                <p class="text-muted" style="max-width:48ch;margin-inline:auto">
                    در فروشگاه ترندیکیتور، همه اندیکاتورها بر اساس
                    پلتفرم و سبک معاملاتی دسته‌بندی شده‌اند تا انتخاب برایتان ساده‌تر باشد.
                </p>
                <div class="flex flex--center flex--wrap mt-3">
                    <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="" class="btn btn--primary btn--lg">مشاهده فروشگاه</a>
                </div>
            </div>
        </div>
    </section>


    @await Component.InvokeAsync("RelatedBlogs", new { id = Model.Id, categoryId = Model.CategoryId })
</main>