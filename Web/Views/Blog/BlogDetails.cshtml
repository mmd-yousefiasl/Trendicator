@using Application.Tools
@using Application.ViewModels.Blog.ClientSide
@using Application.ViewModels.BlogTag.ClientSide
@model ClientSideBlogDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="ltn__breadcrumb-area ltn__breadcrumb-area-2 ltn__breadcrumb-color-white bg-overlay-theme-black-70 bg-image"
     data-bg="@SiteTools.BreadcrumbBanner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner ltn__breadcrumb-inner-2 justify-content-between">
                    <div class="section-title-area ltn__section-title-2">
                        <h1 class="section-title white-color">وبلاگ</h1>
                    </div>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                            <li><a asp-area="" asp-controller="Blog" asp-action="BlogsList">مقالات</a></li>
                            <li>وبلاگ</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMB AREA END -->
<!-- PAGE DETAILS AREA START (blog-details) -->
<div class="ltn__page-details-area ltn__blog-details-area mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="ltn__blog-details-wrap">
                    <div class="ltn__page-details-inner ltn__blog-details-inner">
                        <div class="ltn__blog-meta">
                            <ul>
                                <li class="ltn__blog-category">
                                    <a asp-area="" asp-controller="Blog" asp-action="BlogsList" asp-route-Category="@Model.CategorySlug">
                                        @Model.Category
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <img src="@SiteTools.BlogBanner@Model.FileName" alt="@Model.Title" title="@Model.Title" />
                        <h2 class="ltn__blog-title">
                            @Model.Title
                        </h2>
                        <div class="ltn__blog-meta">
                            <ul>
                                <li class="ltn__blog-author">
                                    <a href="javascript:void(0)">
                                        نویسنده:
                                        @Model.Writer
                                    </a>
                                </li>
                                <li class="ltn__blog-date">
                                    <i class="far fa-calendar-alt"></i>@Model.CreatedDate.GetDate()
                                </li>
                            </ul>
                        </div>
                        @Html.Raw(Model.Body)
                    </div>
                    <!-- blog-tags-social-media -->
                    <div class="ltn__blog-tags-social-media mt-80 row">
                        @if (Model.Tags?.Any() ?? false)
                        {
                            <div class="ltn__tagcloud-widget col-lg-8">
                                <h4>برچسب های مرتبط</h4>
                                <ul>
                                    @foreach (var item in Model.Tags ?? new List<ClientSideBlogTagViewModel>())
                                    {
                                        <li>
                                            <a asp-area="" asp-controller="Blog" asp-action="BlogsList" asp-route-TagId="@item.Id">@item.Title</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        <div class="ltn__social-media text-right col-lg-4">
                            <h4>اشتراک گذاری</h4>
                            <ul>
                                <li><a href="javascript:void(0)" title="Facebook"><i class="fab fa-facebook-f"></i></a></li>
                                <li><a href="javascript:void(0)" title="Twitter"><i class="fab fa-twitter"></i></a></li>
                                <li><a href="javascript:void(0)" title="Linkedin"><i class="fab fa-linkedin"></i></a></li>
                                <li><a href="javascript:void(0)" title="Youtube"><i class="fab fa-youtube"></i></a></li>
                            </ul>
                        </div>
                        <div class="ltn__tagcloud-widget col-lg-12 mt-5">
                            <h4>لینک کوتاه: </h4>
                            <ul>
                                <li>
                                    <a asp-area="" asp-controller="Blog" asp-action="BlogDetails" asp-route-id="@Model.Id" title="لینک کوتاه">
                                        @(SiteTools.SiteUrl + "b/" + Model.Id)
                                    </a>
                                </li>
                                <li>
                                    <button class="bg-transparent" type="button" title="کپی لینک کوتاه" onclick="CopyUrlToClipboard('@(SiteTools.SiteUrl + "b/" + Model.Id)')">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 408 480"><path fill="#000000" d="M299 5v43H43v299H0V48q0-18 12.5-30.5T43 5h256zm64 86q17 0 29.5 12.5T405 133v299q0 18-12.5 30.5T363 475H128q-18 0-30.5-12.5T85 432V133q0-17 12.5-29.5T128 91h235zm0 341V133H128v299h235z" /></svg>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                    @await Component.InvokeAsync("RelatedBlogs", new { id = Model.Id, categoryId = Model.CategoryId })
                </div>
            </div>
            <div class="col-lg-4">
                <aside class="sidebar-area blog-sidebar ltn__right-sidebar">
                    @await Component.InvokeAsync("BlogCategories")

                    @await Component.InvokeAsync("BlogDetailsSocialMedia")

                    @await Component.InvokeAsync("BlogTags")
                </aside>
            </div>
        </div>
    </div>
</div>

@await Component.InvokeAsync("OurFeatures")