@using Application.Dtos.SiteData.ClientSide
@using Application.Tools
@model ClientSidePrivacyPolicyDto

@{
    ViewData["Title"] = "سیاست حفظ حریم خصوصی";
}

<main>
    <div class="container">
        <ul class="crumbs">
            <partial name="_IndexLink" />
            <li>@ViewData["Title"]</li>
        </ul>

        <div class="section-head mt-3">
            <span class="kicker">قوانین و مقررات</span>
            <h1 class="mt-3">@ViewData["Title"]</h1>
            <p class="hint">
                آخرین بروزرسانی:
                @Model.LastUpdatedDate.GetDate()
            </p>
        </div>

        <div class="prose mb-3">
            @Html.Raw(Model.Content)
        </div>
    </div>
</main>