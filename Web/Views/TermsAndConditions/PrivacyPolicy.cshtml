@model string

@{
    ViewData["Title"] = "سیاست حفظ حریم خصوصی";
}

<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area ltn__breadcrumb-area-2 ltn__breadcrumb-color-white bg-overlay-theme-black-70 bg-image plr--9---"
     data-bg="@SiteTools.BreadcrumbBanner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner ltn__breadcrumb-inner-2 justify-content-between">
                    <div class="section-title-area ltn__section-title-2">
                        <h1 class="section-title white-color">@ViewData["Title"]</h1>
                    </div>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                            <li>@ViewData["Title"]</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMB AREA END -->
@if (!string.IsNullOrWhiteSpace(Model))
{
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__blog-details-wrap">
                    <div class="ltn__page-details-inner ltn__blog-details-inner">
                        <h2 class="ltn__blog-title">
                            سیاست حفظ حریم خصوصی
                        </h2>
                        @Html.Raw(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@await Component.InvokeAsync("OurFeatures")