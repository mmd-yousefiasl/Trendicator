@using Application.Tools
@using Application.ViewModels.ProductWishList.ClientSide
@model ClientSideFilterProductWishListViewModel

@{
    ViewData["Title"] = "علاقه مندی ها";
}

<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area ltn__breadcrumb-area-2 ltn__breadcrumb-color-white bg-overlay-theme-black-70 bg-image"
     data-bg="@SiteTools.BreadcrumbBanner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner ltn__breadcrumb-inner-2 justify-content-between">
                    <div class="section-title-area ltn__section-title-2">
                        <h1 class="section-title white-color">علاقه مندی ها</h1>
                    </div>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                            <li>علاقه مندی ها</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="liton__wishlist-area mb-105">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="shoping-cart-inner">
                    @if (Model?.Entities?.Any() ?? false)
                    {
                        <form asp-area="" asp-controller="ProductWishList" asp-action="WishList" method="get" id="search-form">
                            <input type="hidden" asp-for="Page" id="Page" />
                        </form>

                        <div class="shoping-cart-table table-responsive">
                            <table class="table">
                                <tbody>
                                    @foreach (var item in Model.Entities ?? new List<ClientSideProductWishListViewModel>())
                                    {
                                        <tr>
                                            <td class="cart-product-remove">
                                                <a asp-area="" asp-controller="ProductWishList" asp-action="DeleteWishList" asp-route-id="@item.Id">
                                                    x
                                                </a>
                                            </td>
                                            <td class="cart-product-image">
                                                <a asp-area="" asp-controller="Product" asp-action="ProductDetails" asp-route-slug="@item.Slug">
                                                    <img src="@SiteTools.ProductBanner@item.FileName" alt="@item.Title">
                                                </a>
                                            </td>
                                            <td class="cart-product-info">
                                                <h4>
                                                    <a asp-area="" asp-controller="Product" asp-action="ProductDetails" asp-route-slug="@item.Slug">
                                                        @item.Title
                                                    </a>
                                                </h4>
                                            </td>
                                            <td class="cart-product-price">
                                                @item.Price.ToToman()
                                            </td>
                                            <td class="cart-product-stock">
                                                @if (item.IsAvailable)
                                                {
                                                    @: موجود
                                                }
                                                else
                                                {
                                                    @: ناموجود
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
                    }
                    else
                    {
                        <partial name="_NotFoundPartial" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>


@await Component.InvokeAsync("OurFeatures")