<!-- Utilize Mobile Menu Start -->
<div id="ltn__utilize-mobile-menu" class="ltn__utilize ltn__utilize-mobile-menu">
    <div class="ltn__utilize-menu-inner ltn__scrollbar">
        <div class="ltn__utilize-menu-head">
            @await Component.InvokeAsync("MobileSiteLogo")
            <button class="ltn__utilize-close">×</button>
        </div>
        <div class="ltn__utilize-menu-search-form">
            <form asp-area="" asp-controller="Product" asp-action="ProductsList" method="get">
                <input type="text" name="Search" value="" placeholder="جستجو کنید ...">
                <button><i class="fas fa-search"></i></button>
            </form>
        </div>
        <div class="ltn__utilize-menu">
            <ul>
                <li><a asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                <li><a asp-area="" asp-controller="Product" asp-action="ProductsList">محصولات</a></li>
                <li permission="AdminPanel"><a asp-area="Admin" asp-controller="Home" asp-action="Index">پنل ادمین</a></li>
                <li><a asp-area="" asp-controller="Blog" asp-action="BlogsList">بلاگ</a></li>
            </ul>
        </div>
        <div class="ltn__utilize-buttons ltn__utilize-buttons-2">
            <ul>
                <li>
                    <a asp-area="UserPanel" asp-controller="Home" asp-action="Index">
                        <span class="utilize-btn-icon">
                            <i class="far fa-user"></i>
                        </span>
                        داشبورد
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="ProductWishList" asp-action="WishList">
                        <span class="utilize-btn-icon">
                            <i class="far fa-heart"></i>
                        </span>
                        علاقه مندی ها
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Cart" asp-action="Cart">
                        <span class="utilize-btn-icon">
                            <i class="fas fa-shopping-cart"></i>
                        </span>
                        سبد خرید
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- Utilize Mobile Menu End -->

<div class="ltn__utilize-overlay"></div>


<div class="mobile-header-menu-fullwidth">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <!-- Mobile Menu Button -->
                <div class="mobile-menu-toggle d-lg-none">
                    <span>منو</span>
                    <a href="#ltn__utilize-mobile-menu" class="ltn__utilize-toggle" title="منوی کاربری">
                        <svg viewBox="0 0 800 600">
                            <path d="M300,220 C300,220 520,220 540,220 C740,220 640,540 520,420 C440,340 300,200 300,200" id="top"></path>
                            <path d="M300,320 L540,320" id="middle"></path>
                            <path d="M300,210 C300,210 520,210 540,210 C740,210 640,530 520,410 C440,330 300,190 300,190" id="bottom" transform="translate(480, 320) scale(1, -1) translate(-480, -318) "></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>