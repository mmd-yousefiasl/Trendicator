@if (TempData["ErrorMessage"] != null)
{
    <script asp-append-version="true">
        Swal.fire({
            icon: 'error',
            html: '@TempData["ErrorMessage"]',
            confirmButtonText: 'باشه'
        })
    </script>
}

@if (TempData["SuccessMessage"] != null)
{
    <script asp-append-version="true">
        Swal.fire({
            icon: 'success',
            html: '@TempData["SuccessMessage"]',
            confirmButtonText: 'باشه'
        });
    </script>
}


@if (TempData["InfoMessage"] != null)
{
    <script asp-append-version="true">

        Swal.fire({
            icon: 'info',
            html: '@TempData["InfoMessage"]',
            confirmButtonText: 'باشه'
        });

    </script>
}


@if (TempData["WarningMessage"] != null)
{
    <script asp-append-version="true">

        Swal.fire({
            icon: 'warning',
            html: '@TempData["WarningMessage"]',
            confirmButtonText: 'باشه'
        });
    </script>
}


@if (TempData["TemporarySuccessMessage"] != null)
{
    <script>
        Toast.success(@Html.Raw(Json.Serialize(TempData["TemporarySuccessMessage"])), {
            duration: 5000
        });
    </script>
}

@if (TempData["TemporaryErrorMessage"] != null)
{
    <script>
        Toast.error(@Html.Raw(Json.Serialize(TempData["TemporaryErrorMessage"])), {
            duration: 5000
        });
    </script>
}

@if (TempData["TemporaryMessage"] != null)
{
    <script>
        Toast.info(@Html.Raw(Json.Serialize(TempData["TemporaryMessage"])), {
            duration: 5000
        });
    </script>
}