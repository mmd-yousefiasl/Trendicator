@using Domain.Models
@model PagingViewModel

@if (Model.PageCount > 1)
{
    <div class="ltn__pagination-area text-center">
        <div class="ltn__pagination">
            <ul>
                @if (Model.StartPage < Model.Page)
                {
                    <li>
                        <button type="button" class="bg-none" data-page="@(Model.Page - 1)" onclick="FillPageId(@(Model.Page - 1))">
                            <i class="fas fa-angle-double-right"></i>
                        </button>
                    </li>
                }
                @for (int i = Model.StartPage; i <= Model.EndPage; i++)
                {
                    if (Model.Page == i)
                    {
                        <li class="active">
                            <button type="button" class="bg-none" data-page="0">@i</button>
                        </li>
                    }
                    else
                    {
                        <li>
                            <button type="button" class="bg-none" data-page="@i" onclick="FillPageId(@i)">@i</button>
                        </li>
                    }
                }
                @if (Model.EndPage > Model.Page)
                {
                    <li>
                        <button type="button" class="bg-none" data-page="@(Model.Page + 1)" onclick="FillPageId(@(Model.Page + 1))">
                            <i class="fas fa-angle-double-left"></i>
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>
}