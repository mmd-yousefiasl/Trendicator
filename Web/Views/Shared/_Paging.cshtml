@using Domain.Models
@model PagingViewModel

@if (Model.PageCount > 1)
{
    <nav class="pagination" aria-label="صفحه‌بندی">
        @if (Model.StartPage < Model.Page)
        {
            <a href="javascript:void(0)" aria-label="صفحه قبل" data-page="@(Model.Page - 1)" onclick="FillPageId(@(Model.Page - 1))">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </a>
        }
        @for (int i = Model.StartPage; i <= Model.EndPage; i++)
        {
            if (Model.Page == i)
            {
                <a href="javascript:void(0)" class="is-active" aria-current="page">@i</a>
            }
            else
            {
                <a href="javascript:void(0)" data-page="@i" onclick="FillPageId(@i)">@i</a>
            }
        }
        @if (Model.EndPage > Model.Page)
        {
            <a href="javascript:void(0)" aria-label="صفحه بعد" data-page="@(Model.Page + 1)" onclick="FillPageId(@(Model.Page + 1))">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </a>
        }
    </nav>
}