<!DOCTYPE html>
<html class="no-js" lang="fa">
<head>
    <partial name="_Meta" />
    <title>@ViewData["Title"] | @SiteTools.SiteName</title>

    <partial name="_HeaderReferences" />

    @await RenderSectionAsync("HeaderReferences", required: false)
</head>
<body>
    <div class="body-wrapper">

        <partial name="_Header" />
        <partial name="_Menu" />

        @RenderBody()

        <partial name="_Footer" />

        <partial name="_Modals" />

        <partial name="_SiteModals" />

    </div>

    <partial name="_Loader" />

    <partial name="_FooterReferences" />

    <partial name="_Notification" />

    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("FooterReferences", required: false)
</body>
</html>
