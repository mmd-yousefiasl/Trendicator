@using Application.Tools
@using Application.ViewModels.Blog.ClientSide
@model ClientSideBlogViewModel

@if (Model is not null)
{
    <div class="ltn__blog-item ltn__blog-item-3">
        <div class="ltn__blog-img">
            <a asp-area="" asp-controller="Blog" asp-action="BlogDetails" asp-route-slug="@Model.Slug">
                <img src="@SiteTools.BlogBanner@Model.FileName" alt="@Model.Title" title="@Model.Title">
            </a>
        </div>
        <div class="ltn__blog-brief">
            <div class="ltn__blog-meta">
                <ul>
                    <li class="ltn__blog-author">
                        <i class="far fa-user"></i>
                        نویسنده:
                        @Model.Writer
                    </li>
                    <li class="ltn__blog-tags">
                        <a asp-area="" asp-controller="Blog" asp-action="BlogsList" asp-route-CategoryId="@Model.CategoryId">
                            <i class="fas fa-tags"></i>@Model.Category
                        </a>
                    </li>
                </ul>
            </div>
            <h3 class="ltn__blog-title blog-title">
                <a asp-area="" asp-controller="Blog" asp-action="BlogDetails" asp-route-slug="@Model.Slug">@Model.Title</a>
            </h3>
            <div class="ltn__blog-meta-btn">
                <div class="ltn__blog-meta">
                    <ul>
                        <li class="ltn__blog-date"><i class="far fa-calendar-alt"></i>@Model.CreatedDate.GetDate()</li>
                    </ul>
                </div>
                <div class="ltn__blog-btn">
                    <a asp-area="" asp-controller="Blog" asp-action="BlogDetails" asp-route-slug="@Model.Slug">ادامه مطلب</a>
                </div>
            </div>
        </div>
    </div>
}