@using Application.Dtos.Product.ClientSide
@model ClientSideAddProductCommentDto

<!-- ============ فرم ثبت نظر ============ -->
<form class="comments__form card card-pad mt-4" id="review-form"
      method="post" asp-area="" asp-controller="Product" asp-action="AddComment">
    <input type="hidden" asp-for="ProductId" />

    <!-- سربرگ فرم: عنوان + راهنما در یک ردیف -->
    <div class="flex flex--between flex--wrap" style="gap:6px 12px">
        <h3 class="mb-0">ثبت نظر</h3>
        <span class="hint">نظر شما پس از تأیید کارشناسان نمایش داده می‌شود.</span>
    </div>

    <!-- نام و ایمیل کنار هم -->
    <div class="grid grid--2" style="gap:0 16px; margin-top:18px">
        <div class="field">
            <label asp-for="Name"></label>
            <input class="input" type="text" asp-for="Name" />
            <span asp-validation-for="Name"></span>
        </div>
        <div class="field">
            <label asp-for="Email"></label>
            <input class="input" asp-for="Email" dir="ltr" />
            <span asp-validation-for="Email"></span>
        </div>
    </div>

    <!-- امتیاز -->
    <div class="field">
        <label asp-for="Stars"></label>
        <div class="rating-input" role="radiogroup" aria-label="امتیاز">
            <input type="radio" id="star-5" asp-for="Stars" value="5" />
            <label for="star-5" title="۵ ستاره">★</label>
            <input type="radio" id="star-4" asp-for="Stars" value="4" />
            <label for="star-4" title="۴ ستاره">★</label>
            <input type="radio" id="star-3" asp-for="Stars" value="3" />
            <label for="star-3" title="۳ ستاره">★</label>
            <input type="radio" id="star-2" asp-for="Stars" value="2" />
            <label for="star-2" title="۲ ستاره">★</label>
            <input type="radio" id="star-1" asp-for="Stars" value="1" />
            <label for="star-1" title="۱ ستاره">★</label>
        </div>
        <span asp-validation-for="Stars"></span>
    </div>

    <!-- متن نظر -->
    <div class="field">
        <label asp-for="Review"></label>
        <textarea class="textarea" asp-for="Review"></textarea>
        <span asp-validation-for="Review"></span>
    </div>

    <!-- دکمه در انتهای سمت شروع (RTL) -->
    <button type="submit" class="btn btn--primary">ثبت نظر</button>
</form>