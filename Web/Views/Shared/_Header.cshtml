<header class="ltn__header-area ltn__header-3 section-bg-6">
    <div class="ltn__header-middle-area">
        <div class="container">
            <div class="row">
                @await Component.InvokeAsync("SiteLogo")
                <div class="col header-contact-serarch-column d-none d-lg-block">
                    <div class="header-contact-search">
                        @await Component.InvokeAsync("SitePhone")
                        <div class="header-search-2">
                            <form asp-area="" asp-controller="Product" asp-action="ProductsList" method="get">
                                <input type="text" name="Search" value="" placeholder="جستجو کنید ..." />
                                <button type="submit">
                                    <span><i class="icon-search"></i></span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <!-- header-options -->
                    <div class="ltn__header-options">
                        <ul>
                            <li class="d-lg-none">
                                <!-- header-search-1 -->
                                <div class="header-search-wrap">
                                    <div class="header-search-1">
                                        <div class="search-icon">
                                            <i class="icon-search  for-search-show"></i>
                                            <i class="icon-cancel  for-search-close"></i>
                                        </div>
                                    </div>
                                    <div class="header-search-1-form">
                                        <form asp-area="" asp-controller="Product" asp-action="ProductsList" method="get">
                                            <input type="text" name="Search" value="" placeholder="جستجو کنید ..." />
                                            <button type="submit">
                                                <span><i class="icon-search"></i></span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </li>
                            <li class="d-none---">
                                <!-- user-menu -->
                                <div class="ltn__drop-menu user-menu">
                                    <ul>
                                        <li>
                                            <a href="javascript:void(0)"><i class="icon-user"></i></a>
                                            <ul>
                                                <li><a asp-area="" asp-controller="ProductWishList" asp-action="WishList">علاقه مندی ها</a></li>
                                                <li><a asp-area="" asp-controller="ProductCompare" asp-action="Compare">مقایسه</a></li>
                                                <li><a asp-area="" asp-controller="Cart" asp-action="Cart">سبد خرید</a></li>

                                                @if (User?.Identity?.IsAuthenticated ?? false)
                                                {
                                                    <li><a asp-area="UserPanel" asp-controller="Home" asp-action="Index">حساب من</a></li>
                                                    <li><a asp-area="" asp-controller="Account" asp-action="Logout">خروج از حساب</a></li>
                                                }
                                                else
                                                {
                                                    <li><a asp-area="" asp-controller="Account" asp-action="Login">ورود</a></li>
                                                }
                                            </ul>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            <li>
                                <!-- mini-cart 2 -->
                                <div class="mini-cart-icon mini-cart-icon-2">
                                    <a href="#ltn__utilize-cart-menu" class="ltn__utilize-toggle" onclick="LoadCartModal()">
                                        <span class="mini-cart-icon">
                                            <i class="icon-shopping-cart"></i>
                                        </span>
                                    </a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ltn__header-middle-area end -->
    <!-- header-bottom-area start -->
    <div class="header-bottom-area ltn__border-top ltn__header-sticky  ltn__sticky-bg-black--- ltn__sticky-bg-secondary ltn__secondary-bg menu-color-white d-none d-lg-block sticky-header-background">
        <div class="container">
            <div class="row">
                <div class="col header-menu-column justify-content-center">
                    @await Component.InvokeAsync("StickySiteLogo")
                    <div class="header-menu header-menu-2">
                        <nav>
                            <div class="ltn__main-menu">
                                <ul>
                                    <li><a asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                                    <li><a asp-area="" asp-controller="Product" asp-action="ProductsList">محصولات</a></li>
                                    <li permission="AdminPanel"><a asp-area="Admin" asp-controller="Home" asp-action="Index">پنل ادمین</a></li>
                                    <li><a asp-area="UserPanel" asp-controller="Home" asp-action="Index">داشبورد</a></li>
                                    <li><a asp-area="" asp-controller="Blog" asp-action="BlogsList">بلاگ</a></li>
                                    <li><a asp-area="" asp-controller="ProductWishList" asp-action="WishList">علاقه مندی ها</a></li>
                                    <li><a asp-area="" asp-controller="Cart" asp-action="Cart">سبد خرید</a></li>
                                </ul>
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>