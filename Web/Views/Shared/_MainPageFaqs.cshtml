@using Application.Dtos.Faq.ClientSide
@model List<ClientSideFaqViewModel>

@if (Model?.Any() ?? false)
{
    <section class="section section--soft">
        <div class="container" style="max-width:820px">
            <div class="section-head section-head--center">
                <a asp-area="" asp-controller="Faq" asp-action="Faqs" class="kicker">سوالات متداول</a>
                <h2 class="mt-1">هر آنچه باید بدانید</h2>
            </div>
            <div class="faq">
                @foreach (var item in Model.ToList() ?? new List<ClientSideFaqViewModel>())
                {
                    <details>
                        <summary>@item.Question</summary>
                        <div class="faq__wrap">
                            <div class="faq__a">
                                @item.Answer
                            </div>
                        </div>
                    </details>
                }
            </div>
        </div>
    </section>
}