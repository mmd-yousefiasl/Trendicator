<footer class="site-footer">
    <div class="container">
        <div class="site-footer__grid">
            <div class="site-footer__about">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="logo mb-2">
                    <img src="/assets/img/logo.svg" alt="@SiteTools.SiteName" width="30" height="30">
                    <span>ترند<b>یکاتور</b></span>
                </a>
                <p>مرجع تخصصی اندیکاتور و اکسپرت معاملاتی برای معامگران ایرانی — ساخته‌شده با دقت، پشتیبانی‌شده با تعهد.</p>
            </div>
            <div>
                <h4>فروشگاه</h4>
                <ul>
                    <li><a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="">همه اندیکاتورها</a></li>
                    @await Component.InvokeAsync("FooterProductCategories")
                </ul>
            </div>
            <div>
                <h4>راهنما</h4>
                <ul>
                    <li><a href="guide.html">اندیکاتور چیست؟</a></li>
                    <li><a asp-area="" asp-controller="Faq" asp-action="Faqs">سوالات متداول</a></li>
                    <li><a asp-area="" asp-controller="Blog" asp-action="BlogsList" asp-route-category="">وبلاگ آموزشی</a></li>
                    <li><a asp-area="" asp-controller="ContactUs" asp-action="ContactUs">تماس با ما</a></li>
                </ul>
            </div>
            <div>
                <h4>قوانین</h4>
                <ul>
                    <li><a asp-area="" asp-controller="TermsAndConditions" asp-action="TermsAndConditions">شرایط و ظوابط</a></li>
                    <li><a asp-area="" asp-controller="TermsAndConditions" asp-action="PrivacyPolicy">حریم خصوصی</a></li>
                </ul>
            </div>
        </div>
        <div class="site-footer__bar">
            @await Component.InvokeAsync("FooterContent")
            <div class="trust-badges">
                <span class="badge">پرداخت امن</span>
                <span class="badge badge--brand">۷ روز ضمانت بازگشت</span>
            </div>
        </div>
    </div>
</footer>