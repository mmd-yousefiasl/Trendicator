@using Application.ViewModels.NewsLetter.ClientSide

<footer class="ltn__footer-area  ">
    <div class="footer-top-area  section-bg-1 plr--5">
        <div class="container-fluid">
            <div class="row">
                @await Component.InvokeAsync("FooterSiteData")
                <div class="col-xl-2 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget footer-menu-widget clearfix">
                        <h4 class="footer-title">شرکت</h4>
                        <div class="footer-menu">
                            <ul>
                                <li><a asp-area="" asp-controller="Blog" asp-action="BlogsList">بلاگ</a></li>
                                <li><a asp-area="" asp-controller="Product" asp-action="ProductsList">محصولات</a></li>
                                <li><a asp-area="" asp-controller="Faq" asp-action="Faqs">سوالات متداول</a></li>
                                <li><a asp-area="" asp-controller="ContactUs" asp-action="ContactUs">تماس باما</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget footer-menu-widget clearfix">
                        <h4 class="footer-title">خدمات</h4>
                        <div class="footer-menu">
                            <ul>
                                <li><a asp-area="" asp-controller="ProductCompare" asp-action="Compare">مقایسه</a></li>
                                <li><a asp-area="" asp-controller="ProductWishList" asp-action="WishList">علاقه مندی ها</a></li>
                                <li><a asp-area="" asp-controller="Account" asp-action="Login">ورود</a></li>
                                <li><a asp-area="" asp-controller="TermsAndConditions" asp-action="TermsAndConditions">شرایط و ضوابط</a></li>
                                <li><a asp-area="" asp-controller="TermsAndConditions" asp-action="PrivacyPolicy">سیاست حفظ حریم خصوصی</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget footer-menu-widget clearfix">
                        <h4 class="footer-title">مراقبت از مشتری</h4>
                        <div class="footer-menu">
                            <ul>
                                <li><a asp-area="" asp-controller="Account" asp-action="Login">ورود</a></li>
                                <li><a asp-area="UserPanel" asp-controller="Home" asp-action="Index">حساب من</a></li>
                                <li><a href="order-tracking.html">Order tracking</a></li>
                                <li><a asp-area="" asp-controller="Faq" asp-action="Faqs">سوالات متداول</a></li>
                                <li><a asp-area="" asp-controller="ContactUs" asp-action="ContactUs">تماس باما</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-sm-12 col-12">
                    <div class="footer-widget footer-newsletter-widget">
                        <h4 class="footer-title">خبرنامه</h4>
                        <p>در خبرنامه هفتگی ما عضو شوید و از طریق ایمیل، مطالب جدید را دریافت کنید.</p>
                        <div class="footer-newsletter">
                            <partial name="_SignInNewsLetters" model="@(new ClientSideSignInNewsLettersViewModel())" />
                        </div>
                        @await Component.InvokeAsync("FooterPaymentMethods")
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="ltn__copyright-area ltn__copyright-2 section-bg-2  ltn__border-top-2--- plr--5">
        <div class="container-fluid">
            <div class="row">
                @await Component.InvokeAsync("FooterContent")
                <div class="col-md-6 col-12 align-self-center">
                    <div class="ltn__copyright-menu text-right">
                        <ul>
                            <li><a asp-area="" asp-controller="TermsAndConditions" asp-action="TermsAndConditions">شرایط و ضوابط</a></li>
                            <li><a asp-area="" asp-controller="TermsAndConditions" asp-action="PrivacyPolicy">سیاست حفظ حریم خصوصی</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>