@model int

@if (Model <= 0)
{
    for (int i = 0; i < 5; i++)
    {
        <li><span><i class="fas fa-star"></i></span></li>
    }
}
else
{
    for (int i = 0; i < Model; i++)
    {
        <li><span><i class="fas fa-star"></i></span></li>
    }
    for(int i =0; i < (5 - Model); i++)
    {
        <li><span><i class="far fa-star"></i></span></li>
    }
}