@using Application.Dtos.Banner.ClientSide
@model List<ClientSideBannerViewModel>

@if (Model?.Any() ?? false)
{
    foreach (var item in Model.Take(1).ToList() ?? new List<ClientSideBannerViewModel>())
    {
        <a href="@item.Url" target="_blank">
            <img src="@SiteTools.Banner@item.FileName" alt="@item.Title" class="e-nemad">
        </a>
    }
}