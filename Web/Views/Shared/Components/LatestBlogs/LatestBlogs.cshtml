@using Application.Tools
@using Application.Dtos.Blog.ClientSide
@model ClientSideFilterBlogsViewModel

@if (Model?.Entities?.Any() ?? false)

{
    <div class="ltn__blog-area pt-115 pb-70">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title-area ltn__section-title-2 text-center">
                        <h2 class="section-title white-color---">آخرین مقالات</h2>
                    </div>
                </div>
            </div>
            <div class="row  ltn__blog-slider-one-active slick-arrow-1 ltn__blog-item-3-normal">
                @foreach (var item in Model.Entities ?? new List<ClientSideBlogViewModel>())
                {
                    <div class="col-lg-12">
                        <partial name="_BlogListView" model="@item" />
                    </div>
                }
            </div>
        </div>
    </div>
}