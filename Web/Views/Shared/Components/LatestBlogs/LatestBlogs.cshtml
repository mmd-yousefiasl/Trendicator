@using Application.Dtos.Blog.ClientSide
@model ClientSideFilterBlogsViewModel

@if (Model?.Entities?.Any() ?? false)
{
    <!-- ============ Blog preview ============ -->
    <section class="section">
        <div class="container">
            <div class="flex flex--between flex--wrap mb-3">
                <div class="section-head" style="margin-bottom:0">
                    <span class="kicker">آموزش</span>
                    <h2 class="mt-1">آخرین مقالات</h2>
                </div>
                <a asp-area="" asp-controller="Blog" asp-action="BlogsList" class="btn btn--ghost btn--sm">همه مقالات ←</a>
            </div>
            <div class="grid grid--3 grid--posts">
                @foreach (var item in Model.Entities ?? new List<ClientSideBlogViewModel>())
                {
                    <partial name="_BlogCard" model="item" />
            }
        </div>
    </div>
</section>
}