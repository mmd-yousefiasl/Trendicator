@using Application.Dtos.ProductReview.ClientSide
@using Application.Tools
@model List<ClientSideProductReviewDto>

@if (Model?.Any() ?? false)
{
    <div class="ltn__comment-area mb-30">
        <div class="ltn__comment-innser">
            <ul>
                @foreach (var item in Model ?? new List<ClientSideProductReviewDto>())
                {
                    <li>
                        <div class="ltn__comment-item clearfix">
                            <div class="ltn__commenter-comment">
                                <h6>@item.Name</h6>
                                <div class="product-ratting">
                                    <ul>
                                        <partial name="_ProductReviewStars" model="@item.Starts" />
                                    </ul>
                                </div>
                                <p>@item.Review</p>
                                <span class="ltn__comment-reply-btn">@item.CreatedDate.GetDate()</span>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
}
else
{
    <partial name="_NotFoundPartial" />
}
