@using Application.Tools
@model decimal

@if (Model > 0)
{
    <label class="wallet-row" for="useWallet">
        <input type="checkbox"
               id="useWallet"
               name="useWallet"
               value="true"
               class="wallet-row__check" />
        <span class="wallet-row__text">
            استفاده از موجودی کیف پول
            <br />
            (
            @Model.ToToman()
            )
            <small class="wallet-row__hint" data-wallet-balance></small>
        </span>
    </label>
}