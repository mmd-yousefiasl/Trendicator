@using Application.Dtos.Banner.ClientSide
@model List<ClientSideBannerViewModel>

@if (Model?.Any() ?? false)
{
    <div class="col-lg-6 col-md-6">
        <div class="row">
            @foreach (var item in Model.Take(2).ToList() ?? new List<ClientSideBannerViewModel>())
            {
                <div class="col-lg-12">
                    <div class="ltn__banner-item">
                        <div class="ltn__banner-img">
                            <a href="@item.Url"><img src="@SiteTools.Banner@item.FileName" alt="@item.Title" title="@item.Title"></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}