@using Application.Dtos.Testimonial.ClientSide
@model List<ClientSideTestimonialViewModel>

@if (Model?.Any() ?? false)
{
    <div class="ltn__testimonial-area section-bg-1 pb-70 pt-70">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title-area ltn__section-title-2 text-center">
                        <h2 class="section-title">بازخورد مشتریان<span></span></h2>
                    </div>
                </div>
            </div>
            <div class="row ltn__testimonial-slider-3-active slick-arrow-1 slick-arrow-1-inner">
                @foreach (var item in Model ?? new List<ClientSideTestimonialViewModel>())
                {
                    <div class="col-lg-12">
                        <div class="ltn__testimonial-item ltn__testimonial-item-4">
                            <div class="ltn__testimoni-info">
                                <p>@item.Content</p>
                                <h4>@item.Writer</h4>
                                <h6>@item.Position</h6>
                            </div>
                            <div class="ltn__testimoni-bg-icon">
                                <i class="far fa-comments"></i>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}