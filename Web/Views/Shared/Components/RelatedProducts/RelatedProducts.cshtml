@using Application.Dtos.Product.ClientSide
@model List<ClientSideProductViewModel>

@if (Model?.Any() ?? false)
{
    <!-- ============ Related ============ -->
    <section class="section" style="padding-top:0">
        <div class="section-head">
            <h2>محصولات مشابه</h2>
        </div>
        <div class="grid grid--3">
            @foreach (var item in Model ?? new List<ClientSideProductViewModel>())
            {
                <partial name="_ProductCard" model="@item" />
            }
        </div>
    </section>
}