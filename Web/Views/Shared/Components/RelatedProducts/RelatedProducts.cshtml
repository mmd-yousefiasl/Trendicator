@using Application.ViewModels.Product.ClientSide
@model List<ClientSideProductViewModel>

@if (Model?.Any() ?? false)
{
    <div class="ltn__product-slider-area ltn__product-gutter pb-70">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title-area ltn__section-title-2">
                        <h1 class="section-title">محصولات مرتبط</h1>
                    </div>
                </div>
            </div>
            <div class="row ltn__related-product-slider-one-active slick-arrow-1">
                @foreach (var item in Model ?? new List<ClientSideProductViewModel>())
                {
                    <div class="col-lg-12">
                        <partial name="_ProductListView" model="@item" />
                    </div>
                }
            </div>
        </div>
    </div>
}