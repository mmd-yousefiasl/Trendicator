@using Application.Dtos.Product.ClientSide
@model ClientSideFilterProductsViewModel

@if (Model?.Entities?.Any() ?? false)
{
    <!-- ============ Featured products ============ -->
    <section class="section">
        <div class="container">
            <div class="flex flex--between flex--wrap mb-3">
                <div class="section-head" style="margin-bottom:0">
                    <span class="kicker">محبوب ترین ها</span>
                    <h2 class="mt-1">اندیکاتورهای منتخب</h2>
                </div>
                <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="" class="btn btn--ghost btn--sm">مشاهده همه ←</a>
            </div>

            <div class="grid grid--4 grid--posts" tabindex="0" role="region" aria-label="محصولات منتخب">
                @foreach (var item in Model.Entities ?? new List<ClientSideProductViewModel>())
                {
                    <partial name="_ProductCard" model="@item" />
                }
            </div>
        </div>
    </section>
}