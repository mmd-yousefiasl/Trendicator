@using Application.ViewModels.Cart.ClientSide
@model ClientSideUpdateTradingViewAccountNameViewModel

@if (Model is not null && Model.IsAllowed)
{
    <div class="col-lg-12">
        <div class="ltn__checkout-inner">
            <div class="ltn__checkout-single-content mt-50">
                <h4 class="title-2">تکمیل اطلاعات خرید</h4>
                <div class="ltn__checkout-single-content-info">
                    <form asp-area="" asp-controller="Checkout" asp-action="UpdateTradingViewAccountName" method="post" onsubmit="submitAnimation()">
                        <div class="row">
                            <div class="col-lg-12 col-md-12">
                                <h6>
                                    نام اکانت
                                    TradingView
                                    (تریدینگ ویو)
                                    شما
                                </h6>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="coupon-container">
                                            <div class="input-item">
                                                <input type="text" asp-for="TradingViewAccountName" class="m-0" autocomplete="off">
                                            </div>
                                            <button type="submit" class="btn btn-secondary btn-effect-2 coupon-button btn-submit">ثبت</button>
                                        </div>

                                        <span class="text-danger" asp-validation-for="TradingViewAccountName"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}