@using Application.Dtos.SiteData.ClientSide
@model ClientSideSiteLogoViewModel

@if (Model is not null)
{
    <div class="site-logo">
        <a asp-area="" asp-controller="Home" asp-action="Index">
            <img src="@SiteTools.SiteLogo@Model.LightBgLogo" alt="@Model.SiteName">
        </a>
    </div>
}