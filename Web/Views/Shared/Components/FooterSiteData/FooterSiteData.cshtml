@using Application.ViewModels.SiteData.ClientSide
@model ClientSideSiteDataViewModel

@if (Model is not null)
{
    <div class="col-xl-3 col-md-6 col-sm-6 col-12">
        <div class="footer-widget footer-about-widget">
            <div class="footer-logo">
                <div class="site-logo">
                    <img src="@SiteTools.SiteLogo@Model.LightBgLogo" alt="@Model.SiteName">
                </div>
            </div>
            @if (Model.FooterDescription is not null)
            {
                <p>@Model.FooterDescription</p>
            }
        
            <div class="footer-address">
                <ul>
                    @if (Model.Address is not null)
                    {
                        <li>
                            <div class="footer-address-icon">
                                <i class="icon-placeholder"></i>
                            </div>
                            <div class="footer-address-info">
                                <p>@Model.Address</p>
                            </div>
                        </li>
                    }
            
                    @if (Model.Phone is not null)
                    {
                        <li>
                            <div class="footer-address-icon">
                                <i class="icon-call"></i>
                            </div>
                            <div class="footer-address-info">
                                <p><a href="tel:@Model.Phone">@Model.Phone</a></p>
                            </div>
                        </li>
                    }
              
                    @if (Model.Email is not null)
                    {
                        <li>
                            <div class="footer-address-icon">
                                <i class="icon-mail"></i>
                            </div>
                            <div class="footer-address-info">
                                <p><a href="mailto:@Model.Email">@Model.Email</a></p>
                            </div>
                        </li>
                    }
           
                </ul>
            </div>
            @await Component.InvokeAsync("FooterSocialMedia")
        </div>
    </div>
}