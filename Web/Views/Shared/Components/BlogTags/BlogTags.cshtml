@using Application.Dtos.BlogTag.ClientSide
@model List<ClientSideBlogTagViewModel>

@if (Model?.Any() ?? false)
{
    <div class="widget ltn__tagcloud-widget">
        <h4 class="ltn__widget-title ltn__widget-title-border">برچسب های محبوب</h4>
        <ul>
            @foreach (var item in Model ?? new List<ClientSideBlogTagViewModel>())
            {
                <li>
                    <a asp-area="" asp-controller="Blog" asp-action="BlogsList" asp-route-TagId="@item.Id">
                        @item.Title
                    </a>
                </li>
            }
        </ul>
    </div>
}