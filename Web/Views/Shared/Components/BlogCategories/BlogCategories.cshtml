@using Application.Dtos.BlogCategory.ClientSide
@model List<ClientSideBlogCategoryViewModel>

@if (Model?.Any() ?? false)
{
    <div class="widget ltn__menu-widget ltn__menu-widget-2 ltn__menu-widget-2-color-2">
        <h4 class="ltn__widget-title ltn__widget-title-border">دسته بندی ها</h4>
        <ul>
            @foreach (var item in Model ?? new List<ClientSideBlogCategoryViewModel>())
            {
                <li>
                    <a asp-area="" asp-controller="Blog" asp-action="BlogsList" asp-route-category="@item.Slug">
                        @item.Title
                        <span>@item.BlogsCount</span>
                    </a>
                </li>
            }
        </ul>
    </div>
}