@using Application.Dtos.BlogCategory.ClientSide
@model List<ClientSideBlogCategoryViewModel>

@if (Model?.Any() ?? false)
{
    <a asp-area="" asp-controller="Blog" asp-action="BlogsList" asp-route-category="" class="btn btn--ghost btn--sm">
        همه
    </a>

    @foreach (var item in Model ?? new List<ClientSideBlogCategoryViewModel>())
    {
        <a asp-area="" asp-controller="Blog" asp-action="BlogsList" asp-route-category="@item.Slug" class="btn btn--ghost btn--sm">
            @item.Title
        </a>
    }
}