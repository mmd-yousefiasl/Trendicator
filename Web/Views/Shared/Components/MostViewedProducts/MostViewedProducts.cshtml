@using Application.Tools
@using Application.ViewModels.Product.ClientSide
@model List<ClientSideProductViewModel>

@if (Model?.Any() ?? false)
{
    <div class="col-lg-4 col-md-6">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title-area ltn__section-title-2--- text-center---">
                    <h1 class="section-title-2 border-bottom">محبوب ترین ها</h1>
                </div>
            </div>
        </div>
        <div class="row ltn__small-product-slider-active slick-arrow-1  slick-arrow-1-inner---">
            <div class="col-12">
                @foreach (var item in Model ?? new List<ClientSideProductViewModel>())
                {
                    <div class="ltn__small-product-item">
                        <div class="small-product-item-img">
                            <a asp-area="" asp-controller="Product" asp-action="ProductDetails" asp-route-slug="@item.Slug">
                                <img src="@SiteTools.ProductBanner@item.BannerFileName" alt="@item.Title">
                            </a>
                        </div>
                        <div class="small-product-item-info">
                            <div class="product-ratting">
                                <ul>
                                    <partial name="_ProductReviewStars" model="@item.ReviewRate" />
                                </ul>
                            </div>
                            <h2 class="product-title fix-product-title">
                                <a asp-area="" asp-controller="Product" asp-action="ProductDetails" asp-route-slug="@item.Slug">@item.Title</a>
                            </h2>
                            <div class="product-price">
                                @if (item.IsAvailable)
                                {
                                    @if (item.HaveDiscount)
                                    {
                                        <span class="fs-large">@item.OrderPrice?.ToToman()</span>
                                        <del class="fs-small">@item.Price.ToTomanFormat()</del>
                                    }
                                    else
                                    {
                                        <span class="fs-large">@item.Price.ToToman()</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-danger">ناموجود</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}