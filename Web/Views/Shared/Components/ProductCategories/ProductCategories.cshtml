@using Application.ViewModels.ProductCategory.ClientSide
@model List<ClientSideProductCategoryViewModel>

@if (Model?.Any() ?? false)
{
    <!-- Category Widget -->
    <div class="widget ltn__menu-widget">
        <h4 class="ltn__widget-title ltn__widget-title-border">دسته بندی ها</h4>
        <ul>
            @foreach (var item in Model ?? new List<ClientSideProductCategoryViewModel>())
            {
                <li>
                    <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@item.Slug">
                        @item.Title
                    </a>
                </li>

                @foreach (var item2 in item.Categories ?? new List<ClientSideProductCategoryViewModel>())
                {
                    <li class="mr-20">
                        <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@item2.Slug">
                            @item2.Title
                        </a>
                    </li>

                    @foreach (var item3 in item2.Categories ?? new List<ClientSideProductCategoryViewModel>())
                    {
                        <li class="mr-40">
                            <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@item3.Slug">
                                @item3.Title
                            </a>
                        </li>
                    }
                }
            }
        </ul>
    </div>
}