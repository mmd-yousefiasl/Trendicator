@using Application.Dtos.ProductCategory.ClientSide
@model List<ClientSideProductCategoryViewModel>

@{
    // Current slug — works whether asp-route-category became a query string (?category=…)
    // or a real route segment.
    var currentCategory = ViewContext.RouteData.Values["category"]?.ToString();
    if (string.IsNullOrWhiteSpace(currentCategory))
        currentCategory = Context.Request.Query["category"].ToString();
    if (string.IsNullOrWhiteSpace(currentCategory))
        currentCategory = null;

    Func<ClientSideProductCategoryViewModel, bool> isActive = c =>
        string.Equals(c.Slug, currentCategory, StringComparison.OrdinalIgnoreCase);

    // Recursive: "does this node, or any descendant, match?"
    Func<ClientSideProductCategoryViewModel, bool> containsActive = null;
    containsActive = c =>
        isActive(c) || (c.Categories?.Any(containsActive) ?? false);
}

@if (Model?.Any() ?? false)
{
    <details class="card card-pad filter-group" open>
        <summary>دسته بندی</summary>
        <ul>
            <li>
                <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category=""
                   class="@(currentCategory is null ? "is-active" : null)">همه</a>
            </li>

            @foreach (var item in Model)
            {
                var active = isActive(item);
                var contains = containsActive(item);

                <li>
                    @if (item.Categories?.Any() ?? false)
                    {
                        <details class="filter-group @(contains ? "is-active" : null)"
                            @(contains ? "open" : null)>
                            <summary>
                                <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@item.Slug"
                                   class="@(active ? "is-active" : null)">@item.Title</a>
                            </summary>
                            <ul>
                                @foreach (var item2 in item.Categories)
                                {
                                    var active2 = isActive(item2);
                                    var contains2 = containsActive(item2);

                                    <li>
                                        @if (item2.Categories?.Any() ?? false)
                                        {
                                            <details class="filter-group @(contains2 ? "is-active" : null)"
                                                @(contains2 ? "open" : null)>
                                                <summary>
                                                    <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@item2.Slug"
                                                       class="@(active2 ? "is-active" : null)">@item2.Title</a>
                                                </summary>
                                                <ul>
                                                    @foreach (var item3 in item2.Categories)
                                                    {
                                                        <li>
                                                            <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@item3.Slug"
                                                               class="@(isActive(item3) ? "is-active" : null)">@item3.Title</a>
                                                        </li>
                                                    }
                                                </ul>
                                            </details>
                                        }
                                        else
                                        {
                                            <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@item2.Slug"
                                               class="@(active2 ? "is-active" : null)">@item2.Title</a>
                                        }
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="@item.Slug"
                           class="@(active ? "is-active" : null)">@item.Title</a>
                    }
                </li>
            }
        </ul>
    </details>
}