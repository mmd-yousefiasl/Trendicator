@using Application.Dtos.Blog.ClientSide
@model ClientSideFilterBlogsViewModel

@if (Model?.Entities?.Any() ?? false)
{
    <!-- ============ Related posts ============ -->
    <section class="section" style="padding-top:0">
        <div class="container" style="padding-inline:0">
            <div class="section-head">
                <span class="kicker">ادامه مطالعه</span>
                <h2 class="mt-1">مقالات مرتبط</h2>
            </div>
            <div class="grid grid--3">
                @foreach(var item in Model.Entities ?? new List<ClientSideBlogViewModel>())
                {
                    <partial name="_BlogCard" model="item" />
                }
            </div>
        </div>
    </section>
}