@model int

<input type="hidden" id="CartItemsCount" value="@Model" />

<a asp-area="" asp-controller="Cart" asp-action="Cart" class="icon-btn" aria-label="سبد خرید">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 3h2l2.6 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6" />
        <circle cx="10" cy="20" r="1.4" />
        <circle cx="18" cy="20" r="1.4" />
    </svg>
    <span class="icon-btn__count" data-cart-count-badge hidden="@(Model == 0)">@Model</span>
</a>