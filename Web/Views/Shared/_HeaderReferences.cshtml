<link rel="stylesheet" href="/assets/css/used-icons.min.css" media="print" onload="this.media='all'">

<!-- Inline critical CSS -->
<style>
    .hero {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        padding: 60px 20px;
        max-width: 1200px;
        margin: 0 auto;
        background: linear-gradient(135deg, #f0fff4, #e6f9e6); /* soft green background */
        margin-top: 50px;
        border-radius: 12px;
    }

    .hero-content {
        flex: 1 1 400px;
        max-width: 500px;
        padding: 20px;
    }

    .hero h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: 20px;
        color: #1b5e20; /* deep green */
    }

    .hero p {
        font-size: clamp(1rem, 2vw, 1.25rem);
        margin-bottom: 30px;
        color: #2e7d32; /* medium green */
    }

    .hero-btn {
        display: inline-block;
        padding: 12px 24px;
        background: linear-gradient(135deg, #43cea2, #185a9d); /* green-teal gradient */
        color: #fff;
        text-decoration: none;
        font-weight: bold;
        border-radius: 6px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
        transition: transform 0.2s ease, background 0.3s ease;
    }

        .hero-btn:hover {
            background: linear-gradient(135deg, #56ab2f, #a8e063); /* lighter green hover */
            transform: scale(1.05);
            color: black;
        }

    .hero-img {
        flex: 1 1 400px;
        max-width: 600px;
        width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }

</style>


<link rel="stylesheet" href="/css/website.min.css" asp-append-version="true" />