<link rel="stylesheet" href="/css/styles.min.css" asp-append-version="true" />

<!-- Inline critical CSS -->
<style>
    .hero {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        padding: 60px 20px;
        max-width: 1200px;
        margin: 0 auto;
        background-color: #f9f9f9;
        margin-top: 50px;
    }

    .hero-content {
        flex: 1 1 400px;
        max-width: 500px;
        padding: 20px;
    }

    .hero h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: 20px;
        color: #222;
    }

    .hero p {
        font-size: clamp(1rem, 2vw, 1.25rem);
        margin-bottom: 30px;
        color: #555;
    }

    .hero-btn {
        display: inline-block;
        padding: 12px 24px;
        background-color: #0077cc;
        color: #fff;
        text-decoration: none;
        font-weight: bold;
        border-radius: 4px;
        transition: background-color 0.3s ease;
    }

        .hero-btn:hover {
            background-color: #005fa3;
            color: #fff;
        }

    .hero-img {
        flex: 1 1 400px;
        max-width: 600px;
        width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: 8px;
    }
</style>


<link rel="stylesheet" href="/css/website.min.css" asp-append-version="true" />