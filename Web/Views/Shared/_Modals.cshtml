<!-- Custom Modal -->
<div class="modal fade" id="custom-modal" tabindex="-1"
     role="dialog" aria-labelledby="custom-modal-label" aria-modal="true">
    <div class="modal-dialog max-w-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="custom-modal-label"></h5>
            </div>

            <div class="modal-body p-6 text-center" id="custom-modal-body">
            </div>
        </div>
    </div>
</div>

<!-- Product Quick View Modal -->
<div class="modal fade" id="Product_Quick_View_Model" tabindex="-1"
     role="dialog" aria-modal="true" aria-labelledby="Product_Quick_View_Model_Label">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="Product_Quick_View_Model_Label"></h5>
            </div>
            <div class="modal-body" id="Product_Quick_View_Model_Body">
            </div>

        </div>
    </div>
</div>

<!-- Cart Menu (not a modal, so no aria-modal) -->
