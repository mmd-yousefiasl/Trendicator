@model int

@{
    ViewData["Title"] = "پرداخت موفق";
}

<div class="ltn__404-area ltn__404-area-1 mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="error-404-inner text-center">
                    <h1 class="error-404-title">
                        <img class="payment-result-img" src="/d-imgs/checked.webp" alt="پرداخت موفق" />
                    </h1>
                    <h2>@ViewData["Title"]</h2>
                    <p>
                        سفارش شما با شماره
                        <strong>@Model#</strong>
                        با موفقیت ثبت شد.
                    </p>
                    <div class="btn-wrapper">
                        <a asp-area="UserPanel" asp-controller="Cart" asp-action="MyOrders" class="btn btn-transparent">
                            مشاهده سفارش های من
                            <i class="fas fa-long-arrow-alt-left"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Component.InvokeAsync("OurFeatures")