@using Application.Dtos.Cart.ClientSide
@model ClientSideAddCouponToCartViewModel

<form asp-area="" asp-controller="Checkout" asp-action="AddCoupon" onsubmit="submitAnimation()" method="post">
    <div class="coupon-container">
        <input type="text" asp-for="Code" class="form-control" autocomplete="off">
        <button type="submit" class="btn btn-secondary btn-effect-2 coupon-button btn-submit">ثبت</button>
    </div>

    <span class="text-danger" asp-validation-for="Code"></span>
</form>