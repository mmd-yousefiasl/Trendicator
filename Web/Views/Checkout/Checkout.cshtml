@{
    ViewData["Title"] = "تسویه حساب";
}

<div class="ltn__breadcrumb-area ltn__breadcrumb-area-2 ltn__breadcrumb-color-white bg-overlay-theme-black-70 bg-image"
     data-bg="@SiteTools.BreadcrumbBanner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner ltn__breadcrumb-inner-2 justify-content-between">
                    <div class="section-title-area ltn__section-title-2">
                        <h1 class="section-title white-color">تسویه حساب</h1>
                    </div>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                            <li>تسویه حساب</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="ltn__checkout-area mb-105">
    <div class="container">
        <div class="row">
            @await Component.InvokeAsync("TradingViewAccountNameForm")

            @await Component.InvokeAsync("CheckoutOrderSummary")
            <div class="col-lg-6">
                <form asp-area="" asp-controller="Checkout" asp-action="Checkout" method="post" onsubmit="submitAnimation()" class="ltn__checkout-payment-method mt-50">
                    <h4 class="title-2">روش های پرداخت</h4>
                    <div id="checkout_accordion_1">
                        <!-- card -->
                        <div class="card">
                            <h5 class="ltn__card-title" data-toggle="collapse" aria-expanded="true">
                                آقای پرداخت
                            </h5>
                            <div id="payment-method-1" class="collapse show" data-parent="#checkout_accordion_1">
                                <div class="card-body">
                                    <p>پرداخت با درگاه پرداخت آقای پرداخت</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="ltn__payment-note mt-30 mb-30">
                        <p>
                            اطلاعات شخصی شما برای پردازش سفارش شما، پشتیبانی از تجربه شما در سراسر این وب‌سایت و سایر اهدافی که در
                            <a asp-area="" asp-controller="TermsAndConditions" asp-action="PrivacyPolicy">
                                <strong>
                                    سیاست حفظ حریم خصوصی
                                </strong>
                            </a>
                            ما شرح داده شده است، استفاده خواهد شد.
                        </p>

                        @await Component.InvokeAsync("UseUserWallet")

                    </div>
                    <button class="btn theme-btn-1 btn-effect-1 text-uppercase btn-submit m-0" type="submit">ثبت سفارش</button>
                </form>
            </div>
        </div>
    </div>
</div>