@{
    ViewData["Title"] = "پرداخت ناموفق";
}

<div class="ltn__404-area ltn__404-area-1 mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="error-404-inner text-center">
                    <h1 class="error-404-title">
                        <img class="payment-result-img" src="/d-imgs/remove.png" alt="پرداخت ناموفق" />
                    </h1>
                    <h2>@ViewData["Title"]</h2>
                    <p>در صورتی که مبلغ سفارش از حساب شما کسر شده اما سفارش ثبت نشده است، لطفاً ابتدا موجودی کیف پول خود را بررسی کنید. در صورت نیاز، می‌توانید از طریق ارسال تیکت با پشتیبانی در ارتباط باشید.</p>
                    <div class="btn-wrapper">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-transparent">
                            مشاهده تراکنش ها
                            <i class="fas fa-long-arrow-alt-left"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Component.InvokeAsync("OurFeatures")