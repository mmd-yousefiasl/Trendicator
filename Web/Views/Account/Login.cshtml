@using Application.ViewModels.User.ClientSide
@model ClientSideLoginDto

@{
    ViewData["Title"] = "ورود";
}

<main class="section">
    <div class="container">
        <div class="auth-wrap">
            <div class="card auth-card">
                <div class="auth-logo">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="logo" aria-label="@SiteTools.SiteName">
                        <img src="/assets/img/logo.svg" alt="@SiteTools.SiteName" width="34" height="34">
                        <span>ترند<b>یکاتور</b></span>
                    </a>
                </div>

                <h1 class="auth-title">ورود | ثبت نام</h1>
                <p class="auth-sub">
                    به ترندیکاتور خوش آمدید!
                    جایی که ابزارهای نوین تحلیل و معامله در اختیار شماست.
                    برای ورود به حساب کاربری خود، اطلاعاتتان را وارد کنید و از امکانات ویژه ما بهره‌مند شوید.
                </p>

                <form role="tabpanel" aria-labelledby="tab-otp" asp-area="" asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="field">
                        <label for="otp-phone">شماره موبایل</label>
                        <input class="input phone-input" asp-for="Mobile">
                        <span asp-validation-for="Mobile"></span>
                        <span class="hint">کد ۵ رقمی به این شماره پیامک می‌شود.</span>
                    </div>

                    <div class="field">
                        <label class="check">
                            <input type="checkbox" asp-for="PrivacyPolicy">
                            <span>
                                <a asp-area="" asp-controller="TermsAndConditions" asp-action="TermsAndConditions"
                                   target="_blank" class="text-brand">شرایط و ضوابط</a>
                                و
                                <a asp-area="" asp-controller="TermsAndConditions" asp-action="PrivacyPolicy"
                                   target="_blank" class="text-brand">سیاست حفظ حریم خصوصی</a>
                                ترندیکاتور را مطالعه کرده و می‌پذیرم.
                            </span>
                        </label>
                        <span asp-validation-for="PrivacyPolicy"></span>
                    </div>

                    <button type="submit" class="btn btn--primary btn--block btn--md mt-2">ارسال کد تایید</button>
                </form>
            </div>
        </div>
    </div>
</main>