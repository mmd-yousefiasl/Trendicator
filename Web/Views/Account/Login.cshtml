@using Application.ViewModels.User.ClientSide
@model ClientSideLoginViewModel
@inject IConfiguration configuration

@{
    ViewData["Title"] = "ورود";
    var siteKey = configuration["googleReCaptcha:SiteKey"];
}


<!-- LOGIN AREA START (Register) -->
<div class="ltn__login-area pb-110 mt-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title-area text-center">
                    <h1 class="section-title">
                        ورود
                        <br>
                        به حساب کاربری
                    </h1>
                    <p>
                        به ترندیکاتور خوش آمدید!
                        جایی که ابزارهای نوین تحلیل و معامله در اختیار شماست.
                        برای ورود به حساب کاربری خود، اطلاعاتتان را وارد کنید و از امکانات ویژه ما بهره‌مند شوید.
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6 offset-lg-3">
                <div class="account-login-inner">
                    <form id="account-form" asp-area="" asp-controller="Account" asp-action="Login" method="post" class="ltn__form-box contact-form-box" onsubmit="submitAnimation()">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <input type="hidden" asp-for="Captcha" id="recaptchaTokenInputId" />

                        <label asp-for="PhoneNumber"></label>
                        <input type="text" asp-for="PhoneNumber" dir="ltr" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>

                        <div id="html_element" class="col-12"></div>
                        <span asp-validation-for="Captcha" class="text-danger"></span>
                        <br />

                        <label class="checkbox-inline">
                            <input type="checkbox" asp-for="PrivacyPolicy">
                            با کلیک روی «ورود»، با
                            <a asp-area="" asp-controller="TermsAndConditions" asp-action="PrivacyPolicy" target="_blank">سیاست حفظ حریم خصوصی</a>
                            و
                            <a asp-area="" asp-controller="TermsAndConditions" asp-action="TermsAndConditions" target="_blank">شرایط و ضوابط</a>
                            موافقت می‌کنم.
                        </label>
                        <span asp-validation-for="PrivacyPolicy" class="text-danger"></span>
                        <br />

                        <div class="btn-wrapper">
                            <button class="theme-btn-1 btn reverse-color btn-block btn-submit" type="submit">ارسال کد تایید</button>
                        </div>
                    </form>
                    <div class="by-agree text-center">
                        <p>
                            با ورود به حساب کاربری، شما با قوانین ما موافقت می‌کنید
                            :
                        </p>
                        <p>
                            <a asp-area="" asp-controller="TermsAndConditions" asp-action="TermsAndConditions" target="_blank">شرایط و ضوابط</a>
                            &nbsp; &nbsp; | &nbsp; &nbsp;
                            <a asp-area="" asp-controller="TermsAndConditions" asp-action="PrivacyPolicy" target="_blank">سیاست حفظ حریم خصوصی</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section FooterReferences {
    <script asp-append-version="true" src="/js/disableEnter.js"></script>
    <script type="text/javascript">
        var onloadCallback = function() {
            grecaptcha.render('html_element', {
                'sitekey': '@siteKey'
            });
        };

        document.getElementById("account-form").addEventListener("submit", function(e) {
            var token = grecaptcha.getResponse();
            document.getElementById("recaptchaTokenInputId").value = token;
        });
    </script>

    <script src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit"
            async defer>
    </script>
}