@using Application.ViewModels.User.ClientSide
@model ClientSideLoginCodeViewModel

@{
    ViewData["Title"] = "ورود";
}

<div class="ltn__login-area pb-110 mt-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title-area text-center">
                    <h1 class="section-title">
                        ورود
                        <br>
                        به حساب کاربری
                    </h1>
                    <p>
                        به ترندیکاتور خوش آمدید!
                        جایی که ابزارهای نوین تحلیل و معامله در اختیار شماست.
                        برای ورود به حساب کاربری خود، اطلاعاتتان را وارد کنید و از امکانات ویژه ما بهره‌مند شوید.
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6 offset-lg-3">
                <div class="account-login-inner">
                    <form asp-area="" asp-controller="Account" asp-action="VerifyLoginCode" method="post" class="ltn__form-box contact-form-box" onsubmit="submitAnimation()" autocomplete="off">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <input asp-for="PhoneNumber" type="hidden" />

                        <span class="mb-6 text-lg leading-normal dark:text-jacarta-300">
                            کد تایید به شماره
                            <span class="text-success text-sm">
                                @Model.PhoneNumber
                            </span>
                            ارسال شد
                            <br />
                            <span class="text-warning text-sm text-underline">
                                <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-PhoneNumber="@Model.PhoneNumber">ویرایش شماره موبایل</a>
                            </span>
                        </span>

                        <label asp-for="LoginCode"></label>
                        <input type="text" asp-for="LoginCode" class="text-center login-code" />
                        <span asp-validation-for="LoginCode" class="text-danger"></span>
                        <div class="btn-wrapper">
                            <button class="theme-btn-1 btn reverse-color btn-block btn-submit" type="submit">ورود</button>
                        </div>
                    </form>
                    <div class="by-agree text-center">
                        <p>
                            با ورود به حساب کاربری، شما با قوانین ما موافقت می‌کنید
                            :
                        </p>
                        <p>
                            <a asp-area="" asp-controller="TermsAndConditions" asp-action="TermsAndConditions" target="_blank">شرایط و ضوابط</a>
                            &nbsp; &nbsp; | &nbsp; &nbsp;
                            <a asp-area="" asp-controller="TermsAndConditions" asp-action="PrivacyPolicy" target="_blank">سیاست حفظ حریم خصوصی</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section FooterReferences {
    <script asp-append-version="true" src="/js/disableEnter.js"></script>
}