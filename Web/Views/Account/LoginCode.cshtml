@using Application.Tools
@using Application.Dtos.User.ClientSide
@model ClientSideLoginCodeDto

@{
    ViewData["Title"] = "ورود";

    int remainingSeconds = Model.CreatedDate.GetRemainingCooldownSeconds(cooldownSeconds: 120);
}

<main class="section">
    <div class="container">
        <div class="auth-wrap">
            <div class="card auth-card">
                <div class="auth-logo">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="logo" aria-label="@SiteTools.SiteName">
                        <img src="/assets/img/logo.svg" alt="@SiteTools.SiteName" width="34" height="34">
                        <span>ترند<b>یکاتور</b></span>
                    </a>
                </div>

                <h1 class="auth-title">کد تایید را وارد کنید</h1>
                <p class="auth-sub">
                    کد ۵ رقمی به شماره <b class="num">@Model.Mobile</b> پیامک شد.
                    <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-Mobile="@Model.Mobile" class="text-brand">تغییر شماره</a>
                </p>

                <form asp-area="" asp-controller="Account" asp-action="VerifyLoginCode" method="post" autocomplete="off">
                    <input type="hidden" asp-for="Mobile" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <div class="field">
                        <div class="otp" data-otp aria-label="کد تایید ۵ رقمی">
                            <input type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="رقم اول" name="LoginCode[0]" autofocus>
                            <input type="text" inputmode="numeric" maxlength="1" aria-label="رقم دوم" name="LoginCode[1]">
                            <input type="text" inputmode="numeric" maxlength="1" aria-label="رقم سوم" name="LoginCode[2]">
                            <input type="text" inputmode="numeric" maxlength="1" aria-label="رقم چهارم" name="LoginCode[3]">
                            <input type="text" inputmode="numeric" maxlength="1" aria-label="رقم پنجم" name="LoginCode[4]">
                        </div>
                        <span asp-validation-for="LoginCode"></span>
                    </div>

                    <div>
                        <div class="otp-timer @(remainingSeconds < 1 ? "hidden" : "")" data-countdown="@remainingSeconds">
                            <span>ارسال مجدد کد تا </span><b data-countdown-time></b>
                        </div>
                        <a asp-area="" asp-controller="Account" asp-action="ResendCode" asp-route-ReturnUrl="@Model.ReturnUrl" asp-route-Mobile="@Model.Mobile"
                           class="otp-resend @(remainingSeconds < 1 ? "" : "hidden")" data-resend>ارسال مجدد کد</a>
                    </div>

                    <button type="submit" class="btn btn--primary btn--block btn--lg mt-3">تایید و ورود</button>
                </form>
            </div>
        </div>
    </div>
</main>

@section FooterReferences {
    <script src="/js/login.js" asp-append-version="true"></script>
}