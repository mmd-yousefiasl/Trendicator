@{
    ViewData["Title"] = "صفحه اصلی";
}

@await Component.InvokeAsync("Hero")

<!-- BANNER AREA START -->
<div class="ltn__banner-area mt-120">
    <div class="container">
        <div class="row ltn__custom-gutter--- justify-content-center">
            @await Component.InvokeAsync("RightBanner")
            @await Component.InvokeAsync("LeftBanner")
        </div>
    </div>
</div>

@await Component.InvokeAsync("LatestProducts")

@await Component.InvokeAsync("Testimonial")

<div class="ltn__small-product-list-area pt-80 pb-85">
    <div class="container">
        <div class="row justify-content-center">
            @await Component.InvokeAsync("MainPageDiscountedProducts")
            @await Component.InvokeAsync("MostViewedProducts")
            @await Component.InvokeAsync("MostPurchasedProducts")
        </div>
    </div>
</div>

@await Component.InvokeAsync("LatestBlogs")

@await Component.InvokeAsync("OurFeatures")