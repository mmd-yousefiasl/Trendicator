@using System.Text.Json
@using Application.Services.Interfaces
@inject IFaqService _faqService;

@{
    ViewData["Title"] = "صفحه اصلی";

    var faqResult = await _faqService.ClientSideGetFaqsForMainPage(5);
}

<main>
    <!-- ============ Hero ============ -->
    <section class="hero">
        <div class="container hero__grid">
            <div>
                <h1>معامله با <em>اندیکاتورهای حرفه‌ای</em>، بدون حدس و گمان</h1>
                <p class="hero__lead">
                    اندیکاتورها و اکسپرت‌های اختصاصی ترندیکاتور برای متاتریدر ۴ و ۵ و تریدینگ‌ویو،
                    با سیگنال‌های دقیق ورود و خروج — ساخته‌شده توسط معامگران، تست‌شده روی دیتای واقعی.
                </p>
                <div class="hero__cta">
                    <a href="products.html" class="btn btn--primary btn--lg">مشاهده فروشگاه</a>
                    <a href="guide.html" class="btn btn--ghost btn--lg">اندیکاتور چیست؟</a>
                </div>
            </div>

            <div class="hero__panel">
                <div class="hero__glow" aria-hidden="true"></div>
                <div class="card" style="overflow:hidden">

                    <svg viewBox="0 0 520 340" xmlns="http://www.w3.org/2000/svg"
                         role="presentation" aria-hidden="true" focusable="false"
                         style="display:block;width:100%;height:auto">
                        <defs>
                            <linearGradient id="hArea" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="var(--brand,#10b981)" stop-opacity=".28" />
                                <stop offset="100%" stop-color="var(--brand,#10b981)" stop-opacity="0" />
                            </linearGradient>
                            <linearGradient id="hLine" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="var(--brand,#10b981)" stop-opacity=".15" />
                                <stop offset="100%" stop-color="var(--brand,#10b981)" />
                            </linearGradient>
                            <radialGradient id="hGlow" cx="50%" cy="50%" r="50%">
                                <stop offset="0%" stop-color="var(--brand,#10b981)" stop-opacity=".45" />
                                <stop offset="55%" stop-color="var(--brand,#10b981)" stop-opacity=".10" />
                                <stop offset="100%" stop-color="var(--brand,#10b981)" stop-opacity="0" />
                            </radialGradient>
                            <linearGradient id="hBotBody" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="var(--panel-2,#182230)" />
                                <stop offset="100%" stop-color="var(--bg-soft,#10161d)" />
                            </linearGradient>
                        </defs>

                        <!-- background grid -->
                        <g stroke="var(--line-soft,#1a2532)" stroke-width="1" stroke-dasharray="2 7" opacity=".7">
                            <line x1="20" y1="100" x2="500" y2="100" />
                            <line x1="20" y1="160" x2="500" y2="160" />
                            <line x1="20" y1="220" x2="500" y2="220" />
                            <line x1="20" y1="280" x2="500" y2="280" />
                        </g>

                        <!-- area under trend -->
                        <path d="M30 268 C 90 258 140 236 200 214 C 260 192 320 172 380 156
                        C 420 146 460 138 490 132 L490 300 L30 300 Z"
                              fill="url(#hArea)" />

                        <!-- candles · up -->
                        <g fill="var(--brand,#10b981)" stroke="var(--brand,#10b981)" stroke-width="2" stroke-linecap="round">
                            <line x1="40" y1="246" x2="40" y2="282" />
                            <rect x="34" y="254" width="12" height="20" rx="2" stroke="none" />
                            <line x1="120" y1="228" x2="120" y2="264" />
                            <rect x="114" y="236" width="12" height="20" rx="2" stroke="none" />
                            <line x1="160" y1="216" x2="160" y2="252" />
                            <rect x="154" y="224" width="12" height="20" rx="2" stroke="none" />
                            <line x1="240" y1="186" x2="240" y2="222" />
                            <rect x="234" y="194" width="12" height="20" rx="2" stroke="none" />
                            <line x1="280" y1="174" x2="280" y2="210" />
                            <rect x="274" y="182" width="12" height="20" rx="2" stroke="none" />
                            <line x1="360" y1="150" x2="360" y2="186" />
                            <rect x="354" y="158" width="12" height="20" rx="2" stroke="none" />
                            <line x1="400" y1="139" x2="400" y2="175" />
                            <rect x="394" y="147" width="12" height="20" rx="2" stroke="none" />
                            <line x1="440" y1="130" x2="440" y2="166" />
                            <rect x="434" y="138" width="12" height="20" rx="2" stroke="none" />
                            <line x1="480" y1="120" x2="480" y2="156" />
                            <rect x="474" y="128" width="12" height="20" rx="2" stroke="none" />
                        </g>

                        <!-- candles · down -->
                        <g fill="var(--down,#f43f5e)" stroke="var(--down,#f43f5e)" stroke-width="2" stroke-linecap="round">
                            <line x1="80" y1="244" x2="80" y2="272" />
                            <rect x="74" y="252" width="12" height="14" rx="2" stroke="none" />
                            <line x1="200" y1="204" x2="200" y2="236" />
                            <rect x="194" y="212" width="12" height="16" rx="2" stroke="none" />
                            <line x1="320" y1="166" x2="320" y2="198" />
                            <rect x="314" y="174" width="12" height="16" rx="2" stroke="none" />
                        </g>

                        <!-- trend line -->
                        <path d="M30 268 C 90 258 140 236 200 214 C 260 192 320 172 380 156
                        C 420 146 460 138 490 132"
                              fill="none" stroke="url(#hLine)" stroke-width="2.5" stroke-linecap="round" />

                        <!-- robot glow -->
                        <circle cx="260" cy="100" r="115" fill="url(#hGlow)" />

                        <!-- robot -->
                        <g>
                            <!-- antenna -->
                            <line x1="260" y1="58" x2="260" y2="30"
                                  stroke="var(--brand,#10b981)" stroke-width="3" stroke-linecap="round" />
                            <circle cx="260" cy="26" r="8" fill="var(--brand,#10b981)" opacity=".22" />
                            <circle cx="260" cy="26" r="4.5" fill="var(--brand,#10b981)" />

                            <!-- side pods -->
                            <rect x="184" y="86" width="14" height="38" rx="7"
                                  fill="var(--panel-2,#182230)" stroke="var(--line,#223041)" />
                            <rect x="322" y="86" width="14" height="38" rx="7"
                                  fill="var(--panel-2,#182230)" stroke="var(--line,#223041)" />

                            <!-- head -->
                            <rect x="198" y="58" width="124" height="94" rx="26"
                                  fill="url(#hBotBody)" stroke="var(--line,#223041)" />

                            <!-- top highlight -->
                            <path d="M222 63 Q 260 55 298 63" fill="none"
                                  stroke="var(--brand,#10b981)" stroke-opacity=".35"
                                  stroke-width="2" stroke-linecap="round" />

                            <!-- eyes -->
                            <rect x="226" y="86" width="18" height="24" rx="9" fill="var(--brand,#10b981)" />
                            <rect x="276" y="86" width="18" height="24" rx="9" fill="var(--brand,#10b981)" />
                            <rect x="230" y="90" width="6" height="8" rx="3" fill="#fff" opacity=".55" />
                            <rect x="280" y="90" width="6" height="8" rx="3" fill="#fff" opacity=".55" />

                            <!-- mouth -->
                            <rect x="244" y="122" width="32" height="6" rx="3"
                                  fill="var(--brand,#10b981)" opacity=".35" />
                        </g>
                    </svg>

                </div>
            </div>
        </div>
    </section>

    <!-- ============ Featured products ============ -->
    <section class="section">
        <div class="container">
            <div class="flex flex--between flex--wrap mb-3">
                <div class="section-head" style="margin-bottom:0">
                    <span class="kicker">پرفروش‌ترین‌ها</span>
                    <h2 class="mt-1">اندیکاتورهای منتخب</h2>
                </div>
                <a href="products.html" class="btn btn--ghost btn--sm">مشاهده همه ←</a>
            </div>

            <div class="grid grid--4 grid--posts" tabindex="0" role="region" aria-label="محصولات منتخب">
                <!-- Product card -->
                <article class="product-card" data-product data-product-id="p1" data-product-name="ترند اسکالپر پرو">
                    <div class="product-card__media">
                        <div class="product-card__tags"><span class="badge badge--brand">پرفروش</span></div>
                        <img src="assets/img/products/p1-dark.webp" data-src-light="assets/img/products/p1-light.webp" width="800"
                             height="450" loading="lazy" data-src-dark="assets/img/products/p1-dark.webp" decoding="async" alt="">
                    </div>
                    <div class="product-card__body">
                        <h3 class="product-card__title"><a href="product.html">ترند اسکالپر پرو</a></h3>
                        <div class="product-card__meta"><span>MT4 / MT5</span><span>· اسکالپ</span><span>· ۴٫۹ ★</span></div>
                        <p class="text-muted" style="font-size:.85rem;margin:0">
                            سیگنال‌گیری لحظه‌ای برای اسکالپ با فیلتر جریان
                            سفارشات.
                        </p>
                        <div class="product-card__foot">
                            <div class="price"><small>تومان</small> ۲٬۴۸۰٬۰۰۰</div>
                            <button class="btn btn--soft btn--sm" data-add-to-cart data-id="p1" data-name="ترند اسکالپر پرو"
                                    data-price="2480000">
                                افزودن
                            </button>
                        </div>
                    </div>
                </article>

                <article class="product-card" data-product data-product-id="p2" data-product-name="سوپر ترند دارچین">
                    <div class="product-card__media">
                        <div class="product-card__tags"><span class="badge">جدید</span></div>
                        <img src="assets/img/products/p2-dark.webp" data-src-light="assets/img/products/p2-light.webp" width="800"
                             height="450" loading="lazy" data-src-dark="assets/img/products/p2-dark.webp" decoding="async" alt="">
                    </div>
                    <div class="product-card__body">
                        <h3 class="product-card__title"><a href="product.html">سوپر ترند دارچین</a></h3>
                        <div class="product-card__meta"><span>TradingView</span><span>· سوئینگ</span><span>· ۴٫۸ ★</span></div>
                        <p class="text-muted" style="font-size:.85rem;margin:0">تشخیص جهت روند با پاین‌های رنگی و آلارم تلگرام.</p>
                        <div class="product-card__foot">
                            <div class="price"><small>تومان</small> ۱٬۸۹۰٬۰۰۰</div>
                            <button class="btn btn--soft btn--sm" data-add-to-cart data-id="p2" data-name="سوپر ترند دارچین"
                                    data-price="1890000">
                                افزودن
                            </button>
                        </div>
                    </div>
                </article>

                <article class="product-card" data-product data-product-id="p3" data-product-name="اسمارت مانی فلو">
                    <div class="product-card__media">
                        <div class="product-card__tags"><span class="badge badge--up">٪۱۵ تخفیف</span></div>
                        <img src="assets/img/products/p3-dark.webp" data-src-light="assets/img/products/p3-light.webp" width="800"
                             height="450" loading="lazy" data-src-dark="assets/img/products/p3-dark.webp" decoding="async" alt="">
                    </div>
                    <div class="product-card__body">
                        <h3 class="product-card__title"><a href="product.html">اسمارت مانی فلو</a></h3>
                        <div class="product-card__meta"><span>MT5</span><span>· پرایس اکشن</span><span>· ۴٫۹ ★</span></div>
                        <p class="text-muted" style="font-size:.85rem;margin:0">شناسایی نواحی خرید و فروش پول هوشمند روی چارت.</p>
                        <div class="product-card__foot">
                            <div class="price">
                                <del>۲٬۹۰۰٬۰۰۰</del>
                                <small>تومان</small> ۲٬۴۶۰٬۰۰۰
                            </div>
                            <button class="btn btn--soft btn--sm" data-add-to-cart data-id="p3" data-name="اسمارت مانی فلو"
                                    data-price="2460000">
                                افزودن
                            </button>
                        </div>
                    </div>
                </article>

                <article class="product-card" data-product data-product-id="p4" data-product-name="ایکسپرت گاردین">
                    <div class="product-card__media">
                        <img src="assets/img/products/p4-dark.webp" data-src-light="assets/img/products/p4-light.webp" width="800"
                             height="450" loading="lazy" data-src-dark="assets/img/products/p4-dark.webp" decoding="async" alt="">
                    </div>
                    <div class="product-card__body">
                        <h3 class="product-card__title"><a href="product.html">ایکسپرت گاردین</a></h3>
                        <div class="product-card__meta">
                            <span>MT4 / MT5</span><span>· ربات معامله‌گر</span><span>· ۴٫۷ ★</span>
                        </div>
                        <p class="text-muted" style="font-size:.85rem;margin:0">
                            مدیریت خودکار معاملات با حد ضرر متحرک و پوزیشن
                            سایزینگ.
                        </p>
                        <div class="product-card__foot">
                            <div class="price"><small>تومان</small> ۴٬۹۰۰٬۰۰۰</div>
                            <button class="btn btn--soft btn--sm" data-add-to-cart data-id="p4" data-name="ایکسپرت گاردین"
                                    data-price="4900000">
                                افزودن
                            </button>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- ============ How it works ============ -->
    <section class="section section--soft">
        <div class="container">
            <div class="section-head section-head--center">
                <span class="kicker">شروع آسان</span>
                <h2 class="mt-1">در ۳ قدم معامله خودکار خود را بسازید</h2>
            </div>
            <div class="grid grid--3 steps">
                <div class="step">
                    <h3>انتخاب اندیکاتور</h3>
                    <p class="text-muted">
                        از فروشگاه، اندیکاتور متناسب با سبک معاملاتی‌تان (اسکالپ، سوئینگ یا روزانه) را انتخاب
                        کنید.
                    </p>
                </div>
                <div class="step">
                    <h3>پرداخت و دانلود</h3>
                    <p class="text-muted">پرداخت امن از طریق درگاه بانکی و دانلود فوری فایل‌ها همراه با آموزش نصب تصویری.</p>
                </div>
                <div class="step">
                    <h3>نصب و معامله</h3>
                    <p class="text-muted">چند دقیقه‌ای روی متاتریدر یا تریدینگ‌ویو نصب کنید و سیگنال‌ها را دریافت کنید.</p>
                </div>
            </div>
        </div>
    </section>

    @await Component.InvokeAsync("LatestBlogs")

    @if (faqResult.IsSuccess)
    {
        var jsonOptions = new JsonSerializerOptions
        {
            WriteIndented = true,
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        };

        var faqSchema = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = faqResult.Value.Select(item => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = item.Question ?? string.Empty,
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = item.Answer ?? string.Empty
                }
            }).ToList()
        };

        var schemaJson = JsonSerializer.Serialize(faqSchema, jsonOptions);

        @section FooterReferences {
            <script type="application/ld+json">
                    @Html.Raw(schemaJson)
            </script>
        }
        <partial name="_MainPageFaqs" model="faqResult.Value" />
    }

    <!-- ============ CTA ============ -->
    <section class="section">
        <div class="container">
            <div class="card card-pad text-center"
                 style="background:linear-gradient(135deg, var(--brand-soft), transparent 60%); border-color:var(--brand-line); padding-block:48px">
                <h2>آماده‌اید معامله حرفه‌ای‌تر را شروع کنید؟</h2>
                <p class="text-muted" style="max-width:48ch;margin-inline:auto">
                    همین حالا اولین اندیکاتور خود را انتخاب کنید یا
                    با اشتراک حرفه‌ای به همه محصولات دسترسی داشته باشید.
                </p>
                <div class="flex flex--center flex--wrap mt-3">
                    <a href="products.html" class="btn btn--primary btn--lg">ورود به فروشگاه</a>
                    <a asp-area="" asp-controller="ContactUs" asp-action="ContactUs" class="btn btn--ghost btn--lg">مشاوره رایگان</a>
                </div>
            </div>
        </div>
    </section>
</main>