@{
    ViewData["Title"] = "404";
}

<!-- 404 area start -->
<div class="ltn__404-area ltn__404-area-1 mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="error-404-inner text-center">
                    <h1 class="error-404-title">404</h1>
                    <h2>صفحه پیدا نشد!</h2>
                    <!-- <h3>Oops! Looks like something going rong</h3> -->
                    <p>صفحه‌ای که به دنبالش هستید وجود ندارد. ممکن است منتقل یا حذف شده باشد.</p>
                    <div class="btn-wrapper">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-transparent">
                            بازگشت به صفحه اصلی
                            <i class="fas fa-long-arrow-alt-left"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- 404 area end -->