@using Application.Dtos.Cart.ClientSide
@model List<ClientSideCartViewModel>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf

@{
    ViewData["Title"] = "سبد خرید";
    var csrfToken = Xsrf.GetAndStoreTokens(Context).RequestToken;
}

@section HeaderReferences {
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
}

<main class="container">
    <ul class="crumbs">
        <li><a href="index.html">خانه</a></li>
        <li>سبد خرید</li>
    </ul>

    <h1>سبد خرید</h1>

    <div class="checkout-layout mt-3">
        <!-- ============ Lines ============ -->
        <div class="card card-pad" data-cart-render>
            <div data-cart-list>

                <div class="cart-line" data-line="price-action-pro">
                    <a class="cart-line__thumb" href="product.html" aria-label="اندیکاتور پرایس اکشن پرو">
                        <svg viewBox="0 0 60 36">
                            <rect x="8" y="12" width="6" height="14" fill="var(--up)" />
                            <rect x="20" y="8" width="6" height="18" fill="var(--down)" />
                            <rect x="32" y="14" width="6" height="10" fill="var(--up)" />
                            <rect x="44" y="6" width="6" height="16" fill="var(--up)" />
                        </svg>
                    </a>
                    <div class="cart-line__body">
                        <a class="cart-line__title" href="product.html">اندیکاتور پرایس اکشن پرو</a>
                        <div class="cart-line__meta">لایسنس دائمی · دانلود فوری</div>
                    </div>
                    <div class="price num">
                        <del>۲,۴۵۰,۰۰۰</del>
                        <small>تومان</small> ۲,۴۵۰,۰۰۰
                    </div>
                    <button type="button" class="btn btn--danger btn--sm" data-remove="price-action-pro">حذف</button>
                </div>

                <div class="cart-line" data-line="liquidity-map">
                    <a class="cart-line__thumb" href="product.html" aria-label="اندیکاتور لیکوییدیتی مپ">
                        <svg viewBox="0 0 60 36">
                            <rect x="8" y="12" width="6" height="14" fill="var(--up)" />
                            <rect x="20" y="8" width="6" height="18" fill="var(--down)" />
                            <rect x="32" y="14" width="6" height="10" fill="var(--up)" />
                            <rect x="44" y="6" width="6" height="16" fill="var(--up)" />
                        </svg>
                    </a>
                    <div class="cart-line__body">
                        <a class="cart-line__title" href="product.html">اندیکاتور لیکوییدیتی مپ</a>
                        <div class="cart-line__meta">لایسنس دائمی · دانلود فوری</div>
                    </div>
                    <div class="price num">
                        <small>تومان</small> ۱,۸۹۰,۰۰۰
                    </div>
                    <button type="button" class="btn btn--danger btn--sm" data-remove="liquidity-map">حذف</button>
                </div>

                <div class="cart-line" data-line="harmonic-plus">
                    <a class="cart-line__thumb" href="product.html" aria-label="الگوی هارمونیک پلاس">
                        <svg viewBox="0 0 60 36">
                            <rect x="8" y="12" width="6" height="14" fill="var(--up)" />
                            <rect x="20" y="8" width="6" height="18" fill="var(--down)" />
                            <rect x="32" y="14" width="6" height="10" fill="var(--up)" />
                            <rect x="44" y="6" width="6" height="16" fill="var(--up)" />
                        </svg>
                    </a>
                    <div class="cart-line__body">
                        <a class="cart-line__title" href="product.html">الگوی هارمونیک پلاس</a>
                        <div class="cart-line__meta">لایسنس دائمی · دانلود فوری</div>
                    </div>
                    <div class="price num">
                        <small>تومان</small> ۹۵۰,۰۰۰
                    </div>
                    <button type="button" class="btn btn--danger btn--sm" data-remove="harmonic-plus">حذف</button>
                </div>

            </div>

            <!-- Empty state -->
            <div data-cart-empty hidden class="text-center" style="padding:48px 0">
                <div>
                    <svg class="ic" aria-hidden="true" style="width:3rem;height:3rem">
                        <use href="#i-cart" />
                    </svg>
                </div>
                <h2 style="font-size:1.15rem">سبد خرید شما خالی است</h2>
                <p class="text-muted">از فروشگاه، اندیکاتور مناسب معاملات‌تان را انتخاب کنید.</p>
                <a href="products.html" class="btn btn--primary">رفتن به فروشگاه</a>
            </div>
        </div>

        <!-- ============ Summary ============ -->
        <aside class="order-summary card card-pad"
               data-apply-url="@Url.Action("ApplyCoupon", "Cart")"
               data-remove-url="@Url.Action("RemoveCoupon", "Cart")"
               data-csrf-token="@csrfToken">
            <h3>خلاصه سفارش</h3>

            <div class="flex flex--between" style="font-size:.9rem;color:var(--text-2)">
                <span>محصولات</span>
                <span><span data-cart-count>۳</span> مورد</span>
            </div>

            <div class="flex flex--between mt-1" style="font-size:.9rem;color:var(--text-2)">
                <span>جمع محصولات</span>
                <span class="num"><span data-cart-subtotal>۵,۲۹۰,۰۰۰</span> تومان</span>
            </div>

            <div class="flex flex--between mt-1" style="font-size:.9rem;color:var(--text-2)" data-cart-discount-row hidden>
                <span>تخفیف</span>
                <span class="num text-brand">− <span data-cart-discount>۰</span> تومان</span>
            </div>

            <div class="coupon mt-1" data-coupon>

                <!-- ── Idle row + expandable input ─────────────────────── -->
                <div data-coupon-idle>
                    <div class="coupon__row">
                        <span>کد تخفیف</span>
                        <a href="#" class="coupon__toggle" data-open-coupon>افزودن کد</a>
                    </div>

                    <div class="coupon__expand" data-coupon-form>
                        <div class="coupon__expand-inner">
                            <div class="coupon__input-row">
                                <input class="input coupon__input"
                                       type="text"
                                       placeholder="WELCOME20"
                                       autocomplete="off"
                                       dir="ltr"
                                       data-coupon-input />
                                <button class="btn btn--primary btn--sm" type="button" data-coupon-apply>اعمال</button>
                            </div>

                            <div class="coupon__error" data-coupon-error hidden>
                                <svg viewBox="0 0 16 16" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="8" cy="8" r="6.5" />
                                    <path d="M8 4.5v4M8 11.2v.1" />
                                </svg>
                                <span data-coupon-error-text></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── Applied (success) ──────────────────────────────── -->
                <div class="coupon-applied" data-coupon-applied hidden aria-live="polite">
                    <div class="coupon-applied__chip">
                        <div class="coupon-applied__percent">۲۰٪</div>
                        <div class="coupon-applied__body">
                            <b>کد تخفیف اعمال شد</b>
                            <span class="coupon-applied__code">
                                <svg viewBox="0 0 16 16" width="12" height="12"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 8.5l3.2 3.2L13 5" />
                                </svg>
                                WELCOME20
                            </span>
                        </div>
                        <button type="button" class="coupon-applied__remove" aria-label="حذف کد تخفیف">
                            <svg viewBox="0 0 16 16" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                                <path d="M3 3l10 10M13 3L3 13" />
                            </svg>
                        </button>
                    </div>
                </div>

            </div>

            <hr style="border:none;border-top:1px dashed var(--line);margin:10px 0">

            <div class="flex flex--between" style="font-weight:800">
                <span>مبلغ قابل پرداخت</span>
                <span class="price">
                    <small>تومان</small>
                    <span data-cart-total>۵,۲۹۰,۰۰۰</span>
                </span>
            </div>

            <a href="checkout.html" class="btn btn--primary btn--block btn--lg mt-3" data-cart-pay>ادامه و پرداخت</a>

            <p class="hint mt-2 mb-0 text-center">
                <svg class="ic" aria-hidden="true"><use href="#i-shield-lock" /></svg>
                اتصال SSL · درگاه رسمی شتاب
            </p>
        </aside>
    </div>
</main>

@section FooterReferences {
    <script asp-append-version="true" src="/js/cart.js"></script>
}