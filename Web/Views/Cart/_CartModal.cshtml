@using Application.Dtos.Cart.ClientSide
@using Application.Tools
@model List<ClientSideCartDto>

<div class="ltn__utilize-menu-head">
    <span class="ltn__utilize-menu-title">سبد خرید</span>
</div>
@if (Model?.Any() ?? false)
{
    <div class="mini-cart-product-area ltn__scrollbar">
        @foreach (var item in Model ?? new List<ClientSideCartDto>())
        {
            <div class="mini-cart-item clearfix">
                <div class="mini-cart-img">
                    <a asp-area="" asp-controller="Product" asp-action="ProductDetails" asp-route-id="@item.Id" asp-route-slug="@item.Slug">
                        <img src="@SiteTools.ProductBanner@item.FileName" alt="@item.Title">
                    </a>

                    <span class="mini-cart-item-delete" onclick="RemoveItemFromCart('@item.Id')"><i class="icon-cancel"></i></span>
                </div>
                <div class="mini-cart-info">
                    <h6>
                        <a asp-area="" asp-controller="Product" asp-action="ProductDetails" asp-route-id="@item.Id" asp-route-slug="@item.Slug">
                            @item.Title
                            (@item.Hint)
                        </a>
                    </h6>
                    <span class="mini-cart-quantity">
                        @if (item.IsAvailable)
                        {
                            @if (item.OrderPrice > 0)
                            {
                                <span>@item.OrderPrice.ToToman()</span>
                                <del>@item.DisplayPrice.ToTomanFormat()</del>
                            }
                            else
                            {
                                <span>@item.OrderPrice.ToToman()</span>
                            }
                        }
                        else
                        {
                            <span class="text-danger">ناموجود</span>
                        }
                    </span>
                </div>
            </div>
        }
    </div>
    <div class="mini-cart-footer">
        <div class="mini-cart-sub-total">
            <h5>
                مجموع:
                <span>
                    @Model.Where(n => n.IsAvailable).Select(n => n.OrderPrice).Sum().ToToman()
                </span>
            </h5>
        </div>
        <div class="btn-wrapper">
            <a asp-area="" asp-controller="Cart" asp-action="Cart" class="theme-btn-1 btn btn-effect-1">سبد خرید</a>
            <a asp-area="" asp-controller="Checkout" asp-action="Checkout" class="theme-btn-2 btn btn-effect-2">تسویه حساب</a>
        </div>
    </div>
}
else
{
    <partial name="_NotFoundPartial" />
}