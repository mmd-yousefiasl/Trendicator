@using Application.Dtos.User.AdminSide
@using Application.Tools
@model AdminSideUpdateUserProfileDto

@{
    ViewData["Title"] = "ویرایش پروفایل";
}

<main class="container">
    <ul class="crumbs">
        <partial name="_IndexLink" />
        <partial name="_UserPanelHomeLink" />
        <li>پنل کاربری</li>
    </ul>

    <partial name="_UserPanelWelcome" />

    <div class="account mt-3">

        <partial name="_UserPanelVerticalMenu" />

        <!-- ============ Content ============ -->
        <div class="account__body">

            <!-- Personal info -->
            <section class="card card-pad">
                <h2 style="font-size:1.1rem">اطلاعات شخصی</h2>
                <form asp-area="UserPanel" asp-controller="UserProfile" asp-action="UpdateUserProfile" method="post">
                    <input type="hidden" asp-for="Mobile" />
                    <div class="grid grid--2" style="gap:14px">
                        <div class="field">
                            <label asp-for="FirstName"></label>
                            <input class="input" asp-for="FirstName">
                            <span asp-validation-for="FirstName"></span>
                        </div>
                        <div class="field">
                            <label asp-for="LastName"></label>
                            <input class="input" asp-for="LastName">
                            <span asp-validation-for="LastName"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Mobile"></label>
                            <input class="input" asp-for="Mobile" disabled>
                            <span class="hint">برای تغییر شماره با پشتیبانی تماس بگیرید</span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn--primary">ذخیره تغییرات</button>
                </form>
            </section>

            <!-- Danger zone -->
            @if (Model.DeleteRequest)
            {
                <section class="card card-pad">
                    <h2 style="font-size:1.1rem">منطقه خطر</h2>

                    <div class="alert alert--warn">
                        درخواست حذف حساب کاربری شما ثبت شده است.

                        <br />
                        @if (Model.DeleteRequestDate is DateTime requestedAt)
                        {
                            @:حساب کاربری شما حداکثر تا
                            @requestedAt.AddDays(2).GetDate()
                            @:حذف خواهد شد. تا آن زمان می‌توانید درخواست را لغو کنید.
                        }
                    </div>

                    <form method="post" asp-area="UserPanel"
                          asp-controller="UserProfile" asp-action="CancelAccountDeleteRequest"
                          data-confirm-delete
                          data-confirm-title="درخواست حذف حساب لغو شود؟">
                        <button type="button" class="btn btn--success mt-2">
                            لغو درخواست حذف حساب کاربری
                        </button>
                    </form>
                </section>
            }
            else
            {
                <section class="card card-pad">
                    <h2 style="font-size:1.1rem">منطقه خطر</h2>
                    <div class="alert alert--warn">
                        حذف حساب کاربری دائمی است و قابل بازگشت نیست؛ تمام خریدها، لایسنس‌ها و سابقه دانلود شما برای همیشه از بین می‌رود.
                        <br />
                        حداکثر پس از 48 ساعت پس از ثبت درخواست، حساب کاربری شما حذف خواهد شد.
                    </div>

                    <form method="post" asp-area="UserPanel" style="display: inline-block"
                          asp-controller="UserProfile" asp-action="AccountDeleteRequest"
                          data-confirm-delete
                          data-confirm-title="درخواست حذف حساب ثبت شود؟">
                        <button type="submit" class="btn btn--danger mt-2">
                            ثبت درخواست حذف حساب کاربری
                        </button>
                    </form>
                </section>
            }
        </div>
    </div>
</main>