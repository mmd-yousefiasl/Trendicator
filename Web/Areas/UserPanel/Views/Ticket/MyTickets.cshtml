@using Application.Tools
@using Application.Dtos.Ticket.ClientSide
@using Domain.Enums.Tickets
@model ClientSideFilterTicketsViewModel

@{
    ViewData["Title"] = "لیست تیکت ها";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت تیکت ها</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <form asp-area="UserPanel" asp-controller="Ticket" method="get" asp-action="MyTickets" id="search-form">
        <input type="hidden" asp-for="Page" id="Page" />
    </form>

    @if (Model?.Entities?.Any() ?? false)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>تاریخ ایجاد</th>
                                        <th>آخرین ویرایش</th>
                                        <th>موضوع</th>
                                        <th>وضعیت</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int counter = 0;
                                        foreach (var item in Model.Entities ?? new List<ClientSideTicketViewModel>())
                                        {
                                            counter++;
                                            <tr>
                                                <th scope="row">@counter</th>
                                                <td>@item.CreatedDate.GetDateTime()</td>
                                                <td>@item.LastUpdatedDate.GetDateTime()</td>
                                                <td>@item.Subject</td>
                                                <td>@item.Status.GetDisplayName()</td>
                                                <td>
                                                    <a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketDetails" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm edit" title="ویرایش">
                                                        <i class="fas fa-eye"></i>
                                                    </a>

                                                    @if (item.Status != TicketStatusEnum.Closed)
                                                    {
                                                        <form class="btn btn-outline-secondary btn-sm" method="post" onclick="ConfirmDelete(this)" asp-route-id="@item.Id" asp-area="UserPanel" asp-controller="Ticket" asp-action="CloseTicket" title="بستن تیکت">
                                                            <i class="mdi mdi-close"></i>
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    }
    else
    {
        <partial name="_NotFoundPartial" />
    }
</div>