@using Application.Dtos.Tickets.ClientSide
@using Application.Tools
@using Domain.Enums.Tickets
@model ClientSideFilterTicketsDto

@{
    ViewData["Title"] = "تیکت پشتیبانی";

    // True when the user has actually narrowed the result set.
    // (The DTO enums are nullable — the form has "همه ..." empty options.)
    bool hasFilter = !string.IsNullOrWhiteSpace(Model?.Search)
                  || Model?.Category != null
                  || Model?.Priority != null
                  || Model?.Status != null;
}

<main class="container">
    <ul class="crumbs">
        <partial name="_IndexLink" />
        <partial name="_UserPanelHomeLink" />
        <li>@ViewData["Title"]</li>
    </ul>

    <partial name="_UserPanelWelcome" />

    <div class="account mt-3">

        <partial name="_UserPanelVerticalMenu" />

        <div class="account__body">

            <!-- ============ Header ============ -->
            <div class="flex flex--between flex--wrap">
                <h1 style="font-size:1.4rem;margin-bottom:0">@ViewData["Title"]</h1>

                <a asp-area="UserPanel" asp-controller="Ticket" asp-action="CreateNewTicket"
                   class="btn btn--primary btn--sm">
                    <svg class="ic" aria-hidden="true"><use href="#i-plus" /></svg>
                    ثبت تیکت جدید
                </a>
            </div>

            <!-- ============ Filters ============ -->
            <section class="card card-pad">
                <form novalidate asp-area="UserPanel" asp-controller="Ticket"
                      method="get" asp-action="TicketsList" id="search-form">

                    <input type="hidden" asp-for="Page" id="Page" />

                    <div class="grid grid--4">
                        <div class="field">
                            <label asp-for="Search"></label>
                            <input type="text" class="input" asp-for="Search"
                                   autocomplete="off" placeholder="عنوان تیکت...">
                        </div>

                        <div class="field">
                            <label asp-for="Category"></label>
                            <select class="select" asp-for="Category"
                                    asp-items="@Html.GetEnumSelectList<TicketCategoryEnum>()">
                                <option value="">همه دسته‌ها</option>
                            </select>
                        </div>

                        <div class="field">
                            <label asp-for="Priority"></label>
                            <select class="select" asp-for="Priority"
                                    asp-items="@Html.GetEnumSelectList<TicketPriorityEnum>()">
                                <option value="">همه اولویت‌ها</option>
                            </select>
                        </div>

                        <div class="field">
                            <label asp-for="Status"></label>
                            <select class="select" asp-for="Status"
                                    asp-items="@Html.GetEnumSelectList<TicketStatusEnum>()">
                                <option value="">همه وضعیت‌ها</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex flex--wrap" style="gap:8px">
                        <button class="btn btn--primary" type="submit">
                            <svg class="ic" aria-hidden="true"><use href="#i-search" /></svg>
                            جستجو و فیلتر
                        </button>

                        <a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketsList"
                           class="btn btn--ghost">
                            حذف فیلترها
                        </a>
                    </div>
                </form>
            </section>

            <!-- ============ Result ============ -->
            @if (Model?.Entities?.Any() ?? false)
            {
                <section class="card card-pad">
                    <div class="table-wrap" style="border:none">
                        <table class="table table--cards">
                            <thead>
                                <tr>
                                    <th style="width:70px">کد</th>
                                    <th>عنوان تیکت</th>
                                    <th>دسته بندی</th>
                                    <th>اولویت</th>
                                    <th>وضعیت</th>
                                    <th>آخرین بروزرسانی</th>
                                    <th style="width:110px">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Entities)
                                {
                                    @* Status → design-system badges *@
                                    string statusClass = item.Status switch
                                    {
                                        TicketStatusEnum.Open => "badge--brand",
                                        TicketStatusEnum.Pending => "badge",
                                        TicketStatusEnum.Answered => "badge--up",
                                        TicketStatusEnum.UserReplied => "badge--brand",
                                        TicketStatusEnum.Closed => "badge",
                                        _ => "badge"
                                    };

                                    @* Priority → design-system badges *@
                                    string priorityClass = item.Priority switch
                                    {
                                        TicketPriorityEnum.High => "badge--down",
                                        _ => "badge"
                                    };

                                    <tr>
                                        <td data-label="کد">
                                            <span dir="ltr" class="num">#@item.Id</span>
                                        </td>

                                        <td data-label="عنوان">
                                            <a asp-area="UserPanel" asp-controller="Ticket"
                                               asp-action="TicketDetails" asp-route-id="@item.Id">
                                                @item.Title
                                            </a>
                                        </td>

                                        <td data-label="دسته بندی">
                                            <span class="badge">@item.Category.GetDisplayName()</span>
                                        </td>

                                        <td data-label="اولویت">
                                            <span class="badge @priorityClass">@item.Priority.GetDisplayName()</span>
                                        </td>

                                        <td data-label="وضعیت">
                                            <span class="badge @statusClass">@item.Status.GetDisplayName()</span>
                                        </td>

                                        <td data-label="بروزرسانی" class="num text-dim">
                                            @item.LastUpdatedDate.GetDateTime()
                                        </td>

                                        <td data-label="عملیات">
                                            <a asp-area="UserPanel" asp-controller="Ticket"
                                               asp-action="TicketDetails" asp-route-id="@item.Id"
                                               class="btn btn--ghost btn--sm" title="مشاهده">
                                                <svg class="ic" aria-hidden="true"><use href="#i-eye" /></svg>
                                                مشاهده
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <partial name="_Paging" model="@Model.GetCurrentPaging()" />
                </section>
            }
            else
            {
                <div class="card">
                    <div class="empty" role="status">
                        <div class="empty__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"
                                      stroke="currentColor" stroke-width="1.6"
                                      stroke-linejoin="round" stroke-linecap="round" />
                            </svg>
                        </div>

                        @if (hasFilter)
                        {
                            <h3>تیکتی با این فیلترها پیدا نشد</h3>
                            <p>فیلترهای انتخابی نتیجه‌ای نداشتند. می‌توانید آن‌ها را تغییر دهید یا حذف کنید.</p>

                            <a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketsList"
                               class="btn btn--soft">
                                <svg class="ic" aria-hidden="true"><use href="#i-x" /></svg>
                                حذف فیلترها
                            </a>
                        }
                        else
                        {
                            <h3>هنوز تیکتی ثبت نکرده‌اید</h3>
                            <p>برای شروع، یک تیکت جدید ثبت کنید تا تیم پشتیبانی در اسرع وقت به آن پاسخ دهد.</p>

                            <a asp-area="UserPanel" asp-controller="Ticket" asp-action="CreateNewTicket"
                               class="btn btn--primary">
                                <svg class="ic" aria-hidden="true"><use href="#i-plus" /></svg>
                                ثبت تیکت جدید
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</main>