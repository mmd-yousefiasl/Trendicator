@using Application.Dtos.Tickets.ClientSide
@using Application.Tools
@using Domain.Enums.Tickets
@model ClientSideTicketDetailsDto

@if (Model == null)
{
    <div class="alert" style="border-color:var(--down);background:var(--down-soft);color:var(--down)">
        <span style="color:var(--down);font-size:1.15rem">
            <svg class="ic" aria-hidden="true"><use href="#i-exclamation-circle" /></svg>
        </span>
        <div>اطلاعات تیکت یافت نشد یا دسترسی شما محدود شده است.</div>
    </div>
}
else
{
    string statusClass = Model.Status switch
    {
        TicketStatusEnum.Open => "badge--brand",
        TicketStatusEnum.Pending => "badge",
        TicketStatusEnum.Answered => "badge--up",
        TicketStatusEnum.UserReplied => "badge--brand",
        TicketStatusEnum.Closed => "badge",
        _ => "badge"
    };

    @* ============ Header card ============ *@
    <section class="card card-pad">
        <div class="flex flex--between flex--wrap" style="gap:12px">
            <div style="min-width:0">
                <h2 style="font-size:1.1rem;margin-bottom:6px">@Model.Title</h2>

                <div class="flex flex--wrap" style="gap:6px 18px;font-size:.8rem;color:var(--text-3)">
                    <span>
                        <svg class="ic" style="vertical-align:-.15em" aria-hidden="true">
                            <use href="#i-folder" />
                        </svg>
                        دپارتمان: @Model.Category.GetDisplayName()
                    </span>
                    <span>
                        <svg class="ic" style="vertical-align:-.15em" aria-hidden="true">
                            <use href="#i-calendar" />
                        </svg>
                        تاریخ ثبت: @Model.CreatedDate.GetDateTime()
                    </span>
                </div>
            </div>

            <span class="badge @statusClass">@Model.Status.GetDisplayName()</span>
        </div>
    </section>

    @* ============ Conversation ============ *@
    <section class="card card-pad">
        @if (Model.Messages != null && Model.Messages.Any())
        {
            <div class="comments__list">
                @foreach (var message in Model.Messages)
                {
                    @* Admin = neutral panel; User = brand tint (matches chat conventions) *@
                    <div class="comment"
                         style="@(message.IsAdminResponse
                                     ? ""
                                     : "background:var(--brand-soft);border-color:var(--brand-line)")">

                        <div class="comment__avatar"
                             style="@(message.IsAdminResponse
                                         ? "background:var(--panel-2);border-color:var(--line);color:var(--text-2)"
                                         : "")">
                            @(message.IsAdminResponse ? "پ" : "ش")
                        </div>

                        <div class="comment__body">
                            <div class="comment__head">
                                <b style="@(message.IsAdminResponse ? "color:var(--text-2)" : "")">
                                    @(message.IsAdminResponse ? "پاسخ پشتیبان" : "شما")
                                </b>
                                <span class="comment__time">@message.CreatedDate.GetDateTime()</span>
                            </div>

                            <p style="white-space: pre-line;">@message.Text</p>

                            @if (!string.IsNullOrEmpty(message.AttachmentPath))
                            {
                                <div class="mt-1">
                                    <a asp-area="UserPanel" asp-controller="Ticket"
                                       asp-action="GetTicketAttachment" asp-route-fileName="@message.AttachmentPath"
                                       target="_blank" class="btn btn--ghost btn--sm">
                                        <svg class="ic" aria-hidden="true"><use href="#i-eye" /></svg>
                                        مشاهده فایل پیوست
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty" role="status">
                <div class="empty__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"
                              stroke="currentColor" stroke-width="1.6"
                              stroke-linejoin="round" stroke-linecap="round" />
                    </svg>
                </div>

                <h3>هیچ پیامی در این تیکت یافت نشد</h3>
                <p>اولین پیام خود را از طریق فرم پاسخ در پایین همین صفحه ارسال کنید.</p>
            </div>
        }
    </section>
}