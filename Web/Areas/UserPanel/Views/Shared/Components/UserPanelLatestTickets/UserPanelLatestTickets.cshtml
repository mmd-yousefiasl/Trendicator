@using Application.Dtos.Tickets.ClientSide
@model ClientSideFilterTicketsDto

@{
    // True when the user has actually narrowed the result set.
    // (The DTO enums are nullable — the form has "همه ..." empty options.)
    bool hasFilter = !string.IsNullOrWhiteSpace(Model?.Search)
                  || Model?.Category != null
                  || Model?.Priority != null
                  || Model?.Status != null;
}

@if (Model?.Entities?.Any() ?? false)
{
    <section class="card card-pad">
        <div class="flex flex--between flex--wrap mb-2">
            <h2 style="font-size:1.05rem;margin:0">تیکت های اخیر</h2>
            <a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketsList" class="btn btn--ghost btn--sm">مشاهده همه</a>
        </div>

        <partial name="_UserPanelTicketTable" model="@Model" />
    </section>
}
else
{
    <div class="card">
        <div class="empty" role="status">
            <div class="empty__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"
                          stroke="currentColor" stroke-width="1.6"
                          stroke-linejoin="round" stroke-linecap="round" />
                </svg>
            </div>

                <h3>هنوز تیکتی ثبت نکرده‌اید</h3>
                <p>برای شروع، یک تیکت جدید ثبت کنید تا تیم پشتیبانی در اسرع وقت به آن پاسخ دهد.</p>

                <a asp-area="UserPanel" asp-controller="Ticket" asp-action="CreateNewTicket"
                   class="btn btn--primary">
                    <svg class="ic" aria-hidden="true"><use href="#i-plus" /></svg>
                    ثبت تیکت جدید
                </a>

        </div>
    </div>
}