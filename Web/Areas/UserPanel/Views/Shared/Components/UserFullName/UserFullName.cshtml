@model string

@{
    var hasName = !string.IsNullOrWhiteSpace(Model);
}

<h1 class="mt-3" style="margin-bottom:8px">
    @if (hasName)
    {
        <text>سلام، @Model</text>
    }
    else
    {
        <text>سلام</text>
        <a href="/user/edit-user-profile"
           class="name-hint"
           title="نام نمایشی خود را تنظیم کنید"
           aria-label="تنظیم نام نمایشی">
            <svg class="ic" aria-hidden="true"><use href="#i-lightbulb" /></svg>
        </a>
    }
</h1>