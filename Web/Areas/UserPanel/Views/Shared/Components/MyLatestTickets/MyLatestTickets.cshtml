@using Application.Tools
@using Application.ViewModels.Ticket.ClientSide
@using Domain.Enums.Tickets
@model ClientSideFilterTicketsViewModel

@if (Model?.Entities?.Any() ?? false)
{
    <div class="col-xl-6">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4">
                    آخرین
                    <a asp-area="UserPanel" asp-controller="Ticket" asp-action="MyTickets">
                        تیکت های من
                    </a>
                </h4>
                <div class="table-responsive">
                    <table class="table align-middle table-centered table-vertical table-nowrap mb-1">
                        <tbody>
                            @{
                                int counter = 0;
                                foreach (var item in Model.Entities ?? new List<ClientSideTicketViewModel>())
                                {
                                    counter++;
                                    <tr>
                                        <th scope="row">@counter</th>
                                        <td>@item.CreatedDate.GetDateTime()</td>
                                        <td>@item.LastUpdatedDate.GetDateTime()</td>
                                        <td>@item.Subject</td>
                                        <td>@item.Status.GetDisplayName()</td>
                                        <td>
                                            <a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketDetails" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm edit" title="ویرایش">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            @if (item.Status != TicketStatusEnum.Closed)
                                            {
                                                <form class="btn btn-outline-secondary btn-sm" method="post" onclick="ConfirmDelete(this)" asp-route-id="@item.Id" asp-area="UserPanel" asp-controller="Ticket" asp-action="CloseTicket" title="بستن تیکت">
                                                    <i class="mdi mdi-close"></i>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}