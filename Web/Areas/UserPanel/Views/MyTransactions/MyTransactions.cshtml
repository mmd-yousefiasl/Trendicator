@using Application.Dtos.BalanceTransaction.ClientSide
@using Application.Tools
@using Domain.Enums.Users
@model ClientSideFilterTransactionsDto

@{
    ViewData["Title"] = "کیف پول من";
}

<main class="container">
    <ul class="crumbs">
        <partial name="_IndexLink" />
        <partial name="_UserPanelHomeLink" />
        <li>کیف پول من</li>
    </ul>

    <partial name="_UserPanelWelcome" />

    <div class="account mt-3">

        <partial name="_UserPanelVerticalMenu" />

        <div class="account__body">

            <div class="tx-head">
                <h2>کیف پول من</h2>

                @await Component.InvokeAsync("UserPanelAccountBalance")
            </div>

            <section class="card card-pad">

                <form method="get" asp-area="UserPanel" asp-controller="MyTransactions" asp-action="MyTransactions" id="search-form">
                    <input type="hidden" asp-for="Page" />
                </form>

                <h2 class="mb-2" style="font-size:1.05rem">تاریخچه تراکنش‌ها</h2>

                @if (Model?.Entities?.Any() ?? false)
                {
                    <div class="table-wrap" style="border:none">
                        <table class="table table--cards">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>تاریخ</th>
                                    <th>مبلغ</th>
                                    <th>نوع</th>
                                    <th>کد تراکنش</th>
                                    <th>وضعیت</th>
                                    <th>توضیحات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int counter = 0;
                                    foreach (var item in Model.Entities ?? new List<ClientSideTransactionDto>())
                                    {
                                        counter++;
                                        <tr>
                                            <td data-label="#"><span class="num">@counter</span></td>

                                            <td data-label="تاریخ" class="num">@item.DateTime.GetDateTime()</td>

                                            <td data-label="مبلغ" class="num">@item.Amount.ToToman()</td>

                                            <td data-label="نوع">
                                                @if (item.Type == BalanceTransactionTypeEnum.Credit)
                                                {
                                                    <span class="badge badge--up">@item.Type.GetDisplayName()</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge--down">@item.Type.GetDisplayName()</span>
                                                }
                                            </td>

                                            <td data-label="کد تراکنش"><span dir="ltr" class="num">@item.TransId</span></td>

                                            <td data-label="وضعیت">
                                                @if (item.IsSuccess)
                                                {
                                                    <span class="badge badge--up">موفق</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge--down">ناموفق</span>
                                                }
                                            </td>

                                            <td data-label="توضیحات" class="desc-cell" title="@item.Description">
                                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                                {
                                                    @item.Description
                                                }
                                                else
                                                {
                                                    <span class="text-dim">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <partial name="_Paging" model="@Model.GetCurrentPaging()" />
                }
                else
                {
                    <div class="card">
                        <div class="empty" role="status">
                            <div class="empty__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="3" y="7" width="18" height="12" rx="2.5"
                                          stroke="currentColor" stroke-width="1.6" />
                                    <path d="M3 10.5h18"
                                          stroke="currentColor" stroke-width="1.6"
                                          stroke-linecap="round" opacity=".55" />
                                    <path d="M16 13.5h3.5v3H16a1.5 1.5 0 0 1 0-3Z"
                                          stroke="currentColor" stroke-width="1.6"
                                          stroke-linejoin="round" />
                                </svg>
                            </div>

                            <h3>هنوز تراکنشی ثبت نکرده‌اید</h3>
                            <p>
                                به‌محض انجام اولین تراکنش (شارژ کیف پول، خرید یا بازگشت وجه)،
                                مبلغ، نوع، کد پیگیری و وضعیت آن در همین صفحه نمایش داده می‌شود.
                            </p>

                            <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="" class="btn btn--primary">
                                <svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2"
                                          stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                شروع خرید
                            </a>
                        </div>
                    </div>
                }
            </section>
        </div>
    </div>
</main>