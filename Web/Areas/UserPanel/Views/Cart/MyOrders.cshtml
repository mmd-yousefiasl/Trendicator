@using Application.Dtos.Cart.ClientSide
@using Application.Tools
@model ClientSideFilterCartsViewModel

@{
    ViewData["Title"] = "لیست سفارش های من";
}

<main class="container">
    <ul class="crumbs">
        <partial name="_IndexLink" />
        <partial name="_UserPanelHomeLink" />
        <li>خریدهای من</li>
    </ul>

    <partial name="_UserPanelWelcome" />

    <div class="account mt-3">

        <partial name="_UserPanelVerticalMenu" />

        <!-- ============ Content ============ -->
        <div class="account__body">

            <h1 style="font-size:1.4rem;margin-bottom:0">خریدهای من</h1>

            <!-- Stats -->
            <div class="grid grid--4" style="gap:14px">
                <div class="card stat stat--brand"><b class="num">۷</b><span>محصول خریداری‌شده</span></div>
                <div class="card stat"><b class="num">۸٬۴۲۰٬۰۰۰</b><span>تومان مجموع خرید</span></div>
                <div class="card stat"><b class="num">۲۳</b><span>دانلود</span></div>
                <div class="card stat"><b class="num">۱</b><span>لایسنس در انتظار فعال‌سازی</span></div>
            </div>

            <!-- Orders -->
            <section class="card card-pad">
                <h2 class="mb-2" style="font-size:1.05rem">تاریخچه سفارش‌ها</h2>
                <div class="table-wrap" style="border:none">
                    <table class="table table--cards">
                        <thead>
                            <tr>
                                <th>کد سفارش</th>
                                <th>تاریخ</th>
                                <th>محصولات</th>
                                <th>مبلغ</th>
                                <th>وضعیت</th>
                                <th>فاکتور</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td data-label="کد سفارش"><span dir="ltr" class="num">TRD-۱۴۰۵-۱۰۲۴</span></td>
                                <td class="num" data-label="تاریخ">۳۱ مرداد ۱۴۰۵</td>
                                <td data-label="محصولات"><b>ترند اسکالپر پرو</b> <span class="text-dim">MT5</span></td>
                                <td class="num" data-label="مبلغ">۲٬۴۸۰٬۰۰۰ تومان</td>
                                <td data-label="وضعیت"><span class="badge badge--up">پرداخت شده</span></td>
                                <td data-label="فاکتور"><a href="#" class="btn btn--ghost btn--sm">دانلود PDF</a></td>
                            </tr>
                            <tr>
                                <td data-label="کد سفارش"><span dir="ltr" class="num">TRD-۱۴۰۵-۱۰۱۹</span></td>
                                <td class="num" data-label="تاریخ">۲۴ مرداد ۱۴۰۵</td>
                                <td data-label="محصولات"><b>سوپر ترند دارچین</b> <span class="text-dim">TradingView</span></td>
                                <td class="num" data-label="مبلغ">۱٬۸۹۰٬۰۰۰ تومان</td>
                                <td data-label="وضعیت"><span class="badge badge--up">پرداخت شده</span></td>
                                <td data-label="فاکتور"><a href="#" class="btn btn--ghost btn--sm">دانلود PDF</a></td>
                            </tr>
                            <tr>
                                <td data-label="کد سفارش"><span dir="ltr" class="num">TRD-۱۴۰۵-۱۰۱۲</span></td>
                                <td class="num" data-label="تاریخ">۱۰ مرداد ۱۴۰۵</td>
                                <td data-label="محصولات"><b>اسمارت مانی فلو</b> <span class="text-dim">MT5</span></td>
                                <td class="num" data-label="مبلغ">۲٬۴۶۰٬۰۰۰ تومان</td>
                                <td data-label="وضعیت"><span class="badge badge--up">پرداخت شده</span></td>
                                <td data-label="فاکتور"><a href="#" class="btn btn--ghost btn--sm">دانلود PDF</a></td>
                            </tr>
                            <tr>
                                <td data-label="کد سفارش"><span dir="ltr" class="num">TRD-۱۴۰۵-۱۰۰۷</span></td>
                                <td class="num" data-label="تاریخ">۲ مرداد ۱۴۰۵</td>
                                <td data-label="محصولات"><b>ایکسپرت گاردین</b> <span class="text-dim">MT4</span></td>
                                <td class="num" data-label="مبلغ">۳٬۱۰۰٬۰۰۰ تومان</td>
                                <td data-label="وضعیت"><span class="badge badge--brand">در حال پردازش</span></td>
                                <td class="text-dim" data-label="فاکتور">—</td>
                            </tr>
                            <tr>
                                <td data-label="کد سفارش"><span dir="ltr" class="num">TRD-۱۴۰۵-۰۹۹۳</span></td>
                                <td class="num" data-label="تاریخ">۲۸ تیر ۱۴۰۵</td>
                                <td data-label="محصولات"><b>پرو ساپورت رزیستانس</b> <span class="text-dim">MT4</span></td>
                                <td class="num" data-label="مبلغ">۹۸۰٬۰۰۰ تومان</td>
                                <td data-label="وضعیت"><span class="badge badge--down">لغو شده</span></td>
                                <td class="text-dim" data-label="فاکتور">—</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Downloads -->
            <section class="card card-pad">
                <h2 class="mb-2" style="font-size:1.05rem">فایل‌های قابل دانلود</h2>
                <div class="table-wrap" style="border:none">
                    <table class="table table--cards">
                        <thead>
                            <tr>
                                <th>محصول</th>
                                <th>پلتفرم</th>
                                <th>نسخه</th>
                                <th>تاریخ به‌روزرسانی</th>
                                <th>دانلود</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td data-label="محصول"><b>ترند اسکالپر پرو</b></td>
                                <td data-label="پلتفرم">MT5</td>
                                <td data-label="نسخه"><span dir="ltr" class="num">v3.2</span></td>
                                <td class="num" data-label="تاریخ به‌روزرسانی">۳۱ مرداد ۱۴۰۵</td>
                                <td data-label="دانلود"><a href="#" class="btn btn--soft btn--sm">دانلود</a></td>
                            </tr>
                            <tr>
                                <td data-label="محصول"><b>سوپر ترند دارچین</b></td>
                                <td data-label="پلتفرم">TradingView</td>
                                <td data-label="نسخه"><span dir="ltr" class="num">v2.1</span></td>
                                <td class="num" data-label="تاریخ به‌روزرسانی">۲۴ مرداد ۱۴۰۵</td>
                                <td data-label="دانلود"><a href="#" class="btn btn--soft btn--sm">دانلود</a></td>
                            </tr>
                            <tr>
                                <td data-label="محصول"><b>اسمارت مانی فلو</b></td>
                                <td data-label="پلتفرم">MT5</td>
                                <td data-label="نسخه"><span dir="ltr" class="num">v1.8</span></td>
                                <td class="num" data-label="تاریخ به‌روزرسانی">۱۰ مرداد ۱۴۰۵</td>
                                <td data-label="دانلود"><a href="#" class="btn btn--soft btn--sm">دانلود</a></td>
                            </tr>
                            <tr>
                                <td data-label="محصول"><b>ایکسپرت گاردین</b></td>
                                <td data-label="پلتفرم">MT4</td>
                                <td data-label="نسخه"><span dir="ltr" class="num">v4.0</span></td>
                                <td class="num" data-label="تاریخ به‌روزرسانی">۲ مرداد ۱۴۰۵</td>
                                <td data-label="دانلود"><a href="#" class="btn btn--soft btn--sm">دانلود</a></td>
                            </tr>
                            <tr>
                                <td data-label="محصول"><b>پرو ساپورت رزیستانس</b></td>
                                <td data-label="پلتفرم">MT4</td>
                                <td data-label="نسخه"><span dir="ltr" class="num">v2.3</span></td>
                                <td class="num" data-label="تاریخ به‌روزرسانی">۲۸ تیر ۱۴۰۵</td>
                                <td data-label="دانلود"><a href="#" class="btn btn--soft btn--sm">دانلود</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="hint mt-2 mb-0">هر فایل تا ۵ بار قابل دانلود است؛ پس از اتمام، از تیکت پشتیبانی تمدید کنید.</p>
            </section>
        </div>
    </div>
</main>