@using Application.Dtos.Cart.ClientSide
@model ClientSideFilterCartsDto

@{
    ViewData["Title"] = "خرید های من";
}

<main class="container">
    <ul class="crumbs">
        <partial name="_IndexLink" />
        <partial name="_UserPanelHomeLink" />
        <li>خریدهای من</li>
    </ul>

    <partial name="_UserPanelWelcome" />

    <div class="account mt-3">

        <partial name="_UserPanelVerticalMenu" />

        <!-- ============ Content ============ -->
        <div class="account__body">

            <h1 style="font-size:1.4rem;margin-bottom:0">خریدهای من</h1>

            @await Component.InvokeAsync("UserPanelUserCartStats")

            <!-- Orders -->
            <section class="card card-pad">
                <form method="get" asp-area="UserPanel" asp-controller="Cart" asp-action="MyOrders" id="search-form">
                    <input type="hidden" asp-for="Page" />
                </form>
                <div class="flex flex--between flex--wrap mb-2">
                    <h2 class="mb-2" style="font-size:1.05rem">تاریخچه سفارش‌ها</h2>

                    <a asp-area="UserPanel" asp-controller="Cart" asp-action="MyProducts"
                       class="btn btn--ghost btn--sm" title="محصولات خریداری شده">
                        <svg class="ic" aria-hidden="true">
                            <use href="#i-download" />
                        </svg>
                        محصولات خریداری شده
                    </a>
                </div>
                @if (Model?.Entities?.Any() ?? false)
                {
                    <partial name="_UserPanelOrderTable" model="@Model" />

                    <partial name="_Paging" model="@Model.GetCurrentPaging()" />
                }
                else
                {
                    <div class="card">
                        <div class="empty" role="status">
                            <div class="empty__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M6 8.25h12l-1.05 10.5A2 2 0 0 1 14.96 20.5H9.04a2 2 0 0 1-1.99-1.75L6 8.25Z"
                                          stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                    <path d="M9 8.25V6a3 3 0 0 1 6 0v2.25"
                                          stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    <path d="M10 13.5h4"
                                          stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity=".55" />
                                </svg>
                            </div>

                            <h3>هنوز سفارشی ثبت نکرده‌اید</h3>
                            <p>
                                به‌محض ثبت اولین سفارش، کد سفارش، تاریخ، مبلغ و وضعیت آن در همین صفحه نمایش داده می‌شود.
                            </p>

                            <a asp-area="" asp-controller="Product" asp-action="ProductsList" asp-route-category="" class="btn btn--primary">
                                <svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2"
                                          stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                شروع خرید
                            </a>
                        </div>
                    </div>
                }
            </section>
        </div>
    </div>
</main>