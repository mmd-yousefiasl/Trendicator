@using Application.ViewModels.Cart.ClientSide
@using Domain.Enums.Shopping
@using Application.Tools
@model ClientSideFilterCartsViewModel

@{
    ViewData["Title"] = "لیست سفارش های من";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت سفارش های من</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <form novalidate asp-area="UserPanel" asp-controller="Cart" method="get" asp-action="MyOrders" id="search-form">
        <input type="hidden" asp-for="Page" id="Page" />
    </form>

    @if (Model?.Entities?.Any() ?? false)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>تاریخ پرداخت</th>
                                        <th>وضعیت</th>
                                        <th>کل پرداخت</th>
                                        <th>کل تخفیف</th>
                                        <th>کد تخفیف</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Entities ?? new List<ClientSideOrderViewModel>())
                                    {
                                        <tr>
                                            <th scope="row">@item.Id</th>
                                            <td>@item.PaidDate?.GetDateTime()</td>
                                            <td>@item.Status.GetDisplayName()</td>
                                            <td>@item.TotalPaid?.ToToman()</td>
                                            <td>@item.TotalDiscount?.ToToman()</td>
                                            <td>@item.DiscountCode</td>
                                            <td>
                                                <a asp-area="UserPanel" asp-controller="Cart" asp-action="MyOrderDetails" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm edit" title="جزئیات سفارش">
                                                    <i class="fa fa-file-text"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
           
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    }
    else
    {
        <partial name="_NotFoundPartial" />
    }
</div>