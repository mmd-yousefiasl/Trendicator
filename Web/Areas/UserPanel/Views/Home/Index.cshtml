@{
    ViewData["Title"] = "حساب من";
}

<main class="container">
    <ul class="crumbs">
        <partial name="_IndexLink" />
        <li>پنل کاربری</li>
    </ul>

    <partial name="_UserPanelWelcome" />

    <div class="account mt-3">

        <partial name="_UserPanelVerticalMenu" />

        <!-- ============ Content ============ -->
        <div class="account__body">

            <!-- Stats -->
            <div class="grid grid--4" style="gap:14px">
                <div class="card stat stat--brand"><b class="num">۷</b><span>محصول خریداری‌شده</span></div>
                <div class="card stat"><b class="num">۱۲</b><span>روز باقی‌مانده اشتراک</span></div>
                <div class="card stat"><b class="num">۲</b><span>تیکت باز</span></div>
                <div class="card stat"><b class="num">۳۱</b><span>دانلود این ماه</span></div>
            </div>

            <!-- Subscription status -->
            <section class="card card-pad">
                <div class="flex flex--between flex--wrap">
                    <div>
                        <h2 style="font-size:1.05rem;margin-bottom:2px">اشتراک حرفه‌ای</h2>
                        <p class="text-dim" style="font-size:.82rem;margin:0">تمدید خودکار در ۱۷ شهریور ۱۴۰۵</p>
                    </div>
                    <a href="account-subscription.html" class="btn btn--primary btn--sm">مدیریت اشتراک</a>
                </div>
                <div class="progress mt-2" role="progressbar" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100"
                     aria-label="وضعیت دوره اشتراک">
                    <i style="width:60%"></i>
                </div>
                <p class="hint mt-1 mb-0">۱۲ روز از ۳۰ روز باقی مانده است</p>
            </section>

            <!-- Purchases -->
            <section class="card card-pad">
                <div class="flex flex--between flex--wrap mb-2">
                    <h2 style="font-size:1.05rem;margin:0">خریدهای اخیر</h2>
                    <a href="account-purchases.html" class="btn btn--ghost btn--sm">مشاهده همه</a>
                </div>

                <div class="table-wrap" style="border:none">
                    <table class="table table--cards">
                        <thead>
                            <tr>
                                <th>محصول</th>
                                <th>تاریخ خرید</th>
                                <th>مبلغ</th>
                                <th>وضعیت</th>
                                <th>دانلود</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td data-label="محصول"><b>ترند اسکالپر پرو</b></td>
                                <td class="num" data-label="تاریخ خرید">۳۱ مرداد ۱۴۰۵</td>
                                <td class="num" data-label="مبلغ">۲٬۴۸۰٬۰۰۰ تومان</td>
                                <td data-label="وضعیت"><span class="badge badge--up">پرداخت شده</span></td>
                                <td data-label="دانلود"><a href="#" class="btn btn--soft btn--sm">دانلود</a></td>
                            </tr>
                            <tr>
                                <td data-label="محصول"><b>سوپر ترند دارچین</b></td>
                                <td class="num" data-label="تاریخ خرید">۲۴ مرداد ۱۴۰۵</td>
                                <td class="num" data-label="مبلغ">۱٬۸۹۰٬۰۰۰ تومان</td>
                                <td data-label="وضعیت"><span class="badge badge--up">پرداخت شده</span></td>
                                <td data-label="دانلود"><a href="#" class="btn btn--soft btn--sm">دانلود</a></td>
                            </tr>
                            <tr>
                                <td data-label="محصول"><b>اسمارت مانی فلو</b></td>
                                <td class="num" data-label="تاریخ خرید">۱۰ مرداد ۱۴۰۵</td>
                                <td class="num" data-label="مبلغ">۲٬۴۶۰٬۰۰۰ تومان</td>
                                <td data-label="وضعیت"><span class="badge badge--up">پرداخت شده</span></td>
                                <td data-label="دانلود"><a href="#" class="btn btn--soft btn--sm">دانلود</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Tickets -->
            <section class="card card-pad">
                <div class="flex flex--between flex--wrap mb-2">
                    <h2 style="font-size:1.05rem;margin:0">تیکت‌های اخیر</h2>
                    <a href="account-tickets.html" class="btn btn--primary btn--sm">تیکت جدید</a>
                </div>
                <div class="table-wrap" style="border:none">
                    <table class="table table--cards">
                        <thead>
                            <tr>
                                <th>موضوع</th>
                                <th>دپارتمان</th>
                                <th>وضعیت</th>
                                <th>آخرین بروزرسانی</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td data-label="موضوع"><b>مشکل در نصب روی متاتریدر ۵</b></td>
                                <td data-label="دپارتمان">فنی</td>
                                <td data-label="وضعیت"><span class="badge badge--brand">در حال بررسی</span></td>
                                <td class="num" data-label="آخرین بروزرسانی">۲ ساعت پیش</td>
                            </tr>
                            <tr>
                                <td data-label="موضوع"><b>درخواست فاکتور رسمی</b></td>
                                <td data-label="دپارتمان">مالی</td>
                                <td data-label="وضعیت"><span class="badge badge--up">پاسخ داده شده</span></td>
                                <td class="num" data-label="آخرین بروزرسانی">۱ روز پیش</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</main>
