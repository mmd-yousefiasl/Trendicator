@{
    ViewData["Title"] = "حساب من";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-12">
            <div class="page-title-box">
                <h4>حساب من</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item active">صفحه نخست</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        @await Component.InvokeAsync("MySignInDate")
        @await Component.InvokeAsync("MyOrdersCount")
        @await Component.InvokeAsync("MyOrdersTotalValue")
        @await Component.InvokeAsync("MyTicketsCount")
    </div>

    <div class="row">
        @await Component.InvokeAsync("MyLatestOrders")
        @await Component.InvokeAsync("MyLatestTickets")
    </div>
</div>