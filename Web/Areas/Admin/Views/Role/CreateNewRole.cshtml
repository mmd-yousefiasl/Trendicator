@using Application.Services.Interfaces
@using Application.Dtos.Permission.AdminSide
@using Application.Dtos.Role.AdminSide
@model AdminSideCreateNewRoleViewModel


@inject IPermissionService _permissionService;
@{
    ViewData["Title"] = "افزودن نقش جدید";
    var permissionsResult = await _permissionService.GetAllPermissions();
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت نقش ها</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item active"><a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a></li>
                    <li class="breadcrumb-item active"><a asp-area="Admin" asp-controller="Role" asp-action="RolesList">لیست نقش ها</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <form asp-area="Admin" asp-controller="Role" asp-action="CreateNewRole" autocomplete="off" class="row" onsubmit="submitAnimation()">
        <div class="col-sm-12 col-md-9">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@ViewData["Title"]</h4>
                    <div class="mb-3 row">
                        <label asp-for="Title" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Title" required>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="UniqueName" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="UniqueName" required>
                            <span asp-validation-for="UniqueName" class="text-danger"></span>
                        </div>
                    </div>

                    <div asp-validation-summary="All" class="text-danger"></div>


                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ثبت نقش</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-12 col-md-3">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-3">دسترسی ها</h4>

                    <div class="accordion accordion-flush" id="accordionFlushExample">
                        <div class="col-12">
                            <div class="form-check mb-3">
                                @if (Model?.PermissionIds?.Contains(1) ?? false)
                                {
                                    <input class="form-check-input" name="PermissionIds" value="1" type="checkbox" id="formCheck-99999" checked>
                                }
                                else
                                {
                                    <input class="form-check-input" name="PermissionIds" value="1" type="checkbox" id="formCheck-99999">
                                }
                                <label class="form-check-label" for="formCheck-99999">
                                    پنل ادمین
                                </label>
                            </div>
                        </div>
                        @{
                            int counter = 0;
                            foreach (var item in permissionsResult.Value.Where(n => n.ParentId == 1) ?? new List<AdminSidePermissionViewModel>())
                            {
                                counter++;

                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="flush-heading-@counter">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapse-@counter" aria-expanded="false" aria-controls="flush-collapse-@counter">
                                            @item.Title
                                        </button>
                                    </h2>
                                    <div id="flush-collapse-@counter" class="accordion-collapse collapse" aria-labelledby="flush-heading-@counter" data-bs-parent="#accordionFlushExample">
                                        <div class="accordion-body">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="form-check mb-3">
                                                        @if (Model?.PermissionIds?.Contains(item.Id) ?? false)
                                                        {
                                                            <input class="form-check-input" name="PermissionIds" value="@item.Id" type="checkbox" id="formCheck-@counter" checked>
                                                        }
                                                        else
                                                        {
                                                            <input class="form-check-input" name="PermissionIds" value="@item.Id" type="checkbox" id="formCheck-@counter">
                                                        }
                                                        <label class="form-check-label" for="formCheck-@counter">
                                                            @item.Title
                                                        </label>
                                                    </div>
                                                </div>
                                                @foreach (var item2 in permissionsResult.Value.Where(n => n.ParentId == item.Id) ?? new List<AdminSidePermissionViewModel>())
                                                {
                                                    counter++;
                                                    <div class="col-12">
                                                        <div class="form-check mb-3">
                                                            @if (Model?.PermissionIds?.Contains(item2.Id) ?? false)
                                                            {
                                                                <input class="form-check-input" name="PermissionIds" value="@item2.Id" type="checkbox" id="formCheck-@counter" checked>
                                                            }
                                                            else
                                                            {
                                                                <input class="form-check-input" name="PermissionIds" value="@item2.Id" type="checkbox" id="formCheck-@counter">
                                                            }
                                                            <label class="form-check-label" for="formCheck-@counter">
                                                                @item2.Title
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>