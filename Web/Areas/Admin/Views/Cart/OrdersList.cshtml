@using Application.Dtos.Cart.AdminSide
@using Domain.Enums.Shopping
@using Application.Tools
@model AdminSideFilterCartsViewModel

@{
    ViewData["Title"] = "لیست سفارش ها";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت سفارش ها</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">جست و جوی سفارش ها</h4>
                    <form novalidate asp-area="Admin" asp-controller="Cart" method="get" asp-action="OrdersList" id="search-form">
                        <input type="hidden" asp-for="Page" id="Page" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="Search"></label>
                                    <input type="text" class="form-control" asp-for="Search" autocomplete="off">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="Status"></label>
                                    <select type="text" class="form-control" asp-for="Status" asp-items="@Html.GetEnumSelectList<CartStatusEnum>()">
                                        <option value="">همه</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-primary" type="submit">جست و جو</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model?.Entities?.Any() ?? false)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>تاریخ پرداخت</th>
                                        <th>کاربر</th>
                                        <th>وضعیت</th>
                                        <th>کل پرداخت</th>
                                        <th>کل تخفیف</th>
                                        <th>کد تخفیف</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Entities ?? new List<AdminSideCartViewModel>())
                                    {
                                        <tr>
                                            <th scope="row">@item.Id</th>
                                            <td>@item.PaidDate?.GetDateTime()</td>
                                            <td>
                                                <a asp-area="Admin" asp-controller="User" asp-action="UpdateUser" asp-route-id="@item.UserId">
                                                    @item.UserIP
                                                </a>
                                            </td>
                                            <td>@item.Status.GetDisplayName()</td>
                                            <td>@item.TotalPaid?.ToToman()</td>
                                            <td>@item.TotalDiscount?.ToToman()</td>
                                            <td>@item.DiscountCode</td>
                                            <td>
                                                <a permission="UpdateOrder" asp-area="Admin" asp-controller="Cart" asp-action="UpdateOrder" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm edit" title="ویرایش">
                                                    <i class="fas fa-pencil-alt"></i>
                                                </a>

                                                <a permission="OrderDetails" asp-area="Admin" asp-controller="Cart" asp-action="OrderDetails" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm edit" title="جزئیات سفارش">
                                                    <i class="fa fa-file-text"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    }
    else
    {
        <partial name="_NotFoundPartial" />
    }
</div>