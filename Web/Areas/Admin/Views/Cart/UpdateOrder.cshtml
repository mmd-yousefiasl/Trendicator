@using Application.Dtos.Cart.AdminSide
@using Domain.Enums.Shopping
@model AdminSideUpdateCartStatusViewModel

@{
    ViewData["Title"] = "ویرایش وضعیت سفارش";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت سفارش ها</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Cart" asp-action="OrdersList">لیست سفارش ها</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <form class="card-body" asp-area="Admin" asp-controller="Cart" asp-action="UpdateOrder" autocomplete="off" enctype="multipart/form-data" onsubmit="submitAnimation()">
                    <input asp-for="Id" type="hidden" />
                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label class="col-md-2 col-form-label" asp-for="Status"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="Status" asp-items="@Html.GetEnumSelectList<CartStatusEnum>()">
                            </select>
                        </div>
                    </div>

                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ویرایش</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>