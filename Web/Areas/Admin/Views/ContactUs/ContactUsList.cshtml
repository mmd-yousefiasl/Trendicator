@using Application.Dtos.ContactUsForm.AdminSide
@using Application.Tools
@using Domain.Enums.ContactUs
@model AdminSideFilterContactUsFormsViewModel

@{
    ViewData["Title"] = "لیست فرم های تماس باما";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت فرم های تماس باما</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">جست و جوی فرم ها</h4>
                    <form novalidate asp-area="Admin" asp-controller="ContactUs" method="get" asp-action="ContactUsList" id="search-form">
                        <input type="hidden" asp-for="Page" id="Page" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="Search"></label>
                                    <input type="text" class="form-control" asp-for="Search" autocomplete="off">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="Type"></label>
                                    <select class="form-control" asp-for="Type" asp-items="@Html.GetEnumSelectList<ContactUsFormTypeEnum>()">
                                        <option value="">همه</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-primary" type="submit">جست و جو</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model?.Entities?.Any() ?? false)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>تاریخ ثبت</th>
                                        <th>نام</th>
                                        <th>تلفن</th>
                                        <th>موضوع</th>
                                        <th>کاربر</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int counter = 0;

                                        foreach (var item in Model.Entities ?? new List<AdminSideContactUsFormViewModel>())
                                        {
                                            counter++;

                                            <tr>
                                                <th scope="row">@counter</th>
                                                <td>@item.CreatedDate.GetDate()</td>
                                                <td>@item.FullName</td>
                                                <td>@item.Mobile</td>
                                                <td>@item.Type</td>
                                                <td>
                                                    @if (item.UserId > 0)
                                                    {
                                                        <a asp-area="Admin" asp-controller="User" asp-action="UpdateUser" asp-route-id="@item.UserId" target="_blank">
                                                            @item.UserIP
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        @item.UserIP
                                                    }
                                                </td>
                                                <td>
                                                    <form permission="DeleteContactUsForm" class="btn btn-outline-secondary btn-sm" method="post" onclick="ConfirmDelete(this)" asp-route-id="@item.Id" asp-area="Admin" asp-controller="ContactUs" asp-action="DeleteContactUsForm" title="حذف">
                                                        <i class="mdi mdi-delete"></i>
                                                    </form>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="7">@item.Message</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    }
    else
    {
        <partial name="_NotFoundPartial" />
    }
</div>