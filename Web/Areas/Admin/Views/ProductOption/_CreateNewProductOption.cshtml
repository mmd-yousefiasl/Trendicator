@using Application.Dtos.ProductOption.AdminSide
@model AdminSideCreateNewProductOptionViewModel

<div id="ProductOptions">
    <input type="hidden" asp-for="ProductId" id="ProductOptionProductId" />
    @await Component.InvokeAsync("ProductOptions", Model.ProductId)

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <form class="card-body" id="createOptionForm" asp-area="Admin" asp-controller="ProductOption" asp-action="CraeteNewProductOption" autocomplete="off" onsubmit="submitProductOptionForm(event)">
                    <input type="hidden" asp-for="ProductId" />

                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label asp-for="Title" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Title">
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Price" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="Price">
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="OrderPrice" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="OrderPrice">
                            <span asp-validation-for="OrderPrice" class="text-danger"></span>
                        </div>
                    </div>

                    <div asp-validation-summary="All" class="text-danger validation-summary"></div>


                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ثبت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</div>