@using Application.ViewModels.SentLetter.AdminSide
@model AdminSideSendLetterViewModel

@{
    ViewData["Title"] = "ارسال ایمیل جدید";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت ایمیل های ارسال شده</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="SentLetter" asp-action="SentLettersList">لیست ایمیل های ارسال شده</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <form class="card-body" asp-area="Admin" asp-controller="SentLetter" asp-action="SendLetter" autocomplete="off" onsubmit="submitAnimation()">
                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label asp-for="Subject" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Subject">
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Message" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <textarea class="form-control ck-editor" rows="6" type="text" asp-for="Message"></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ارسال</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>