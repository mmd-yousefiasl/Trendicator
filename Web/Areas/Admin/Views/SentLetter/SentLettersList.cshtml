@using Application.Tools
@using Application.ViewModels.SentLetter.AdminSide
@model AdminSideFilterSentLettersViewModel

@{
    ViewData["Title"] = "لیست ایمیل های ارسال شده";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت ایمیل های ارسالی</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">جست و جوی ایمیل ها</h4>
                    <form novalidate asp-area="Admin" asp-controller="SentLetter" method="get" asp-action="SentLettersList" id="search-form">
                        <input type="hidden" asp-for="Page" id="Page" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="Search"></label>
                                    <input type="text" class="form-control" asp-for="Search" autocomplete="off">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="IsSucceed"></label>
                                    <select type="text" class="form-control" asp-for="IsSucceed">
                                        <option value="">همه</option>
                                        <option value="true">موفق</option>
                                        <option value="false">ناموفق</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-primary" type="submit">جست و جو</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model?.Entities?.Any() ?? false)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>تاریخ ارسال</th>
                                        <th>موضوع</th>
                                        <th>تعداد ارسال شده</th>
                                        <th>وضعیت ارسال</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int counter = 0;

                                        foreach (var item in Model.Entities ?? new List<AdminSideSentLetterViewModel>())
                                        {
                                            counter++;

                                            <tr>
                                                <th scope="row">@counter</th>
                                                <td>@item.SentDate.GetDateTime()</td>
                                                <td>@item.Subject</td>
                                                <td>@item.TargetMailCount</td>
                                                <td>
                                                    @if (item.IsSucceed)
                                                    {
                                                        <span class="text-success">موفق</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">ناموفق</span>
                                                    }
                                                </td>
                                                <td>
                                                    <form permission="DeleteSentLetter" class="btn btn-outline-secondary btn-sm" method="post" onclick="ConfirmDelete(this)" asp-route-id="@item.Id" asp-area="Admin" asp-controller="SentLetter" asp-action="DeleteSentLetter" title="حذف">
                                                        <i class="mdi mdi-delete"></i>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    }
    else
    {
        <partial name="_NotFoundPartial" />
    }
</div>