@using Application.ViewModels.ProductGallery.AdminSide
@model AdminSideCreateNewProductGalleryViewModel

<div class="container">
    <div class="row">
        <form id="imageForm" class="col-12 col-md-4 mb-3" asp-area="Admin" asp-controller="ProductGallery" asp-action="CreateNewProductGallery" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="ProductId" id="ProductId" />
            <label for="imageInput" class="d-flex justify-content-center align-items-center border border-secondary rounded" style="height: 200px; cursor: pointer;">
                <i class="fa fa-plus fs-1 text-secondary"></i>
            </label>
            <input type="file" id="imageInput" asp-for="File" accept="image/*" class="d-none"
                   onchange="handleImageUpload()">
        </form>


        @await Component.InvokeAsync("ProductGallery", Model.ProductId)
    </div>
</div>