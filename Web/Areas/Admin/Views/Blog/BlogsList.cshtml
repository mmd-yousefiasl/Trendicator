@using Application.Dtos.Blog.AdminSide
@model AdminSideFilterBlogsViewModel

@{
    ViewData["Title"] = "لیست مقالات";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت مقالات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">جست و جوی  مقالات</h4>
                    <form novalidate asp-area="Admin" asp-controller="Blog" method="get" asp-action="BlogsList" id="search-form">
                        <input type="hidden" asp-for="Page" id="Page" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="Search"></label>
                                    <input type="text" class="form-control" asp-for="Search" autocomplete="off">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="IsPublished"></label>
                                    <select type="text" class="form-control" asp-for="IsPublished">
                                        <option>همه</option>
                                        <option value="false">منتشرنشده</option>
                                        <option value="true">منتشرشده</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-primary" type="submit">جست و جو</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model?.Entities?.Any() ?? false)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>عنوان</th>
                                        <th>نویسنده</th>
                                        <th>دسته بندی</th>
                                        <th>اولویت</th>
                                        <th>زمان مطالعه</th>
                                        <th>وضعیت انتشار</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int counter = 0;

                                        foreach (var item in Model.Entities ?? new List<AdminSideBlogViewModel>())
                                        {
                                            counter++;

                                            <tr>
                                                <th scope="row">@counter</th>
                                                <td title="@item.Slug">@item.Title</td>
                                                <td>@item.Writer</td>
                                                <td>@item.Category</td>
                                                <td>@item.Priority</td>
                                                <td>@item.TimeToRead</td>
                                                <td>
                                                    @if (item.IsPublished)
                                                    {
                                                        <span class="text-success">منتشرشده</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">منتشرنشده</span>
                                                    }
                                                </td>
                                                <td>
                                                    <a permission="UpdateBlog" asp-area="Admin" asp-controller="Blog" asp-action="UpdateBlog" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm edit" title="ویرایش">
                                                        <i class="fas fa-pencil-alt"></i>
                                                    </a>

                                                    <form permission="DeleteBlog" class="btn btn-outline-secondary btn-sm" method="post" onclick="ConfirmDelete(this)" asp-route-id="@item.Id" asp-area="Admin" asp-controller="Blog" asp-action="DeleteBlog" title="حذف">
                                                        <i class="mdi mdi-delete"></i>
                                                    </form>

                                                    <a permission="BlogComments" asp-area="Admin" asp-controller="Blog" asp-action="BlogComments" asp-route-BlogId="@item.Id" class="btn btn-outline-secondary btn-sm edit" title="نظرات">
                                                        <i class="mdi mdi-comment-multiple-outline"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    }
    else
    {
        <partial name="_NotFoundPartial" />
    }
</div>