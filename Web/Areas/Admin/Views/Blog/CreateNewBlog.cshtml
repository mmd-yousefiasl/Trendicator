@using Application.Dtos.Blog.AdminSide
@using Application.Dtos.BlogCategory.AdminSide
@using Application.Services.Interfaces
@model AdminSideCreateNewBlogViewModel
@inject IBlogCategoryService _categoryService;

@{
    ViewData["Title"] = "افزودن مقاله جدید";

    var categoriesResult = await _categoryService.GetCategoriesAsOptions();
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت مقالات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Blog" asp-action="BlogsList">لیست مقالات</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12 col-md-9">
            <div class="card">
                <form class="card-body" asp-area="Admin" asp-controller="Blog" asp-action="CreateNewBlog" autocomplete="off" enctype="multipart/form-data" onsubmit="submitAnimation()">
                    <input class="d-none image-input" type="file" asp-for="File" accept="image/*" />

                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label asp-for="Title" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Title" id="title">
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Slug" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Slug" id="slug">
                            <span asp-validation-for="Slug" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="MetaDescription" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <textarea class="form-control" type="text" asp-for="MetaDescription" rows="3"></textarea>
                            <span asp-validation-for="MetaDescription" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Writer" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Writer">
                            <span asp-validation-for="Writer" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Body" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <textarea class="form-control ck-editor" type="text" asp-for="Body"></textarea>
                            <span asp-validation-for="Body" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="TimeToRead" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="TimeToRead">
                            <span asp-validation-for="TimeToRead" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Priority" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="Priority">
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-md-2 col-form-label" asp-for="IsPublished"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="IsPublished">
                                <option value="true">منتشرشده</option>
                                <option value="false">منتشرنشده</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="CategoryId" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="CategoryId">
                                <option value="">انتخاب کنید</option>
                                @if (categoriesResult.IsSuccess)
                                {
                                    foreach (var item in categoriesResult.Value ?? new List<AdminSideBlogCategoryAsOptionViewModel>())
                                    {
                                        <option value="@item.Id">@item.Title</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ثبت</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-sm-12 col-md-3">
            <div class="card p-3">
                <img src="@SiteTools.DefaultImages" class="w-100 my-1 image-preview" alt="#slider-banner" />
                <label asp-for="File" class="btn btn-primary m-0">انتخاب تصویر</label>
            </div>
        </div>
    </div>
</div>

@section FooterReferences {
    <script asp-append-version="true" src="/js/Admin/slug.js"></script>
}