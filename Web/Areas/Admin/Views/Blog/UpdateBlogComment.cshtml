@using Application.Dtos.Blog.AdminSide
@model AdminSideUpdateBlogCommentDto

@{
    ViewData["Title"] = "ویرایش نظر";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت مقالات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Blog" asp-action="BlogsList">لیست مقالات</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Blog" asp-action="BlogComments" asp-route-BlogId="@Model.BlogId">نظرات وبلاگ</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <form class="card-body" asp-area="Admin" asp-controller="Blog" asp-action="UpdateBlogComment" autocomplete="off" onsubmit="submitAnimation()">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="BlogId" />
                    <input type="hidden" asp-for="Comment" />

                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label asp-for="Comment" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <textarea class="form-control" type="text" asp-for="Comment" disabled rows="8"></textarea>
                            <span asp-validation-for="Comment" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Reply" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <textarea class="form-control ck-editor" type="text" asp-for="Reply"></textarea>
                            <span asp-validation-for="Reply" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-md-2 col-form-label" asp-for="IsPublished"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="IsPublished">
                                <option value="true">منتشرشده</option>
                                <option value="false">منتشرنشده</option>
                            </select>
                        </div>
                    </div>

                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ویرایش</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>