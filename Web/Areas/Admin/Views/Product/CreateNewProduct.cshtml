@using Application.Services.Interfaces
@using Application.ViewModels.Product.AdminSide
@using Application.ViewModels.ProductCategory.AdminSide
@model AdminSideCreateNewProductViewModel

@inject IProductCategoryService _categoryService;

@{
    ViewData["Title"] = "افزودن محصول جدید";
    var categoryResult = await _categoryService.AdminSideGetProductCategoriesAsOptions(null);
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت محصولات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Product" asp-action="ProductsList">لیست محصولات</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12 col-md-9">
            <div class="card">
                <form class="card-body" asp-area="Admin" asp-controller="Product" asp-action="CreateNewProduct" autocomplete="off" enctype="multipart/form-data" onsubmit="submitAnimation()">
                    <input class="d-none image-input" type="file" asp-for="BannerFile" accept="image/*" />

                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label asp-for="Title" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Title" id="title">
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Slug" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Slug" id="slug">
                            <span asp-validation-for="Slug" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="DisplayPrice" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="DisplayPrice">
                            <span asp-validation-for="DisplayPrice" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="DisplayOrderPrice" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="DisplayOrderPrice">
                            <span asp-validation-for="DisplayOrderPrice" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="CategoryId" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="CategoryId">
                                <option value="">انتخاب کنید</option>
                                @if (categoryResult.IsSuccess)
                                {
                                    foreach (var item in categoryResult.Value ?? new List<AdminSideProductCategoryAsOptionViewModel>())
                                    {
                                        <option value="@item.Id">@item.Title</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Description" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <textarea class="form-control ck-editor" type="text" asp-for="Description" rows="6"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-md-2 col-form-label" asp-for="IsAvailable"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="IsAvailable" required>
                                <option value="true">موجود</option>
                                <option value="false">ناموجود</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Priority" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="Priority">
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-md-2 col-form-label" asp-for="IsPublished"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="IsPublished" required>
                                <option value="true">منتشرشده</option>
                                <option value="false">منتشرنشده</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ثبت</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-sm-12 col-md-3">
            <div class="card p-3">
                <img src="@SiteTools.DefaultImages" class="w-100 my-1 image-preview" alt="#image" />
                <label asp-for="BannerFile" class="btn btn-primary m-0">انتخاب تصویر</label>
            </div>
        </div>
    </div>
</div>

@section FooterReferences {
    <script asp-append-version="true" src="/js/Admin/slug.js"></script>
}