@using Application.Tools
@using Application.ViewModels.Product.AdminSide
@model AdminSideFilterProductsViewModel

@{
    ViewData["Title"] = "لیست محصولات";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت محصولات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">جست و جوی محصولات</h4>
                    <form novalidate asp-area="Admin" asp-controller="Product" method="get" asp-action="ProductsList" id="search-form">
                        <input type="hidden" asp-for="Page" id="Page" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="Search"></label>
                                    <input type="text" class="form-control" asp-for="Search" autocomplete="off">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="IsPublished"></label>
                                    <select type="text" class="form-control" asp-for="IsPublished">
                                        <option>همه</option>
                                        <option value="false">منتشرنشده</option>
                                        <option value="true">منتشرشده</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="IsAvailable"></label>
                                    <select type="text" class="form-control" asp-for="IsAvailable">
                                        <option>همه</option>
                                        <option value="false">ناموجود</option>
                                        <option value="true">موجود</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-primary" type="submit">جست و جو</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model?.Entities?.Any() ?? false)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>عنوان</th>
                                        <th>قیمت نمایشی</th>
                                        <th>قیمت سفارش</th>
                                        <th>وضعیت موجودی</th>
                                        <th>دسته بندی</th>
                                        <th>اولویت</th>
                                        <th>وضعیت انتشار</th>
                                        <th>بازدید</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int counter = 0;

                                        foreach (var item in Model.Entities ?? new List<AdminSideProductViewModel>())
                                        {
                                            counter++;

                                            <tr>
                                                <th scope="row">@counter</th>
                                                <td title="@item.Slug">@item.Title</td>
                                                <td>@item.DisplayPrice.ToToman()</td>
                                                <td>@item.DisplayOrderPrice?.ToToman()</td>
                                                <td>
                                                    @if (item.IsAvailable)
                                                    {
                                                        <span class="text-success">موجود</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">ناموجود</span>
                                                    }
                                                </td>
                                                <td>@item.Category</td>
                                                <td>@item.Priority</td>
                                                <td>
                                                    @if (item.IsPublished)
                                                    {
                                                        <span class="text-success">منتشرشده</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">منتشرنشده</span>
                                                    }
                                                </td>
                                                <td>@item.ViewsCount</td>
                                                <td>
                                                    <a permission="UpdateProduct" asp-area="Admin" asp-controller="Product" asp-action="UpdateProduct" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm edit" title="ویرایش">
                                                        <i class="fas fa-pencil-alt"></i>
                                                    </a>

                                                    <a permission="ProductGalleryList" href="javascript:void(0)" onclick="showLargeModal('Product Gallery', '/admin/product-gallery-list?id=@item.Id')" class="btn btn-outline-secondary btn-sm edit" title="گالری">
                                                        <i class="fas fa-file-image"></i>
                                                    </a>

                                                    <form permission="DeleteProduct" class="btn btn-outline-secondary btn-sm" method="post" onclick="ConfirmDelete(this)" asp-route-id="@item.Id" asp-area="Admin" asp-controller="Product" asp-action="DeleteProduct" title="حذف">
                                                        <i class="mdi mdi-delete"></i>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    }
    else
    {
        <partial name="_NotFoundPartial" />
    }
</div>

@section FooterReferences {
    <script asp-append-version="true" src="/js/Admin/products-list.js"></script>
}