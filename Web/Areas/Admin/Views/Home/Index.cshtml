@{
    ViewData["Title"] = "صفحه اصلی";
}
<div class="container-fluid">

    <div class="row">
        <div class="col-sm-12">
            <div class="page-title-box">
                <h4>مدیریت سایت</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item active">صفحه نخست</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        @await Component.InvokeAsync("SiteUsersCount")
        @await Component.InvokeAsync("OrdersCount")
        @await Component.InvokeAsync("OrdersValue")
        @await Component.InvokeAsync("SoldProductsCount")
    </div>

    <div class="row">
        @await Component.InvokeAsync("AdminLatestOrders")
        @await Component.InvokeAsync("AdminLatestTickets")
    </div>
</div>