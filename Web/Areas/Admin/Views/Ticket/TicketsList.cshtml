@using Application.Tools
@using Application.Dtos.Ticket.AdminSide
@using Domain.Enums.Tickets
@model AdminSideFilterTicketsViewModel

@{
    ViewData["Title"] = "لیست تیکت ها";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت تیکت ها</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">جست و جوی تیکت ها</h4>
                    <form novalidate asp-area="Admin" asp-controller="Ticket" method="get" asp-action="TicketsList" id="search-form">
                        <input type="hidden" asp-for="Page" id="Page" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="Search"></label>
                                    <input type="text" class="form-control" asp-for="Search" autocomplete="off">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="Status"></label>
                                    <select type="text" class="form-control" asp-for="Status" asp-items="@Html.GetEnumSelectList<TicketStatusEnum>()">
                                        <option value="">همه</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-primary" type="submit">جست و جو</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model?.Entities?.Any() ?? false)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>ایجاد</th>
                                        <th>آخرین آپدیت</th>
                                        <th>موضوع</th>
                                        <th>وضعیت</th>
                                        <th>کاربر</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int counter = 0;

                                        foreach (var item in Model.Entities ?? new List<AdminSideTicketViewModel>())
                                        {
                                            counter++;

                                            <tr>
                                                <th scope="row">@counter</th>
                                                <td>@item.CreatedDate.GetDateTime()</td>
                                                <td>@item.LastUpdatedDate.GetDateTime()</td>
                                                <td>@item.Subject</td>
                                                <td>@item.Status.GetDisplayName()</td>
                                                <td>
                                                    <a asp-area="Admin" asp-controller="User" asp-action="UpdateUser" asp-route-id="@item.UserId">
                                                        @((string.IsNullOrWhiteSpace(item.UserName) ? "نام کاربری" : item.UserName))
                                                    </a>
                                                </td>
                                                <td>
                                                    <a permission="TicketDetails" asp-area="Admin" asp-controller="Ticket" asp-action="TicketDetails" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm edit" title="جزئیات تیکت">
                                                        <i class="fas fa-eye"></i>
                                                    </a>

                                                    <form permission="DeleteTicket" class="btn btn-outline-secondary btn-sm" method="post" onclick="ConfirmDelete(this)" asp-route-id="@item.Id" asp-area="Admin" asp-controller="Ticket" asp-action="DeleteTicket" title="حذف">
                                                        <i class="mdi mdi-delete"></i>
                                                    </form>

                                                    <form permission="CloseTicket" class="btn btn-outline-secondary btn-sm" method="post" onclick="ConfirmDelete(this)" asp-route-id="@item.Id" asp-area="Admin" asp-controller="Ticket" asp-action="CloseTicket" title="بستن تیکت">
                                                        <i class="mdi mdi-close"></i>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    }
    else
    {
        <partial name="_NotFoundPartial" />
    }
</div>