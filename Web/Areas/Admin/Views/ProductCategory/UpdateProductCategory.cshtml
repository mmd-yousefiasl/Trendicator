@using Application.Services.Interfaces
@using Application.ViewModels.ProductCategory.AdminSide
@model AdminSideUpdateProductCategoryViewModel

@inject IProductCategoryService _categoryService;

@{
    ViewData["Title"] = "ویرایش دسته بندی";
    var categoryResult = await _categoryService.AdminSideGetProductCategoriesAsOptions(Model.Id);
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت دسته بندی ها</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="ProductCategory" asp-action="ProductCategoriesList">لیست دسته بندی ها</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <form class="card-body" asp-area="Admin" asp-controller="ProductCategory" asp-action="UpdateProductCategory" autocomplete="off" onsubmit="submitAnimation()">
                    <input type="hidden" asp-for="Id" />
                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label asp-for="Title" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Title">
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="ParentCategoryId" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <select class="form-control" type="text" asp-for="ParentCategoryId">
                                <option value="">انتخاب کنید</option>
                                @if (categoryResult.IsSuccess)
                                {
                                    foreach (var item in categoryResult.Value ?? new List<AdminSideProductCategoryAsOptionViewModel>())
                                    {
                                        <option value="@item.Id">@item.Title</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ویرایش</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>