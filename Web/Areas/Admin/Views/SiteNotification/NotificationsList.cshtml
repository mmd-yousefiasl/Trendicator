@using Application.Dtos.SiteNotifications.AdminSide
@using Application.Tools
@using Domain.Enums.SiteNotifications
@model AdminSideFilterNotificationsDto

@{
    ViewData["Title"] = "اعلان ها";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت اعلان ها</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">جست و جوی اعلان ها</h4>
                    <form novalidate asp-area="Admin" asp-controller="SiteNotification" method="get" asp-action="NotificationsList" id="search-form">
                        <input type="hidden" asp-for="Page" id="Page" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="Type"></label>
                                    <select type="text" class="form-control" asp-for="Type" asp-items="Html.GetEnumSelectList<SiteNotificationTypeEnum>()">
                                        <option value="">همه</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-primary" type="submit">جست و جو</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model?.Entities?.Any() ?? false)
    {
        @foreach (var item in Model.Entities)
        {
            <div class="mb-2 p-3 shadow-sm"
                 style="border: 1px solid #e9ecef; border-right: 4px solid #dee2e6; border-radius: 4px; background: @(item.IsRead ? "#ffffff" : "#fafafa");">

                <div class="d-flex justify-content-between align-items-center mb-2">

                    <div class="d-flex align-items-center gap-2">
                        @if (!item.IsRead)
                        {
                            <span class="badge bg-dark font-size-11 px-2 py-1">جدید</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-muted border font-size-11 px-2 py-1">خوانده شده</span>
                        }
                    </div>

                    <span class="text-muted font-size-12" dir="ltr">
                        @item.CreatedDate.ToPersianRelativeTime()
                    </span>

                </div>

                <div class="font-size-13 text-dark lh-base">
                    <i class="mdi mdi-bell-outline me-1 text-muted"></i>
                    @Html.Raw(item.Content)
                </div>

            </div>
        }
    }
    else
    {
        <div class="card border border-dark">
            <div class="card-body p-0">
                <partial name="_NotFoundPartial" />
            </div>
        </div>
    }

    <div class="mt-3">
        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    </div>

</div>