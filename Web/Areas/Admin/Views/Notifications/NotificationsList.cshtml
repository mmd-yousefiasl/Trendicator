@using Application.Tools
@using Application.ViewModels.SiteNotifications.AdminSide
@model AdminSideFilterNotificationsViewModel

@{
    ViewData["Title"] = "لیست اعلانات";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت اعلانات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    @if (Model.Entities?.Any() ?? false)
    {
        <form asp-area="Admin" asp-controller="Notifications" asp-action="NotificationsList" method="get" id="search-form">
            <input type="hidden" asp-for="Page" id="Page" />
        </form>
        <div class="row">
            <div class="col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive table-desi">
                            <table class="table all-package table-category " id="editableTable">
                                <thead>
                                    <tr>
                                        <th>تاریخ</th>
                                        <th>محتوا</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model.Entities ?? new List<AdminSideNotificationViewModel>())
                                    {
                                        <tr>
                                            <td>@item.CreatedDate.GetDateTime()</td>
                                            <td>@item.Content</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    }
    else
    {
        <partial name="_NotFoundPartial" />
    }

</div>
