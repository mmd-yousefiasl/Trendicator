@using Application.Dtos.Role.AdminSide
@using Application.Dtos.User.AdminSide
@using Application.Services.Interfaces
@model AdminSideCreateNewUserDto
@inject IRoleService _roleService;

@{
    ViewData["Title"] = "افزودن کاربر جدید";
    var rolesList = await _roleService.GetAllRolesForUserCRUD();
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت کاربران</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="User" asp-action="UsersList">لیست کاربران</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <form class="card-body" asp-area="Admin" asp-controller="User" asp-action="CreateNewUser" autocomplete="off" onsubmit="submitAnimation()">

                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label asp-for="Mobile" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Mobile" required>
                            <span asp-validation-for="Mobile" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="FirstName" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="FirstName">
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="LastName" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="LastName">
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-md-2 col-form-label" asp-for="IsUserBanned"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="IsUserBanned" required>
                                <option value="false">فعال</option>
                                <option value="true">غیرفعال</option>
                            </select>
                        </div>
                    </div>

                    <h4 class="card-title">
                        نقش ها
                    </h4>
                    <hr />

                    <div class="mb-3 row px-5">
                        @{
                            int counter = 0;
                            foreach (var item in rolesList.Value ?? new List<AdminSideRoleViewModel>())
                            {
                                counter++;
                                <div class="form-check col-2">
                                    @if (Model?.RoleIds?.Contains(item.Id) ?? false)
                                    {
                                        <input class="form-check-input" name="RoleIds" value="@item.Id" type="checkbox" id="formCheck-@counter" checked>
                                    }
                                    else
                                    {
                                        <input class="form-check-input" name="RoleIds" value="@item.Id" type="checkbox" id="formCheck-@counter">
                                    }
                                    <label class="form-check-label" for="formCheck-@counter">
                                        @item.Title
                                    </label>
                                </div>
                            }
                        }
                    </div>

                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ثبت کاربر</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>