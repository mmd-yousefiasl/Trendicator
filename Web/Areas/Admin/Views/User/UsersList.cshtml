@using Application.Dtos.User.AdminSide
@using Application.Tools
@model AdminSideFilterUsersDto

@{
    ViewData["Title"] = "لیست کاربران";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت کاربران</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">جست و جوی کاربران</h4>
                    <form novalidate asp-area="Admin" asp-controller="User" method="get" asp-action="UsersList"
                          id="search-form">
                        <input type="hidden" asp-for="Page" id="Page" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="Search"></label>
                                    <input type="text" class="form-control" asp-for="Search" autocomplete="off">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="IsUserBanned"></label>
                                    <select type="text" class="form-control" asp-for="IsUserBanned">
                                        <option>همه</option>
                                        <option value="false">فعال</option>
                                        <option value="true">غیرفعال</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="DeleteRequest"></label>
                                    <select type="text" class="form-control" asp-for="DeleteRequest">
                                        <option>همه</option>
                                        <option value="true">درخواست شده</option>
                                        <option value="false">درخواست نشده</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-primary" type="submit">جست و جو</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model?.Entities?.Any() ?? false)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>موبایل</th>
                                        <th>نام و نام خانوادگی</th>
                                        <th>وضعیت حساب کاربری</th>
                                        <th>کیف پول</th>
                                        <th>حذف اکانت</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int counter = 0;

                                        foreach (var item in Model.Entities ?? new List<AdminSideUserDto>())
                                        {
                                            counter++;

                                            <tr class="@((item.DeleteRequest == true) ? "text-danger" : "")">
                                                <th scope="row">@counter</th>
                                                <td>@item.Mobile</td>
                                                <td>@(item.FirstName + " " + item.LastName)</td>
                                                <td>
                                                    @if (!item.IsUserBanned)
                                                    {
                                                        <span class="text-success">فعال</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">غیرفعال</span>
                                                    }
                                                </td>
                                                <td>@item.Balance.ToToman()</td>
                                                <td>
                                                    @if (item.DeleteRequest)
                                                    {
                                                        @item.DeleteRequestDate?.GetDateTime()
                                                    }
                                                    else
                                                    {
                                                        @: درخواست نشده
                                                    }
                                                </td>
                                                <td>
                                                    <a permission="UpdateUser" asp-area="Admin" asp-controller="User"
                                                       asp-action="UpdateUser" asp-route-id="@item.Id"
                                                       class="btn btn-outline-secondary btn-sm edit" title="ویرایش">
                                                        <i class="fas fa-pencil-alt"></i>
                                                    </a>

                                                    <form permission="DeleteUser" class="btn btn-outline-secondary btn-sm"
                                                          method="post" onclick="ConfirmDelete(this)"
                                                          asp-route-id="@item.Id" asp-area="Admin" asp-controller="User"
                                                          asp-action="DeleteUser" title="حذف">
                                                        <i class="mdi mdi-delete"></i>
                                                    </form>

                                                    <a permission="ManageBalanceTransaction" asp-area="Admin"
                                                       asp-controller="BalanceTransaction"
                                                       asp-action="BalanceTransactionsList" asp-route-userId="@item.Id"
                                                       class="btn btn-outline-secondary btn-sm edit" title="تراکنش ها">
                                                        <i class="fas fa-money-check-alt"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    }
    else
    {
        <partial name="_NotFoundPartial" />
    }
</div>