<header id="page-topbar">
    <div class="navbar-header">
        <div class="d-flex">
            <!-- LOGO -->
            <div class="navbar-brand-box">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="logo logo-light">
                    <span class="logo-sm">
                        <img src="/assets/img/logo.svg" alt="لوگو سایت" height="30">
                    </span>
                    <span class="logo-lg">
                        <img src="/assets/img/logo.svg" alt="لوگو سایت" height="45">
                    </span>
                </a>
            </div>

            <button type="button" class="btn btn-sm px-3 font-size-24 header-item waves-effect vertical-menu-btn">
                <i class="mdi mdi-menu"></i>
            </button>
            <div class="d-none d-sm-block" permission="ManageMedia">
                <div class="dropdown dropdown-topbar pt-3 mt-1 d-inline-block">
                    <a class="btn btn-light dropdown-toggle" href="javascript:void(0)" role="button"
                       id="dropdownMenuLink" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        دسترسی سریع
                        <i class="mdi mdi-chevron-down"></i>
                    </a>

                    <div class="dropdown-menu" aria-labelledby="dropdownMenuLink" style="">
                        <a class="dropdown-item" href="javascript:void(0)"
                           onclick="showLargeModal('مدیریت رسانه ها', '/admin/media-list')" title="مدیریت رسانه ها">مدیریت
                            رسانه ها</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex">
            <div class="dropdown d-inline-block ms-1">
                <button class="btn header-item noti-icon waves-effect"
                        onclick="location.href='/admin/notifications-list'">
                    <i class="mdi mdi-bell-outline"></i>
                    @if ((int)ViewData["NotificationCount"]! > 0)
                    {
                        if ((int)ViewData["NotificationCount"]! > 99)
                        {
                            <span class="badge bg-danger rounded-pill">99+</span>
                        }
                        else
                        {
                            <span class="badge bg-danger rounded-pill">@((int)ViewData["NotificationCount"]!)</span>
                        }
                    }
                </button>
            </div>

            <div class="dropdown d-inline-block">
                <button type="button" class="btn header-item waves-effect" id="page-header-user-dropdown"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="mdi mdi-account-circle text-muted align-middle mex-1 fs-30"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    <a class="dropdown-item" asp-area="Admin" asp-controller="UserProfile"
                       asp-action="UpdateUserProfile">
                        <i class="mdi mdi-account-circle font-size-17 text-muted align-middle mex-1"></i> مشخصات
                    </a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item text-danger" asp-area="" asp-controller="Account" asp-action="Logout"><i
                            class="mdi mdi-power font-size-17 text-muted align-middle mex-1 text-danger"></i> خروج</a>
                </div>
            </div>
        </div>
    </div>
</header>