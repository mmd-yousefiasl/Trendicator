@using Application.ViewModels.ProductGallery.AdminSide
@model List<AdminSideProductGalleryViewModel>

@if (Model?.Any() ?? false)
{
    @foreach (var item in Model ?? new List<AdminSideProductGalleryViewModel>())
    {
        <form class="col-12 col-md-4 mb-3 text-center" permission="DeleteProductGallery" asp-area="Admin" asp-controller="ProductGallery" asp-action="DeleteProductGallery" asp-route-id="@item.Id" onsubmit="removeImage(this)">
            <img src="@SiteTools.ProductGallery@item.FileName" class="img-fluid product-image" alt="product-images">
            <button type="submit" class="col-12 btn btn-outline-danger">حذف</button>
        </form>
    }
}