@using Application.Tools
@using Application.Dtos.Ticket.AdminSide
@model AdminSideFilterTicketsViewModel

@if (Model?.Entities?.Any() ?? false)
{
    <div class="col-xl-6">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4">
                    آخرین
                    <a asp-area="Admin" asp-controller="Ticket" asp-action="TicketsList">
                        تیکت ها
                    </a>
                </h4>
                <div class="table-responsive">
                    <table class="table align-middle table-centered table-vertical table-nowrap mb-1">
                        <tbody>
                            @{
                                int counter = 0;

                                foreach (var item in Model.Entities ?? new List<AdminSideTicketViewModel>())
                                {
                                    counter++;

                                    <tr>
                                        <th scope="row">@counter</th>
                                        <td>@item.CreatedDate.GetDateTime()</td>
                                        <td>@item.LastUpdatedDate.GetDateTime()</td>
                                        <td>@item.Subject</td>
                                        <td>@item.Status.GetDisplayName()</td>
                                        <td>
                                            <a asp-area="Admin" asp-controller="User" asp-action="UpdateUser" asp-route-id="@item.UserId">
                                                @((string.IsNullOrWhiteSpace(item.UserName) ? "نام کاربری" : item.UserName))
                                            </a>
                                        </td>
                                        <td>
                                            <a permission="TicketDetails" asp-area="Admin" asp-controller="Ticket" asp-action="TicketDetails" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm edit" title="جزئیات تیکت">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <form permission="DeleteTicket" class="btn btn-outline-secondary btn-sm" method="post" onclick="ConfirmDelete(this)" asp-route-id="@item.Id" asp-area="Admin" asp-controller="Ticket" asp-action="DeleteTicket" title="حذف">
                                                <i class="mdi mdi-delete"></i>
                                            </form>

                                            <form permission="CloseTicket" class="btn btn-outline-secondary btn-sm" method="post" onclick="ConfirmDelete(this)" asp-route-id="@item.Id" asp-area="Admin" asp-controller="Ticket" asp-action="CloseTicket" title="بستن تیکت">
                                                <i class="mdi mdi-close"></i>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}