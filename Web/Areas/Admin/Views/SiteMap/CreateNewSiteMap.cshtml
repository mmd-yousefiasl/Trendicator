@using Application.Dtos.SiteMap.AdminSide
@using Domain.Enums.SiteInfo
@model AdminSideCreateNewSiteMapViewModel

@{
    ViewData["Title"] = "افزودن نقشه سایت جدید";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت نقشه سایت</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="SiteMap" asp-action="SiteMapList">لیست نقشه سایت</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <form class="card-body" asp-area="Admin" asp-controller="SiteMap" asp-action="CreateNewSiteMap" autocomplete="off" onsubmit="submitAnimation()">
                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label asp-for="Url" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Url" required>
                            <span asp-validation-for="Url" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-md-2 col-form-label" asp-for="ChangeFreq"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="ChangeFreq" asp-items="@Html.GetEnumSelectList<ChangeFreqEnum>()">
                            </select>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Priority" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="Priority">
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-md-2 col-form-label" asp-for="IsPublished"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="IsPublished">
                                <option value="true">منتشرشده</option>
                                <option value="false">منتشرنشده</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-md-2 col-form-label" asp-for="Type"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="Type" asp-items="@Html.GetEnumSelectList<SiteMapTypeEnum>()">
                            </select>
                        </div>
                    </div>

                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ثبت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>