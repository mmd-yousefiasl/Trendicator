@using Application.Dtos.BalanceTransaction.AdminSide
@using Domain.Enums.Users
@model AdminSideCreateNewBalanceTransactionViewModel

@{
    ViewData["Title"] = "افزودن تراکنش جدید";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت کاربران</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="User" asp-action="UsersList">لیست کاربران</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <form class="card-body" asp-area="Admin" asp-controller="BalanceTransaction" asp-action="CreateNewBalanceTransaction" autocomplete="off" onsubmit="submitAnimation()">
                    <input type="hidden" asp-for="UserId" />

                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label asp-for="Amount" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="Amount">
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Type" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="Type" asp-items="@Html.GetEnumSelectList<BalanceTransactionTypeEnum>()"></select>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Description" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <textarea class="form-control" asp-for="Description" rows="6"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ثبت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>