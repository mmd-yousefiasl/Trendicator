@using Application.Dtos.ProductDetails.AdminSide
@model AdminSideCreateNewProductDetailsDto

<div id="ProductDetails"
     data-ajax-container
     data-reload-url="/admin/add-new-product-details"
     data-edit-url="/admin/edit-product-details"
     data-product-id-input="ProductDetailsProductId">

    <input type="hidden" asp-for="ProductId" id="ProductDetailsProductId" />
    @await Component.InvokeAsync("ProductDetails", Model.ProductId)

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <form class="card-body"
                      id="createProductDetailsForm"
                      autocomplete="off"
                      data-ajax-form
                      data-url="@Url.Action("CreateNewProductDetails", "ProductDetails", new { area = "Admin" })"
                      onsubmit="return false;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProductId" />

                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label asp-for="Title" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Title">
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Description" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" type="text" asp-for="Description">
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Priority" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="Priority">
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="IsPublished" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <select class="form-control" asp-for="IsPublished">
                                <option value="true">منتشر شده</option>
                                <option value="false">منتشر نشده</option>
                            </select>
                            <span asp-validation-for="IsPublished" class="text-danger"></span>
                        </div>
                    </div>

                    <div asp-validation-summary="All" class="text-danger validation-summary"></div>

                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="button" data-ajax-submit>ثبت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />